;;;; test/H1_decide.lisp — ТОЧКА РЕШЕНИЯ КАК API (наказ Невис, раздел F).
;;;; Run: sbcl --script test/H1_decide.lisp
;;;;
;;;; 🔴 ПРОВЕРЯЕТСЯ ГЛАВНОЕ ТРЕБОВАНИЕ F2: вердикт НИКОГДА не голое «да/нет». Всегда
;;;; основание, степень, вера, порог и недостача (или запас). Поэтому здесь проверяется
;;;; не только «что ответил», но и «чего в ответе не может не быть».
(load (merge-pathnames "../src/decide.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))

(defun решить (src) (with-output-to-string (*standard-output*) (decide-and-show src)))

;;; ── три программы: прошло · свернулось · решений нет ────────────────────────
(defparameter *прошло* "
lattice честность = молчание < образ < традиция < строго
witness сильный : строго says \"…\" source родник evidence 9 for 1 against
claim основание from сильный
irreversible action шаг needs grade >= образ gated by belief >= 0.5 else свернуть
perform шаг on основание
")

(defparameter *свернулось* "
lattice честность = молчание < образ < традиция < строго
witness слабый : образ says \"…\" source родник evidence 1 for 3 against
claim основание from слабый
irreversible action шаг needs grade >= образ gated by belief >= 0.9 else свернуть
perform шаг on основание
")

(defparameter *без-решений* "
lattice честность = молчание < образ < традиция < строго
witness кто-то : строго says \"…\" source родник evidence 5 for 0 against
claim основание from кто-то
")

(defparameter *отклонено* "
lattice честность = молчание < образ < традиция < строго
witness слабый : образ says \"…\" source родник evidence 3 for 1 against
claim высокое : строго from слабый
")

(format t "~&── F1. ОДИН ВХОД: ПРОГРАММА → ВЕРДИКТ ──~%")

(check "прошедшее решение даёт вердикт СОВЕРШЕНО"
       (search "СОВЕРШЕНО" (решить *прошло*)))
(check "не прошедшее даёт СВЁРНУТО — и это ЗНАЧЕНИЕ, а не ошибка"
       (let ((s (решить *свернулось*)))
         (and (search "СВЁРНУТО" s) (search "значение, а не ошибка" s))))
(check "🔴 программа без действий отвечает СЛОВАМИ, а не молчанием"
       (let ((s (решить *без-решений*)))
         (and (search "НИ ОДНОГО РЕШЕНИЯ" s)
              (search "не отказ и не разрешение" s))))
(check "отклонённая проверяющим программа названа отклонённой, а не свёрнутой"
       (let ((s (решить *отклонено*)))
         (and (search "ОТКЛОНЕНА ПРОВЕРЯЮЩИМ" s) (search "LAUNDER" s))))
(check "вердикты возвращаются структурами, а не только печатаются"
       (let ((v (first (decide *прошло*))))
         (and (verdict-p v) (eq (verdict-kind v) :performed))))
(check "журнал возвращается тем же вызовом"
       (nth-value 1 (decide *прошло*)))

(format t "~&── F2. 🔴 ВЕРДИКТ НИКОГДА НЕ ГОЛОЕ «ДА/НЕТ» ──~%")

(check "в положительном вердикте есть ОСНОВАНИЕ"
       (search "основание: ОСНОВАНИЕ" (решить *прошло*)))
(check "…и степень"
       (search "степень: [строго]" (решить *прошло*)))
(check "…и вера с порогом"
       (let ((s (решить *прошло*))) (and (search "вера 0." s) (search "порог 0." s))))
(check "…и ЗАПАС числом, а не словом «прошло»"
       (search "запас 0." (решить *прошло*)))
(check "🔴 в отрицательном вердикте есть НЕДОСТАЧА числом"
       (let ((s (решить *свернулось*)))
         (and (search "НЕДОСТАЧА" s) (search "не хватило" s))))
(check "…и недостача названа ЗАКАЗОМ на работу, а не приговором"
       (search "вот размер недостающего свидетельства" (решить *свернулось*)))
(check "🔴 нет ни одного вердикта без основания — проверено по всем трём программам"
       (every (lambda (src)
                (let ((vs (decide src)))
                  (every (lambda (v) (and (verdict-basis v) (verdict-action v))) vs)))
              (list *прошло* *свернулось* *без-решений*)))
(check "охват печатается и когда его НЕ заявили"
       (search "охват не заявлен" (решить *прошло*)))

(format t "~&── 🔴 Act: ТРЕБОВАНИЕ К СТЕПЕНИ — ОТКАЗ ТИПИЗАЦИИ, А НЕ ГЕЙТ ──~%")
;;; Было (находка второго домена): необратимое проходило гейт по МАССЕ ВЕРЫ, стоя на дне
;;; решётки, и вердикт лишь ГОВОРИЛ об этом красной строкой — то есть перекладывал работу
;;; на внимательного читателя. Стало (`formal/Act.agda`, Невис 29.07): требование к степени
;;; живёт в ТИПЕ действия. Её довод сильнее моего: гейт есть проверка времени исполнения,
;;; а проверку обходят, не нарушая — принеси свидетельств, вера поднимется, происхождение
;;; останется прежним. Язык, чей тезис «нечестность невыразима», не должен рассчитывать на
;;; внимательного человека.
(defparameter *файл*
  (concatenate 'string (directory-namestring *load-pathname*) "../examples/фармакология.nol"))
(defparameter *фарма*
  (with-open-file (s *файл* :external-format :utf-8)
    (let ((d (make-string (file-length s)))) (subseq d 0 (read-sequence d s)))))

(check "🔴 ИСТОРИЧЕСКОЕ РЕШЕНИЕ БОЛЬШЕ НЕ ТИПИЗИРУЕТСЯ"
       (member :req (mapcar #'terr-code (nth-value 2 (decide *фарма*)))))
(check "…и отказ назван отказом ПРОВЕРЯЮЩЕГО, а не отказом гейта"
       (let ((s (решить *фарма*)))
         (and (search "ОТКЛОНЕНА ПРОВЕРЯЮЩИМ" s)
              (search "НЕ отказ гейта" s))))
(check "…и объяснён теми же словами, что и всё остальное в языке"
       (let ((s (решить *фарма*)))
         (and (search "требует основания не ниже" s)
              (search "происхождение от этого не изменится" s))))
(check "🔴 вердиктов у отклонённой программы НЕТ — это не программа"
       (null (decide *фарма*)))
(check "необратимое без требования к степени вообще не разбирается"
       (not (parse-ok? "lattice L = молчание < образ
irreversible action шаг gated by belief >= 0.5 else fold")))
(check "🔴 требование ДНА у необратимого отвергается: запись выглядела бы защитой"
       (member :req (errors-of (parse "lattice L = молчание < образ < строго
witness w : строго says \"…\" source r evidence 5 for 0 against
claim осн from w
irreversible action шаг needs grade >= молчание gated by belief >= 0.1 else fold
perform шаг on осн"))))

(format t "~&── КРАСНАЯ СТРОКА ПРО ДНО ЖИВА — но там, где действие ЗАКОННО ──~%")
;;; У обратимого и возместимого требования к степени нет (и не должно быть: непоправимости
;;; там нет). Значит основание-дно у них законно — и вот тут строка остаётся полезной:
;;; она называет то, чего решение не судит.
(defparameter *на-дне* "
lattice честность = молчание < образ < традиция < строго
witness сильный : строго says \"…\" source родник evidence 9 for 1 against
ask пусто in реестр found nothing because \"не нашли\"
claim основание from сильный, пусто
reversible action заметка gated by belief >= 0.1 else свернуть
perform заметка on основание
")
(check "обратимое на дне решётки законно — и совершается"
       (search "СОВЕРШЕНО" (решить *на-дне*)))
(check "🔴 и вердикт всё равно называет дно отдельной строкой"
       (search "СТЕПЕНЬ ОСНОВАНИЯ — ДНО РЕШЁТКИ" (решить *на-дне*)))
(check "свёрток не удвоен: он лежит и на складе, и в журнале, а вердикт о нём один"
       (= 1 (count :folded (decide *свернулось*) :key #'verdict-kind)))

(format t "~&── J1. ЧЕТЫРЕ ПОЛЯ ПРИ ЛЮБОМ ИСХОДЕ ──~%")
;;; 🔴 Смысл требования — не полнота ради полноты, а то, что расширение не ломает API.
;;; Когда требование к степени встало в тип действия, вердикт принял его, ничего не переписывая.
(check "🔴 все четыре поля есть у КАЖДОГО вердикта всех исходов"
       (every (lambda (src)
                (every (lambda (v) (and (verdict-belief v)
                                        (verdict-grade-text v)
                                        (verdict-reason v)
                                        (listp (verdict-roots v))))
                       (decide src)))
              (list *прошло* *свернулось* *на-дне*)))
(check "…и все четыре ПЕЧАТАЮТСЯ, а не только лежат в структуре"
       (let ((s (решить *прошло*)))
         (and (search "вера 0." s) (search "степень: [" s)
              (search "корни: " s) (search "причина: " s))))
(check "причина сказана СЛОВАМИ языка, а не кодом рода"
       (and (search "основание держало порог" (решить *прошло*))
            (search "веры не хватило до порога" (решить *свернулось*))))
(check "корни названы поимённо — это то, что можно отозвать"
       (search "корни: РОДНИК" (решить *прошло*)))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
