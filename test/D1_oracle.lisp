;;;; test/D1_oracle.lisp — ОРАКУЛ: реализация против ДОКАЗАННОГО.
;;;; Run: sbcl --script test/D1_oracle.lisp   (требует собранного oracle/build/Oracle)
;;;;
;;;; ПОВОД (наказ Невис, раздел B; её же название — «оракул», точнее моей «симуляции»).
;;;; Дифференциальный тест `chk-claim` против `red-claim` сравнивает ДВЕ НЕПРОВЕРЕННЫЕ
;;;; реализации: он ловит расхождение, но не ловит ОБЩУЮ ошибку обеих. Стоит взять одну
;;;; сторону из Agda, где степень доказана, — и природа теста меняется: это проверка
;;;; реализации против доказанного. Общая ошибка становится невозможной с той стороны,
;;;; где доказано.
;;;;
;;;; 🔴 ЧТО ЭТОТ ТЕСТ НЕ ДОКАЗЫВАЕТ, и это надо читать раньше числа прогонов:
;;;;   1. Он НЕ доказывает эквивалентность Лиспа и модели. Он ограничивает расхождение
;;;;      ЧИСЛОМ ИСПЫТАНИЙ. Тысяча совпавших прогонов — это тысяча совпавших прогонов.
;;;;   2. Модель считает СТЕПЕНЬ (T-CLAIM + отзыв), и только её. Вне модели остаются:
;;;;      свёртка по корням, вес (f,c), квантор, гейт, журнал, молчание в обзорной роли.
;;;;      Поэтому генератор даёт каждому свидетелю СВОЙ корень — иначе сравнивались бы
;;;;      разные вещи, и совпадение было бы случайным.
;;;;   3. Единственное расхождение ПРЕДСТАВЛЕНИЙ: дно у модели — пустой кортеж, у нолanga —
;;;;      нулевые индексы. Приводим одно к другому в одном месте (`оракул→степень`) и
;;;;      говорим об этом вслух, а не прячем в сравнении.
(load (merge-pathnames "../src/reduce.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))

;; 🐛 НЕ `merge-pathnames`: она наследует тип файла от *load-pathname*, и «Oracle»
;; молча превращается в «Oracle.lisp». Ошибка тихая — путь выглядит правильным.
(defparameter *кат*    (directory-namestring *load-pathname*))
(defparameter *бинарь* (concatenate 'string *кат* "../oracle/build/Oracle"))
(defparameter *вход*   (concatenate 'string *кат* "../oracle/build/harness.in"))
(defparameter *выход*  (concatenate 'string *кат* "../oracle/build/harness.out"))
(defparameter *программ* 1200)

;;; 🔴 Отсутствие бинаря — НЕ успех. Тот же закон, что с «agda не найдена» в run_tests.sh:
;;; молчаливо пропущенная проверка выглядит как пройденная, а это худший вид лжи в батарее.
(unless (probe-file *бинарь*)
  (format t "~&ОРАКУЛ НЕ СОБРАН: ~a~%  Соберите: bash oracle/build.sh~%  ~
             Это ПАДЕНИЕ, а не пропуск: непроверенное не считается проверенным.~%" *бинарь*)
  (sb-ext:exit :code 1))

;;; ── ГЕНЕРАТОР (B2): случайные решётки, свидетели, молчания, отзывы ──────────
;;; Зерно постоянное: тест обязан быть воспроизводимым, иначе «упало один раз из ста»
;;; невозможно ни повторить, ни починить.
(defparameter *rs* (sb-ext:seed-random-state 20260729))
(defun rnd (n) (random n *rs*))

(defun имена (префикс k)
  (loop for i below k collect (intern (format nil "~a~a" префикс i))))

(defun случайная-программа (idx)
  "→ (values формы арность посылки отозванные ожидание-дна).
   ПОСЫЛКИ — список (вид id . индексы) в порядке основания; ОТОЗВАННЫЕ — список id."
  (let* ((произведение (= 0 (mod idx 3)))          ; треть программ на решётке-произведении
         (решётки '()) (арность 1) (части '()))
    (if произведение
        (let* ((ma (+ 2 (rnd 3))) (mb (+ 2 (rnd 3)))
               (a (имена "A" ma)) (b (имена "B" mb)))
          (setf части (list a b) арность 2
                решётки (list `(lattice ЧА ,@a) `(lattice ЧБ ,@b)
                              '(lattice L :product ЧА ЧБ))))
        (let* ((m (+ 2 (rnd 4))) (g (имена "G" m)))
          (setf части (list g) арность 1
                решётки (list `(lattice L ,@g)))))
    ;; 🔴 РАВНОВЕСИЕ ВЫБОРКИ — не косметика. В первом прогоне 86% программ падали на дно
    ;; (молчание в опоре роняет всё, да и нулевой индекс степени сам по себе дно), и грань
    ;; тогда почти не участвует: ноль расхождений на такой выборке стоил бы мало. Молчания
    ;; и отзывы сделаны реже, степени смещены вверх, и тест ТРЕБУЕТ доли недонных случаев.
    (let* ((kw (1+ (rnd 4)))                        ; свидетелей 1..4
           (ks (if (= 0 (mod idx 4)) 1 0))          ; молчание — у каждой четвёртой
           (св (имена "W" kw)) (мл (имена "S" ks))
           ;; 🐛 РЕШЁТКИ ДЕРЖИМ ОТДЕЛЬНО от тела. Раньше тело копилось `push`-ем поверх
           ;; решёток и всё вместе разворачивалось — решётки выходили в обратном порядке,
           ;; произведение объявлялось раньше своих частей, и действующей становилась
           ;; не та решётка. Первый же прогон харнесса это и вскрыл.
           (посылки '()) (тело '()) (формы '()))
      ;; свидетели: у КАЖДОГО свой корень — свёртка по корням не должна вмешиваться
      (loop for w in св for i from 1 do
        (let* ((инд (mapcar (lambda (ч) (if (= 0 (rnd 4)) 0 (1+ (rnd (1- (length ч))))))
                            части))
               (степень (if (= арность 1)
                            (nth (first инд) (first части))
                            (loop for ч in части for j in инд collect (nth j ч)))))
          (push `(witness ,w "…" :grade ,степень
                          :f ,(/ (+ 3 (rnd 7)) 10.0) :c 0.6
                          :source (,(intern (format nil "R~a" i))))
                тело)
          (push (list* 0 i инд) посылки)))
      ;; молчания: в ОПОРНОЙ роли — по T-CLAIM они роняют степень на дно
      (loop for s in мл for j from 1 do
        (push `(ask ,s :in (реестр) :reason "не нашли") тело)
        (push (list* 1 (+ 100 j) '()) посылки))
      ;; отзывы: 0..2 свидетелей, до утверждения
      (let ((отз '()) (мёртвые '()))
        (dotimes (_ (rnd 2))
          (let* ((k (rnd kw)) (w (nth k св)) (id (1+ k)))
            (unless (member id мёртвые)
              (push id мёртвые)
              (push `(retract ,w :reason "проверка") отз))))
        ;; порядок жёсткий и он же порядок чтения: решётки → тело → отзывы → утверждение
        (setf формы (append решётки (nreverse тело) (nreverse отз)
                            (list `(claim ВЫВОД (from ,@св ,@мл)))))
        (values формы арность (nreverse посылки) мёртвые)))))

;;; ── КОДИРОВЩИК под протокол оракула ─────────────────────────────────────────
(defun закодировать (арность посылки мёртвые out)
  (format out "~a ~a " арность (length посылки))
  (dolist (p посылки)
    (destructuring-bind (вид id . инд) p
      (format out "~a ~a " вид id)
      (when (= вид 0) (format out "~{~a ~}" инд))))
  (format out "~a ~{~a ~}~%" (length мёртвые) мёртвые))

;;; ── ДЕКОДИРОВЩИК: кортеж индексов → степень нолanga ─────────────────────────
;;; 🔴 ЕДИНСТВЕННОЕ место, где представления приводятся друг к другу, и оно названо.
(defun оракул→степень (числа решётка)
  "ЧИСЛА — (длина зн₁ …). Длина 0 — дно модели; у нолanga дно записано нулевыми индексами."
  (let ((len (first числа)) (зн (rest числа)))
    (if (= len 0)
        (g-bot-of решётка)
        (if (lat-linear-p решётка)
            (nth (first зн) (lat-order решётка))
            (loop for ч in (lat-parts решётка) for i in зн collect (nth i (lat-order ч)))))))

(defun разобрать-строку (строка)
  "«1 2 | 1 2» → (values слева справа), каждое — список чисел."
  (let* ((p (position #\| строка))
         (чт (lambda (s) (let ((out '()) (i 0))
                           (loop (multiple-value-bind (v j)
                                     (parse-integer s :start i :junk-allowed t)
                                   (if v (progn (push v out) (setf i j)) (return))))
                           (nreverse out)))))
    (values (funcall чт (subseq строка 0 p)) (funcall чт (subseq строка (1+ p))))))

;;; ── ПРОГОН ──────────────────────────────────────────────────────────────────
(defun решётка-программы (формы)
  "Описатель действующей решётки — тот же путь, каким её видит проверяющий."
  (with-prelude
    (dolist (f формы) (when (string= (head-of f) "lattice") (chk-lattice f)))
    *lattice*))

(defun собрать-партию (n)
  "→ список записей (формы решётка) и файл входа для оракула."
  (let ((записи '()))
    (with-open-file (out *вход* :direction :output :if-exists :supersede
                                :if-does-not-exist :create)
      (dotimes (i n)
        (multiple-value-bind (формы арность посылки мёртвые) (случайная-программа i)
          (закодировать арность посылки мёртвые out)
          (push (list формы (решётка-программы формы)) записи))))
    (nreverse записи)))

(defun спросить-оракула ()
  (sb-ext:run-program (namestring *бинарь*) '()
                      :input *вход* :output *выход* :if-output-exists :supersede
                      :search nil :wait t)
  (with-open-file (in *выход*)
    (loop for l = (read-line in nil) while l when (find #\| l) collect l)))

(defun сверить (записи строки &key (порча #'identity))
  "→ (values расхождений сверено). ПОРЧА — намеренная порча ответа Лиспа (проверка,
   что харнесс умеет ловить). При #'identity расхождений обязано быть ноль."
  (let ((плохих 0) (всего 0) (первое nil))
    (loop for зап in записи for стр in строки do
      (destructuring-bind (формы решётка) зап
        (multiple-value-bind (слева справа) (разобрать-строку стр)
          (let ((эталон-chk (оракул→степень слева решётка))
                (эталон-red (оракул→степень справа решётка))
                (лисп-стат (funcall порча (grade-of формы 'ВЫВОД)))
                (лисп-прог (funcall порча (grade-at-runtime формы 'ВЫВОД))))
            (incf всего)
            (unless (and (equal эталон-chk эталон-red)      ; preservation, видимая в выводе
                         (equal лисп-стат эталон-chk)
                         (equal лисп-прог эталон-chk))
              (incf плохих)
              (unless первое
                (setf первое (list :ждали эталон-chk :статика лисп-стат :прогон лисп-прог))))))))
    (values плохих всего первое)))

(format t "~&── B1. ДОКАЗАННАЯ МОДЕЛЬ СОБРАНА В ИСПОЛНИМОЕ ──~%")
(check "бинарь оракула на месте" (probe-file *бинарь*))

(let* ((ручные (format nil "1 2  0 1 2  0 2 1  0~%1 2  0 1 2  0 2 1  1 2~%~
                            1 2  0 1 3  1 2  0~%1 0  0~%2 2  0 1 2 0  0 2 1 3  0~%")))
  (with-open-file (out *вход* :direction :output :if-exists :supersede
                              :if-does-not-exist :create)
    (write-string ручные out))
  (let ((строки (спросить-оракула)))
    (check "три ручных примера и ещё два: ответов ровно пять" (= 5 (length строки)))
    (check "грань двух степеней: min(2,1) = 1"
           (equal '(1 1) (nth-value 0 (разобрать-строку (first строки)))))
    (check "отзыв убирает посылку: остаётся 2"
           (equal '(1 2) (nth-value 0 (разобрать-строку (second строки)))))
    (check "🔴 молчание в опоре роняет на дно"
           (equal '(0) (nth-value 0 (разобрать-строку (third строки)))))
    (check "пустая база — дно, а не верх решётки"
           (equal '(0) (nth-value 0 (разобрать-строку (fourth строки)))))
    (check "решётка-произведение: (2,0) ⊓ (1,3) = (1,0)"
           (equal '(2 1 0) (nth-value 0 (разобрать-строку (fifth строки)))))
    (check "🔴 chk = red в КАЖДОЙ строке — доказанное равенство видно в выводе"
           (every (lambda (s) (multiple-value-bind (l r) (разобрать-строку s) (equal l r)))
                  строки))))

(format t "~&── B2-B3. ~a СЛУЧАЙНЫХ ПРОГРАММ ПРОТИВ МОДЕЛИ ──~%" *программ*)

(defparameter *записи* (собрать-партию *программ*))
(defparameter *строки* (спросить-оракула))

(check "оракул ответил на каждую программу"
       (= (length *записи*) (length *строки*) *программ*))

(multiple-value-bind (плохих всего первое) (сверить *записи* *строки*)
  (when (> плохих 0) (format t "      ПЕРВОЕ РАСХОЖДЕНИЕ: ~a~%" первое))
  (check "🔴 расхождений с доказанной моделью НЕТ" (= плохих 0))
  (check "…и сверено действительно всё (счётом в этом же прогоне)"
         (progn (format t "      [сверено программ: ~a · расхождений: ~a]~%" всего плохих)
                (= всего *программ*))))

;;; выборка обязана быть РАЗНООБРАЗНОЙ: иначе ноль расхождений ничего не стоит
(let ((произв 0) (дно 0) (с-отзывом 0) (недно 0))
  (dolist (з *записи*)
    (destructuring-bind (формы решётка) з
      (unless (lat-linear-p решётка) (incf произв))
      (if (equal (grade-of формы 'ВЫВОД) (g-bot-of решётка)) (incf дно) (incf недно))
      (when (find-if (lambda (f) (string= (head-of f) "retract")) формы) (incf с-отзывом))))
  (check "выборка разнообразна: произведения, отзывы, дно И НЕ-дно"
         (progn (format t "      [произведений: ~a · с отзывами: ~a · на дне: ~a · выше дна: ~a]~%"
                        произв с-отзывом дно недно)
                ;; 🔴 требуем ОБЕ стороны: программа, упавшая на дно, грань почти не проверяет
                (and (> произв 100) (> с-отзывом 200) (> дно 100) (> недно 400)))))

(format t "~&── B3-bis. ХАРНЕСС ОБЯЗАН УМЕТЬ ЛОВИТЬ ──~%")
;;; 🔴 ЗАКОН XII: инструмент, который я в этом прогоне не пробовал сломать, не имеет права
;;; давать мне число. Ломаем ДВАЖДЫ и по-разному: сперва ответ, потом само ядро свёртки.

(multiple-value-bind (плохих всего)
    (сверить *записи* *строки*
             :порча (lambda (g) (if (consp g) (cons :ЧУШЬ (rest g)) :ЧУШЬ)))
  (declare (ignore всего))
  (check "испорченный ответ Лиспа харнесс ловит" (> плохих 1000))
  (format t "      [поймано порченых: ~a из ~a]~%" плохих *программ*))

;;; настоящая порча: `g-meet` возвращает первый довод — классическая ошибка «решётка
;;; линейна, значит грань это один из двух». Ровно та, что уже была в истории языка.
;;; 🔴 ЧУВСТВИТЕЛЬНОСТЬ МЕРЯЕТСЯ ОТ НАБЛЮДАЕМОГО, А НЕ ОТ ВСЕЙ ВЫБОРКИ (06.08.2026).
;;; Прежде здесь стояло «поймано 153 из 200», и это читалось — мной же, вслух, оператору —
;;; как «слепая четверть»: будто четверть поломок проходит незамеченной. УТВЕРЖДЕНИЕ БЫЛО
;;; НЕВЕРНО, и вот почему.
;;;
;;; Харнесс сравнивает вывод Лиспа с эталоном, а на нетронутой функции расхождений НОЛЬ —
;;; значит эталон и есть вывод целого Лиспа. Тогда «харнесс поймал» ⟺ «порча изменила вывод»,
;;; тождественно по построению. Пойманное не может быть меньше наблюдаемого.
;;;
;;; Замер (200 программ): вывод меняется у 153, НЕ меняется у 47. То есть ловится 153 из 153
;;; наблюдаемых — сто процентов. На остальных 47 ловить НЕЧЕГО: подменённая функция даёт там
;;; тот же ответ, что целая.
;;;
;;; 🔴 И ВОТ ЧТО ЗА КЛАСС ЭТИ 47 — здесь польза, а не оправдание. Двадцать четыре из них —
;;; программы, где ЕДИНСТВЕННЫЙ свидетель отозван: все посылки мертвы, вывод падает на дно
;;; по построению, свёртывать нечего. Остальные — случаи с одной живой посылкой. Убирать их
;;; из выборки НЕЛЬЗЯ: они проверяют отзыв и дно, то есть другое. Но и держать их в
;;; знаменателе чувствительности нельзя — это меряло бы разнообразие генератора, а не зоркость
;;; сторожа. Две разные величины под одним числом — то же отмывание счётом, против которого
;;; заведён `formal/count.py`.
;;;
;;; Поэтому ниже считаются ОБА числа и требуется РАВЕНСТВО: поймано = наблюдаемо.
(let ((цел (fdefinition 'g-meet))
      (партия (subseq *записи* 0 200))
      (целые '()) (наблюдаемо 0))
  (dolist (з партия) (push (grade-of (first з) 'ВЫВОД) целые))
  (setf целые (nreverse целые))
  (unwind-protect
       (progn
         (setf (fdefinition 'g-meet) (lambda (a b) (declare (ignore b)) a))
         ;; сколько программ вообще РАЗЛИЧАЮТ целую и порченую функцию
         (loop for з in партия for c in целые
               unless (equal c (grade-of (first з) 'ВЫВОД)) do (incf наблюдаемо))
         (multiple-value-bind (плохих) (сверить партия (subseq *строки* 0 200))
           (check "🔴 подменённая `g-meet` — харнесс ловит ВСЁ наблюдаемое (поймано = наблюдаемо)"
                  (and (= плохих наблюдаемо) (> наблюдаемо 100)))
           (format t "      [поймано ~a из ~a наблюдаемых · на ~a программах порча не проявляется]~%"
                   плохих наблюдаемо (- 200 наблюдаемо))))
    (setf (fdefinition 'g-meet) цел)))

(multiple-value-bind (плохих) (сверить *записи* *строки*)
  (check "…и после восстановления `g-meet` снова ноль расхождений" (= плохих 0)))

(format t "~&ОРАКУЛ: сверено программ: ~a~%" *программ*)
(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
