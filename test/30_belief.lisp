;;;; test/30_belief.lisp — ПРОИЗВОДНЫЕ ВЕЛИЧИНЫ и на какой из них висит гейт.
;;;; Run: sbcl --script test/30_belief.lisp
;;;;
;;;; ПОВОД: арифметика опровергла пятый пример собственных ПРИМЕРОВ_v0.
;;;; Там написано «c падает 0.95 → 0.3» после опровергающего свидетеля. Это НЕВОЗМОЖНО:
;;;; ревизия есть сложение свидетельств, w только растёт, значит c = w/(w+k) только растёт.
;;;; Считано: f 0.950→0.500 (разорваны пополам), c 0.900→0.947 (знаем БОЛЬШЕ).
;;;;
;;;; Отсюда вопрос, который пример задал, сам того не заметив: НА ЧЁМ висит гейт?
;;;; Не на c: утверждение может иметь высокую уверенность и быть разорванным пополам.
;;;; Не на f: частота 0.95 при c=0.01 — это один шёпот, а не основание для необратимого.
;;;; Ответ — МАССА ВЕРЫ  b = w⁺/(w+k),  и она в точности равна f·c.
(load (merge-pathnames "../src/evidence.lisp" *load-pathname*))

(defun ~= (a b &optional (eps 1e-5)) (< (abs (- a b)) eps))
(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))
(defun rnd-f () (+ 0.01 (random 0.98)))
(defun rnd-c () (+ 0.01 (random 0.90)))
(defparameter *trials* 200)

;;; Тройка Йосанга из наших координат: вера · неверие · неведение.
(defun belief    (f c) (* f c))                 ; b = w⁺/(w+k)
(defun disbelief (f c) (* (- 1 f) c))           ; d = w⁻/(w+k)
(defun ignorance (f c) (declare (ignore f)) (- 1 c))  ; u = k/(w+k)

(format t "~&── b = f·c ЕСТЬ масса веры w⁺/(w+k) — не определение, а тождество ──~%")

(let ((ok t))
  (dotimes (i *trials*)
    (let ((f (rnd-f)) (c (rnd-c)))
      (multiple-value-bind (w+ w-) (fc->evidence f c)
        (unless (~= (belief f c) (/ w+ (+ w+ w- *k*))) (setf ok nil)))))
  (check "b = f·c = w⁺/(w+k) (200 случайных)" ok))

(let ((ok t))
  (dotimes (i *trials*)
    (let ((f (rnd-f)) (c (rnd-c)))
      (unless (~= 1.0 (+ (belief f c) (disbelief f c) (ignorance f c))) (setf ok nil))))
  (check "b + d + u = 1 — три доли делят единицу без остатка" ok))

(let ((ok t))
  (dotimes (i *trials*)
    (let ((f (rnd-f)) (c (rnd-c)))
      (unless (> (ignorance f c) 0) (setf ok nil))))
  (check "u > 0 всегда — граница Эйн-Соф: неведение неустранимо" ok))

(format t "~&── ЧТО ИМЕННО ПАДАЕТ при опровержении (разбор пятого примера) ──~%")

(multiple-value-bind (f c) (t-revise 0.5 0.0 0.95 0.90)
  (multiple-value-bind (f2 c2) (t-revise f c 0.05 0.90)
    (check "c РАСТЁТ: опровержение — это тоже знание" (> c2 c))
    (check "f падает к половине: мы разорваны" (and (< f2 f) (~= f2 0.5 0.02)))
    (check "🔴 b ПАДАЕТ — вот величина, которую пример имел в виду"
           (< (belief f2 c2) (belief f c)))
    (check "падение b существенно, а не на эпсилон (0.855 → 0.474)"
           (> (- (belief f c) (belief f2 c2)) 0.3))))

(format t "~&── почему гейт нельзя вешать ни на c, ни на f по отдельности ──~%")

(check "высокая c при разорванной f: c=0.95, f=0.5 → b ≈ 0.475, действовать НЕЛЬЗЯ"
       (< (belief 0.5 0.95) 0.5))
(check "высокая f при пустой c: f=0.99, c=0.01 → b ≈ 0.01, один шёпот"
       (< (belief 0.99 0.01) 0.02))
(check "и то и другое: f=0.95, c=0.95 → b ≈ 0.90, вот это основание"
       (> (belief 0.95 0.95) 0.89))

(format t "~&── ЗАКОН ГЕЙТА: монотонность по согласному свидетелю ──~%")

;;; Рост знания не должен превращать разрешённое действие в запрещённое —
;;; иначе агент начнёт БОЯТЬСЯ узнавать новое. Проверяем на согласных свидетелях.
(let ((ok t) (n 0))
  (dotimes (i *trials*)
    (let* ((f (+ 0.6 (random 0.39))) (c (rnd-c))     ; свидетель скорее «за»
           (fw f) (cw (rnd-c)))                       ; согласный с ним второй
      (multiple-value-bind (f2 c2) (t-revise f c fw cw)
        (incf n)
        (unless (>= (belief f2 c2) (- (belief f c) 1e-5)) (setf ok nil)))))
  (check "согласный свидетель НИКОГДА не понижает b (200 случайных)" (and ok (= n *trials*))))

;;; 🔴 ТОЧНЫЙ КРИТЕРИЙ ПАДЕНИЯ. Первая редакция этого теста утверждала «несогласный
;;; свидетель ВСЕГДА понижает b» — и упала. Упала ВЕРНО. Выкладка:
;;;   b′ < b  ⟺  (w⁺+f′w′)/(w+w′+k) < w⁺/(w+k)  ⟺  f′w′(w+k) < w⁺w′  ⟺  f′ < b
;;; Свидетель роняет веру не тем, что он «против», а тем, что его частота НИЖЕ
;;; уже накопленной массы веры. Свидетель с f′=0.25 при b=0.21 — всё ещё подкрепление.
;;; Порог сравнения — сама вера, а не половина. Это делает гейт самоцентрирующимся.
(let ((ok t) (fell 0) (rose 0))
  (dotimes (i *trials*)
    (let* ((f (rnd-f)) (c (rnd-c)) (fw (rnd-f)) (cw (rnd-c))
           (b (belief f c)))
      (multiple-value-bind (f2 c2) (t-revise f c fw cw)
        (let ((b2 (belief f2 c2)))
          (if (< b2 b) (incf fell) (incf rose))
          ;; предсказание должно совпадать с фактом на КАЖДОМ входе
          (unless (or (~= fw b 1e-4)
                      (eq (< fw b) (< b2 b)))
            (setf ok nil))))))
  (check "критерий точен: b падает ⟺ f′ < b (200 случайных, обе стороны встретились)"
         (and ok (> fell 10) (> rose 10))))

;;; Следствие: свидетель с f′ = b оставляет веру на месте, сколько бы веса ни принёс.
(let ((ok t))
  (dotimes (i 50)
    (let* ((f (rnd-f)) (c (rnd-c)) (b (belief f c)) (cw (rnd-c)))
      (multiple-value-bind (f2 c2) (t-revise f c b cw)
        (unless (~= (belief f2 c2) b 1e-4) (setf ok nil)))))
  (check "свидетель ровно на уровне веры (f′ = b) не двигает её — неподвижная точка" ok))

(format t "~&── молчание и гейт ──~%")

(multiple-value-bind (f c) (t-revise 0.9 0.6 0.5 0.0)
  (check "молчание не двигает b — нейтраль и здесь" (~= (belief f c) (belief 0.9 0.6))))
(check "чистое молчание: b = 0 — необратимое запрещено при любом пороге > 0"
       (~= (belief 0.5 0.0) 0.0))

(format t "~%── ALL GREEN · свойств проверено: ~a ──~%" *n*)
(format t "~&ВЫВОД: гейт необратимого висит на МАССЕ ВЕРЫ b = f·c, не на c.~%~
           ПРИМЕРЫ_v0 пример 4 (:requires (>= confidence 0.9)) и пример 5 — исправить.~%")
