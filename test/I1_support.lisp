;;;; test/I1_support.lisp — ПОДДЕРЖКА КАК МНОЖЕСТВО КОРНЕЙ.
;;;; Run: sbcl --script test/I1_support.lisp
;;;;
;;;; ПОВОД. Я нашёл дефект счёта на настоящем примере (`ПРИМЕР_ФАРМАКОЛОГИЯ.md`, находка 2):
;;;; свидетель несёт корень, а выведенное утверждение — нет (`origin = nil`), и свёртка
;;;; группировала посылки ПО КОРНЮ. Значит два НЕЗАВИСИМЫХ вывода попадали в одну группу «nil»
;;;; и один поглощался как копия другого: 0.540 вместо 0.675.
;;;;
;;;; 🔴 ПОЧЕМУ ОЧЕВИДНАЯ ПОЧИНКА БЫЛА БЫ ХУЖЕ БОЛЕЗНИ. «Пусть вывод будет сам себе корень»
;;;; меняет БЕЗОПАСНУЮ ошибку (занижение) на ОПАСНУЮ (завышение): два вывода из одного предка
;;;; сложили бы его дважды. Поэтому я не чинил, пока Невис не доказала носитель.
;;;;
;;;; 🔴 ЧТО ОНА ДОКАЗАЛА (`formal/SupportSet.agda`, 29.07) — и почему это носитель, а не проверка.
;;;; Диагноз из двух уже доказанных файлов: степень живёт на `⊓` (идемпотентна), масса веры —
;;;; на `⊕` (НЕ идемпотентна). Реализация протаскивала «откуда» через неидемпотентный носитель —
;;;; отсюда обе беды разом. Решающий ход: **масса определена по ЧЛЕНСТВУ, а не по списку**
;;;; (`massUpTo` берёт вклад корня, если корень в поддержке). Тогда всё верное для множеств
;;;; переносится на веру даром:
;;;;   `mass-resp-∈`    — масса зависит только от членства;
;;;;   `∪-idem`         — предок не считается дважды, СТРУКТУРНО;
;;;;   `∪-comm`         — порядок посылок не влияет;
;;;;   `derived≡direct` — вывод даёт РОВНО ту же массу, что прямое основание;
;;;;   `shared-root-once`, `mono-∈`.
;;;;
;;;; Здесь эти теоремы предъявлены СЧЁТОМ на реализации. Тест написан с ПРАВИЛЬНЫМИ ожиданиями
;;;; (не подогнан под текущее поведение) и до починки обязан быть красным.
(load (merge-pathnames "../src/reduce.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))
(defun ~= (a b &optional (eps 1e-6)) (< (abs (- a b)) eps))
(defun b-of (p id) (belief-at-runtime p id))

;;; ── СЛУЧАЙ 1: два НЕЗАВИСИМЫХ вывода. Занижения быть не должно ──────────────
(defparameter *через-выводы*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (witness w2 "…" :grade строго :f 0.9 :c 0.6 :source (r2))
    (claim a (from w1))
    (claim b (from w2))
    (claim c (from a b))))
(defparameter *напрямую*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (witness w2 "…" :grade строго :f 0.9 :c 0.6 :source (r2))
    (claim c (from w1 w2))))

(format t "~&── derived ≡ direct: вывод не теряет независимого свидетельства ──~%")

(check "🔴 через выводы вера РАВНА прямому основанию (её `derived≡direct`)"
       (~= (b-of *через-выводы* 'c) (b-of *напрямую* 'c)))
(check "…и это не совпадение нулей: вера строго больше одного свидетеля"
       (> (b-of *напрямую* 'c)
          (b-of '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                  (claim c (from w1))) 'c)))
(check "поддержка вывода — ОБА корня, а не `nil`"
       (let ((v (gethash 'c (run-nolang *через-выводы*))))
         (and (member 'r1 (jv-roots v)) (member 'r2 (jv-roots v))
              (not (member nil (jv-roots v))))))
(check "🔴 и в журнале больше нет поглощения «копии корня NIL»"
       (let ((v (gethash 'c (run-nolang *через-выводы*))))
         (notany (lambda (cl) (null (first cl))) (jv-collapsed v))))

(format t "~&── shared-root-once: общий предок считается РОВНО ОДИН раз ──~%")

;;; Оба вывода растут из ОДНОГО свидетеля. Наивная починка («вывод сам себе корень»)
;;; сложила бы его дважды — вот проверка, что этого не происходит.
(defparameter *общий-предок*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (claim a (from w1))
    (claim b (from w1))
    (claim c (from a b))))
(defparameter *один-раз*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (claim c (from w1))))

(check "🔴 два вывода из ОДНОГО предка дают ровно то же, что предок один раз"
       (~= (b-of *общий-предок* 'c) (b-of *один-раз* 'c)))
(check "…и СТРОГО меньше, чем два независимых корня (удвоения нет)"
       (< (b-of *общий-предок* 'c) (b-of *напрямую* 'c)))
(check "поддержка общего предка — множество из одного корня"
       (equal '(r1) (jv-roots (gethash 'c (run-nolang *общий-предок*)))))

(format t "~&── ∪-comm и ∪-idem: порядок и повторы не меняют веру ──~%")

(check "порядок посылок не меняет веру (её `∪-comm`)"
       (~= (b-of *через-выводы* 'c)
           (b-of '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                   (witness w2 "…" :grade строго :f 0.9 :c 0.6 :source (r2))
                   (claim a (from w1)) (claim b (from w2))
                   (claim c (from b a))) 'c)))
(check "смешение вывода и его же свидетеля не удваивает (её `∪-idem`)"
       (~= (b-of '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                   (claim a (from w1))
                   (claim c (from a w1))) 'c)
           (b-of *один-раз* 'c)))
(check "глубина вывода не меняет веру: цепочка a→b→c равна прямому"
       (~= (b-of '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                   (claim a (from w1)) (claim b (from a)) (claim c (from b))) 'c)
           (b-of *один-раз* 'c)))

(format t "~&── I2. ИНВАРИАНТ БЕЗОПАСНОСТИ (обязан быть зелёным ДО и ПОСЛЕ) ──~%")
;;; 🔴 Этот инвариант пережил починку и обязан переживать любую следующую: через выводы вера
;;; НЕ ВЫШЕ, чем напрямую. Занижение — долг; завышение — отмывание. После `SupportSet` он
;;; выполняется с равенством, но проверять надо именно неравенство: равенство — сегодняшний
;;; факт, а неравенство — закон.
(check "🔴 через выводы вера НЕ ВЫШЕ, чем напрямую"
       (<= (b-of *через-выводы* 'c) (+ 1e-9 (b-of *напрямую* 'c))))
(check "…и при общем предке тоже не выше"
       (<= (b-of *общий-предок* 'c) (+ 1e-9 (b-of *один-раз* 'c))))

(let ((ok t) (случаев 0))
  (dotimes (i 150)
    (let* ((k (1+ (mod i 3)))
           (ws (loop for j below k collect (intern (format nil "W~a" j))))
           (rs (loop for j below k collect (intern (format nil "R~a" (mod (+ i j) 2)))))
           (база (loop for w in ws for r in rs
                       collect `(witness ,w "…" :grade строго
                                 :f ,(/ (+ 3 (mod (* 7 (+ i 1)) 7)) 10.0) :c 0.6 :source (,r))))
           (выводы (loop for w in ws for j from 0
                         collect `(claim ,(intern (format nil "A~a" j)) (from ,w))))
           (имена (mapcar #'second выводы))
           (через (append база выводы (list `(claim c (from ,@имена)))))
           (прямо (append база (list `(claim c (from ,@ws))))))
      (incf случаев)
      (unless (<= (b-of через 'c) (+ 1e-9 (b-of прямо 'c))) (setf ok nil))))
  (check "150 случайных программ: инвариант держится на всех" ok)
  (check "…и все 150 прогнаны (счётом)"
         (progn (format t "      [сверено случаев: ~a]~%" случаев) (= случаев 150))))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
