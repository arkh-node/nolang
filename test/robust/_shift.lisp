;; Замер деградации conformal-порога при нарушении обмениваемости.
;; 🔴 Проверяется НЕ то, что гарантия работает, а то, что она ЛОМАЕТСЯ — и что мы это знаем.
;; Тест, подтверждающий только хорошее, оставил бы читателя с ложным чувством защищённости.
(load (merge-pathnames "../../src/theta.lisp" *load-pathname*))
;; Э К С П Е Р И М Е Н Т: что делает conformal-порог, когда обмениваемость нарушена.
;; Калибруемся на одном режиме мира, применяем в другом — и смотрим, сколько лжи проходит.
(defun sample-false (n center spread seed)
  "Веры ЛОЖНЫХ утверждений: n штук вокруг center."
  (let ((st (sb-kernel::seed-random-state seed)))
    (loop repeat n collect (max 0.0 (min 0.999 (+ center (* spread (- (random 1.0 st) 0.5))))))))

(defun leak (theta falses)
  "Доля ложных, прошедших порог."
  (/ (count-if (lambda (b) (>= b theta)) falses) (float (length falses))))

(defun chk (c msg) (format t "~&~a ~a~%" (if c "OK" "FAIL") msg))
(let* ((alpha 0.1)
       (calib (sample-false 200 0.30 0.30 42))
       (theta (theta-conformal calib alpha)))
  ;; при сохранённой обмениваемости утечка близка к обещанной (маргинально)
  (chk (< (leak theta (sample-false 200 0.30 0.30 7)) 0.25)
       "обмениваемость держится — утечка близка к α (гарантия маргинальная, не поточечная)")
  ;; при сдвиге — рушится, и это ДОЛЖНО быть видно
  (chk (> (leak theta (sample-false 200 0.45 0.30 7)) 0.5)
       "лёгкий сдвиг — гарантия НЕ действует: утечка выше половины")
  (chk (> (leak theta (sample-false 200 0.60 0.30 7)) 0.9)
       "сильный сдвиг — сквозь гейт проходит почти всё ложное")
  (chk (> (leak theta (sample-false 200 0.75 0.20 7)) 0.9)
       "состязательный вход — гейт не защищает вовсе")
  ;; пустая калибровка не даёт права на риск
  (chk (= 1.0 (theta-conformal '() alpha))
       "пустая калибровка → порог 1.0: отказ действовать, а не догадка"))
