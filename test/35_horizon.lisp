;;;; test/35_horizon.lisp — ГОРИЗОНТ `k` КАК ОБЪЯВЛЕНИЕ ПРОГРАММЫ.
;;;; Run: sbcl --script test/35_horizon.lisp
;;;;
;;;; ПОВОД (разбор Невис, 29.07). Порог θ мы ВЫВЕЛИ (Эрроу–Фишер), а горизонт `k` до сих
;;;; пор брали по умолчанию — несимметрия была видна и записана долгом. Её разбор:
;;;;   `k > 0` — ТЕОРЕМА: при `k = 0` имеем `c = w/(w+0) = 1` для любого непустого
;;;;      свидетельства, то есть полная уверенность достижима КОНЕЧНЫМ свидетельством,
;;;;      и граница Эйн-Соф падает. Значит `k > 0` есть условие её существования.
;;;;   величина `k` — СВОЙСТВО КОРПУСА и объявляется программой, как решётка:
;;;;      `c = w/(w+k)` читается как доля — собранное от собираемого.
;;;;   🔴 родство с θ ЛОЖНОЕ: θ отвечает «стоит ли действовать» (о последствиях),
;;;;      `k` — «много ли я вообще могу узнать» (о полноте сбора). Свести их значило бы
;;;;      сделать уверенность функцией от ставки: чем страшнее ошибка, тем менее уверен —
;;;;      а это не эпистемология, а трусость, записанная в носитель.
(load (merge-pathnames "../src/parse.lisp" *load-pathname*))
(load (merge-pathnames "../src/reduce.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))

(defun вера-при (гор)
  (belief-at-runtime
   (parse (format nil "~@[horizon ~a~%~]lattice L = слабо < строго
witness a : строго says \"…\" source r1 evidence 5 for 0 against
witness b : строго says \"…\" source r2 evidence 5 for 0 against
claim вывод from a, b" гор))
   'вывод))

(format t "~&── ГОРИЗОНТ ДЕЙСТВУЕТ, И В ВЕРНУЮ СТОРОНУ ──~%")

(check "🔴 горизонт МЕНЯЕТ веру — иначе форма есть, а смысла нет"
       (> (abs (- (вера-при 1) (вера-при 20))) 0.5))
(check "🔴 …и в ВЕРНУЮ сторону: больше собираемого ⇒ НИЖЕ уверенность в собранном"
       (> (вера-при 1) (вера-при 4) (вера-при 20) (вера-при 100)))
(check "умолчание равно `horizon 1` — и это умолчание, а не истина"
       (< (abs (- (вера-при nil) (вера-при 1))) 1e-6))
(check "счётом: десять свидетельств при горизонте 20 дают ровно 10/30"
       (< (abs (- (вера-при 20) (/ 10.0 30.0))) 1e-4))
(check "🔴 статика сходится с прогоном при ЛЮБОМ горизонте"
       (every (lambda (гор)
                (let ((f (parse (format nil "horizon ~a
lattice L = слабо < строго
witness a : строго says \"…\" source r1 evidence 5 for 0 against
claim вывод from a" гор))))
                  (eq (grade-of f 'вывод) (grade-at-runtime f 'вывод))))
              '(1 4 20 100)))

(format t "~&── 🔴 `horizon 0` НЕЗАПИСЫВАЕМ (12-е состояние) ──~%")

(check "ноль не разбирается вовсе"
       (not (parse-ok? "horizon 0
lattice L = слабо < строго")))
(check "…и сообщение объясняет: это условие существования границы, а не вкус"
       (let ((e (parse-error-of "horizon 0
lattice L = слабо < строго")))
         (and (search "Эйн-Соф" e) (search "условие существования" e))))
(check "отрицательный тоже не разбирается"
       (not (parse-ok? "horizon -3
lattice L = слабо < строго")))

(format t "~&── ГОРИЗОНТ ЖИВЁТ РОВНО ОДНУ ПРОГРАММУ ──~%")

(check "прелюдия не запачкана после прогона с чужим горизонтом"
       (progn (вера-при 100) (< (abs (- *k* *prelude-horizon*)) 1e-9)))
(check "🔴 счёт свидетельств не зависит от горизонта — счёт есть НОСИТЕЛЬ, (f,c) карта над ним"
       ;; найдено при вводе горизонта: прежде парсер переводил счёт в (f,c) умолчательным k,
       ;; а машина обратно — программным, и вес раздувался в k_прогр/k_умолч раз
       (let ((w1 (parse "horizon 1
witness a : строго says \"…\" source r evidence 8 for 1 against"))
             (w2 (parse "horizon 50
witness a : строго says \"…\" source r evidence 8 for 1 against")))
         (and (= (kw (second w1) :w+) (kw (second w2) :w+))
              (= (kw (second w1) :w-) (kw (second w2) :w-)))))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
