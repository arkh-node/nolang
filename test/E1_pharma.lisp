;;;; test/E1_pharma.lisp — ВТОРОЙ ДОМЕН: пример на настоящих источниках.
;;;; Run: sbcl --script test/E1_pharma.lisp
;;;;
;;;; ПОВОД (наказ Невис, раздел C): второй домен — доказательство, что это язык, а не
;;;; запись под один корпус. Пример написан БЕЗ единой правки реализации; разбор со
;;;; ссылками и дословными цитатами — ПРИМЕР_ФАРМАКОЛОГИЯ.md.
;;;;
;;;; 🔴 Этот тест держит ЧЕТЫРЕ уровня разом (C4) и осиротение (C5), а сверх того —
;;;; ДВЕ НАХОДКИ, которые вскрыл настоящий пример. Находки закреплены НЕ как «так и надо»,
;;;; а как известное состояние: изменится поведение — тест упадёт и потребует решения,
;;;; а не проскользнёт молча.
(load (merge-pathnames "../src/parse.lisp" *load-pathname*))
(load (merge-pathnames "../src/reduce.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))
(defun ~= (a b &optional (eps 1e-4)) (< (abs (- a b)) eps))

(defparameter *файл*
  (concatenate 'string (directory-namestring *load-pathname*) "../examples/pharmacology.nol"))

(defparameter *исходник*
  ;; прелюдия + программа: разделение мест — свойство запуска, семантику проверяем целиком
  (example-source *файл*))

(defparameter *формы* (parse *исходник*))
(defparameter *без-отзыва* (remove-if (lambda (f) (string= (head-of f) "retract")) *формы*))

(format t "~&── ПРИМЕР РАЗБИРАЕТСЯ И ПРИНИМАЕТСЯ БЕЗ ПРАВОК ЯЗЫКА (C2-C3) ──~%")

(check "файл примера на месте и разбирается" (> (length *формы*) 10))
;;; 🔴 ПОВОРОТ 29.07, И ЭТО ГЛАВНЫЙ РЕЗУЛЬТАТ ФАЙЛА, А НЕ РЕГРЕССИЯ.
;;; До `Act` пример ПРИНИМАЛСЯ проверяющим: необратимая закупка проходила гейт по массе
;;; веры (0.889 ≥ 0.800), стоя на самом дне решётки. Язык честно печатал дно словами — и
;;; всё равно пропускал. Теперь требование к степени живёт в ТИПЕ действия, и программа
;;; **перестала типизироваться**: nolang отказался бы её собрать.
;;; Иначе говоря: решение, стоившее £424 млн, на этом языке не пишется.
(check "🔴 проверяющий ОТВЕРГАЕТ пример — и это результат, а не поломка"
       (member :req (errors-of *формы*)))
(check "…и отвергает ИМЕННО по степени основания, а не по вере"
       (let ((e (find :req (nth-value 1 (check-program *формы*)) :key #'terr-code)))
         (and e (search "требует основания не ниже" (terr-text e))
              (search "происхождение от этого не изменится" (terr-text e)))))
(check "других настоящих ошибок нет: пример корректен во всём остальном"
       (null (set-difference (errors-of *формы*) '(:runtime :gate-fail :req))))

(format t "~&── ЧЕТЫРЕ УРОВНЯ СРАБАТЫВАЮТ (C4) ──~%")

(defparameter *до* (gethash 'purchase_basis (run-nolang *без-отзыва*)))

;; 1. решётка-произведение
(check "1/4 решётка-произведение: степень основания — КОРТЕЖ, а не одно имя"
       (consp (jv-grade *до*)))
(check "…и это дно произведения: обе оси упали"
       (equal (jv-grade *до*) '(:observational :unavailable)))

;; 2. корни: два канала одного испытания сложены ОДИН раз
(check "2/4 корни: два свода одного корня свёрнуты, поглощение записано"
       (find-if (lambda (c) (and (eq (first c) 'ten_roche_trials)
                                 (eq (second c) 'kaiser2003)))
                (jv-collapsed *до*)))
(check "…представителем взят тяжелейший (тезисы, вес 8), а не публикация (вес 2)"
       (~= (jv-belief *до*) 0.889 0.002))
(check "…и это СТРОГО меньше, чем если бы каналы сложились как независимые"
       (< (jv-belief *до*)
          (jv-belief (gethash 'fiction
                              (run-nolang
                               (append *без-отзыва*
                                       '((claim fiction (from kaiser2003 cochrane2014)))))))))

;; 3. оба вида молчания
(defparameter *смерть* (gethash 'mortality_falls (run-nolang *без-отзыва*)))
(check "3/4 ОПОРНОЕ молчание: утверждение опирается на молчание и названо словами"
       (jv-leaned *смерть*))
(check "…и степень его при этом ДНО: подъёма из молчания в языке нет"
       (equal (jv-grade *смерть*) '(:observational :unavailable)))
(check "3/4 ОБЗОРНОЕ молчание: охват при основании напечатан, а не потреблён молча"
       (find 'registry_survey (mapcar #'first (jv-cover *до*))))

;; 4. гейт на необратимом
(defparameter *журнал-до* (nth-value 1 (run-nolang *без-отзыва*)))
(check "4/4 гейт на НЕОБРАТИМОМ сработал и записал основание и веру"
       (find-if (lambda (e) (and (eq (first e) :performed)
                                 (eq (second e) 'stockpile)
                                 (eq (third e) 'purchase_basis)))
                *журнал-до*))

(format t "~&── ОТЗЫВ КОРНЯ РОЖДАЕТ СИРОТУ (C5) ──~%")

(defparameter *журнал* (nth-value 1 (run-nolang *формы*)))
(defparameter *после* (gethash 'purchase_basis (run-nolang *формы*)))

(check "отзыв КОРНЯ снимает оба свода сразу — основание пересчитано"
       (~= (jv-belief *после*) 0.0))
(check "🔴 действие осиротело: основание больше не держит порог"
       (find-if (lambda (e) (and (eq (first e) :orphaned) (eq (second e) 'stockpile)))
                *журнал*))
(check "🔴 и оно НЕПОПРАВИМО: необратимому возмещать нечем"
       (find-if (lambda (e) (eq (first e) :irreparable)) *журнал*))
(check "причина отзыва сохранена дословно и её видно в журнале"
       (let ((e (find :retracted *журнал* :key #'first)))
         (and e (search "unable to determine" (third e)))))
(check "журнал ДОПИСЫВАЕТСЯ: запись о совершении не стёрта отзывом"
       (find-if (lambda (e) (eq (first e) :performed)) *журнал*))

(format t "~&── ✅ НАХОДКА 1 ЗАКРЫТА: ТРЕБОВАНИЕ К СТЕПЕНИ УШЛО В ТИП ──~%")
;;; Было: гейт стоит на массе веры и степени НЕ ВИДИТ; необратимое проходило, стоя на дне,
;;; а вердикт лишь говорил об этом красной строкой — то есть перекладывал работу на
;;; внимательного читателя.
;;; 🔴 Невис отвергла все три моих ответа и дала четвёртый, и он сильнее: требование к
;;; степени принадлежит ТИПУ ДЕЙСТВИЯ, а не гейту. Довод — от предмета: гейт есть проверка
;;; ВРЕМЕНИ ИСПОЛНЕНИЯ, а проверку обходят, не нарушая (принеси свидетельств — вера
;;; поднимется, происхождение останется прежним). Наш тезис «нечестность НЕВЫРАЗИМА», а не
;;; «нечестность отлавливается»; проверка в гейте вернула бы язык в класс библиотек-с-валидацией.
(check "🔴 необратимое на дне решётки стало НЕПРЕДСТАВИМЫМ, а не отлавливаемым"
       (member :req (errors-of *формы*)))
(check "…и гейт при этом НЕ тронут: он остался порогом по вере"
       ;; то же основание, но действие обратимое — требования к степени нет, гейт работает как прежде
       (let ((p (append *без-отзыва*
                        '((action пометка :reversibility reversible
                                  :requires (>= belief 0.5) :else свернуть)
                          (do пометка purchase_basis)))))
         (null (set-difference (errors-of p) '(:runtime :gate-fail :req)))))
(check "требование ДНА у необратимого отвергается отдельно: это не защита, а её вид"
       (member :req (errors-of (append *без-отзыва*
                                       '((action пустое :reversibility irreversible
                                          :needs-grade (наблюдение недоступно)
                                          :requires (>= belief 0.1) :else свернуть))))))

(format t "~&── 🔴 ВЫВОД ПОСЛЕ ОТКАЗА НЕ ЧИТАЕТСЯ КАК «ВСЁ РАВНО СОВЕРШИЛОСЬ» ──~%")
;;; Находка Невис (29.07): она прочла ХВОСТ вывода и на полминуты решила, что закупка всё же
;;; совершилась — в журнале стоит «✓ совершено … вера 0.889 ≥ порог 0.800». Только прокрутив
;;; вверх, увидела «ПРОВЕРКА: ОТКЛОНЕНО».
;;; 🔴 Ошибка её была в чтении куска, но дефект — настоящий и мой: печать журнала после отказа
;;; нарушает в ВЫВОДЕ ровно то различение, которое язык проводит в семантике. Отказ гейта есть
;;; ИСХОД программы; отклонение проверяющим значит, что программы НЕ БЫЛО, и всё напечатанное
;;; после есть рассказ о том, чего не случилось.
(defun вывод-с-отказом ()
  (with-output-to-string (*standard-output*)
    (multiple-value-bind (st lg) (run-nolang *формы* :carrier :морф)
      (show-run st lg :rejected t))))

(check "🔴 журнал отвергнутой программы озаглавлен «ЧТО БЫЛО БЫ», а не «ЖУРНАЛ»"
       (let ((o (вывод-с-отказом)))
         (and (search "ЖУРНАЛ: ЧТО БЫЛО БЫ" o)
              (not (search "── ЖУРНАЛ ──" o)))))
(check "…и сказано прямо, что ничего из этого не случилось"
       (search "Ничего из этого не случилось" (вывод-с-отказом)))
(check "…и утверждения тоже помечены как «что было бы»"
       (search "показано, ЧТО БЫЛО БЫ" (вывод-с-отказом)))
(check "у ПРИНЯТОЙ программы заголовок прежний — пометка не липнет ко всему подряд"
       (let ((o (with-output-to-string (*standard-output*)
                  (multiple-value-bind (st lg) (run-nolang *без-отзыва*) (show-run st lg)))))
         (and (search "── ЖУРНАЛ ──" o) (not (search "ЧТО БЫЛО БЫ" o)))))

(format t "~&── ✅ НАХОДКА 2 ЗАКРЫТА: ПОДДЕРЖКА СТАЛА МНОЖЕСТВОМ КОРНЕЙ ──~%")
;;; Было (найдено этим примером 29.07): свидетель нёс корень, выведенное утверждение — нет
;;; (`origin = nil`), свёртка группировала ПО КОРНЮ, и два НЕЗАВИСИМЫХ вывода схлопывались
;;; в группу «nil»: 0.540 вместо 0.675. Направление ошибки — занижение, не завышение.
;;; 🔴 Чинить очевидным способом («вывод сам себе корень») было НЕЛЬЗЯ: у зависимых выводов
;;; общий предок сложился бы дважды, то есть безопасная ошибка стала бы отмыванием.
;;; Стало (`formal/SupportSet.agda`, Невис 29.07): масса считается по ЧЛЕНСТВУ в поддержке,
;;; поддержка вывода — объединение поддержек посылок. Обе беды уходят одним носителем.
;;; Подробные проверки теорем — `test/I1_support.lisp`; здесь закреплено то, что вскрыл
;;; ИМЕННО этот пример, чтобы починка не откатилась незамеченной.
(defparameter *через-выводы*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (witness w2 "…" :grade строго :f 0.9 :c 0.6 :source (r2))
    (claim a (from w1)) (claim b (from w2)) (claim c (from a b))))
(defparameter *напрямую*
  '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (witness w2 "…" :grade строго :f 0.9 :c 0.6 :source (r2))
    (claim c (from w1 w2))))

(check "поддержка вывода — множество корней, а не `nil`"
       (equal '(r1 r2) (jv-roots (gethash 'c (run-nolang *через-выводы*)))))
(check "🔴 занижение 0.540 против 0.675 БОЛЬШЕ НЕ ВОЗНИКАЕТ"
       (~= (jv-belief (gethash 'c (run-nolang *через-выводы*)))
           (jv-belief (gethash 'c (run-nolang *напрямую*)))
           1e-6))
(check "…и ложная запись «поглощён как копия корня NIL» исчезла"
       (notany (lambda (cl) (null (first cl)))
               (jv-collapsed (gethash 'c (run-nolang *через-выводы*)))))
(check "🔴 ИНВАРИАНТ БЕЗОПАСНОСТИ ЦЕЛ: через выводы вера НЕ ВЫШЕ, чем напрямую"
       ;; он держался до починки (с занижением) и обязан держаться после (с равенством);
       ;; проверяем именно неравенство: равенство — сегодняшний факт, неравенство — закон
       (<= (jv-belief (gethash 'c (run-nolang *через-выводы*)))
           (+ 1e-9 (jv-belief (gethash 'c (run-nolang *напрямую*))))))
(check "общий предок не удваивается — то, чего боялась наивная починка"
       (~= (jv-belief (gethash 'c (run-nolang
                                   '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                                     (claim a (from w1)) (claim b (from w1))
                                     (claim c (from a b))))))
           (jv-belief (gethash 'c (run-nolang
                                   '((witness w1 "…" :grade строго :f 0.9 :c 0.6 :source (r1))
                                     (claim c (from w1))))))
           1e-6))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
