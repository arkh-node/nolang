;;;; test/G1_query.lisp — ЗАПРОСЫ К СКЛАДУ (наказ Невис, раздел E).
;;;; Run: sbcl --script test/G1_query.lisp
;;;;
;;;; 🔴 ГЛАВНОЕ, ЧТО ПРОВЕРЯЕТСЯ ЗДЕСЬ — не то, что ответы верны (это тоже), а ЗАКОН ОХВАТА:
;;;; всякий ответ обязан сказать, где искал и чего не нашёл. Пустой ответ без охвата — худший
;;;; вид лжи: «ничего нет» и «я не искал» выглядят одинаково. Поэтому проверки на ПУСТЫХ
;;;; ответах здесь важнее проверок на полных.
(load (merge-pathnames "../src/query.lisp" *load-pathname*))
(load (merge-pathnames "../src/parse.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))

(defparameter *файл*
  (concatenate 'string (directory-namestring *load-pathname*) "../examples/pharmacology.nol"))
(defparameter *формы*
  ;; прелюдия + программа: разделение мест — свойство запуска, семантику проверяем целиком
  (parse (example-source *файл*)))

(defvar *склад*) (defvar *журнал*)
(multiple-value-setq (*склад* *журнал*) (run-nolang *формы* :carrier :морф))

(defun текст (a) (with-output-to-string (*standard-output*) (show-ans a)))

;;; пустой мир — на нём и проверяется закон охвата
(defvar *пустой-склад*) (defvar *пустой-журнал*)
(multiple-value-setq (*пустой-склад* *пустой-журнал*)
  (run-nolang '((witness одинокий "…" :grade строго :f 0.9 :c 0.6 :source (сам))
                (claim вывод (from одинокий)))))

(format t "~&── ПЯТЬ ВОПРОСОВ ОТВЕЧАЮТ ПО СУЩЕСТВУ ──~%")

(check "«на чём стоит X» доходит до молчания в глубине, а не только до первой посылки"
       (search "NO_MORTALITY_PUBLICATIONS"
               (текст (на-чём-стоит *склад* 'PURCHASE_BASIS))))
(check "…и показывает степень с верой на каждом уровне"
       (search "[observational·unavailable]" (текст (на-чём-стоит *склад* 'PURCHASE_BASIS))))
(check "🔴 «что опирается на Y» называет ЦЕНУ отзыва ДО отзыва"
       (let ((s (текст (что-опирается-на *склад* 'COCHRANE2014))))
         (and (search "KNOWN_TODAY" s) (search "заденет 1" s))))
(check "«что осиротело» находит и осиротевшее, и непоправимое"
       (let ((s (текст (что-осиротело *журнал*))))
         (and (search "осиротело" s) (search "НЕПОПРАВИМО" s))))
(check "«где опорное молчание» указывает утверждение И само молчание с причиной"
       (let ((s (текст (где-опорное-молчание *склад*))))
         (and (search "MORTALITY_FALLS" s) (search "публикаций о снижении" s))))
(check "«какие корни повторяются» находит два свода одного корня"
       (let ((s (текст (какие-корни-повторяются *склад*))))
         (and (search "TEN_ROCHE_TRIALS" s)
              (search "EIGHT_ABSTRACTS" s) (search "KAISER2003" s))))

(format t "~&── 🔴 ЗАКОН ОХВАТА: ОН ДЕЙСТВУЕТ И НА ПУСТОМ ОТВЕТЕ ──~%")

(check "охват печатается у КАЖДОГО из пяти ответов"
       (every (lambda (a) (search "⌕ охват:" (текст a)))
              (list (на-чём-стоит *склад* 'PURCHASE_BASIS)
                    (что-опирается-на *склад* 'COCHRANE2014)
                    (что-осиротело *журнал*)
                    (где-опорное-молчание *склад*)
                    (какие-корни-повторяются *склад*))))
(check "🔴 пустой ответ про сирот всё равно говорит, ГДЕ искал"
       (let ((s (текст (что-осиротело *пустой-журнал*))))
         (and (search "сирот нет" s) (search "⌕ охват: журнал:" s))))
(check "🔴 пустой ответ про молчание всё равно говорит, СКОЛЬКО просмотрено"
       (let ((s (текст (где-опорное-молчание *пустой-склад*))))
         (and (search "не опирается на молчание" s) (search "суждений просмотрено" s))))
(check "🔴 пустой ответ про корни объясняет, ПОЧЕМУ пусто"
       (let ((s (текст (какие-корни-повторяются *пустой-склад*))))
         (and (search "повторяющихся корней нет" s)
              (search "ложного усиления через родословную здесь не было" s))))
(check "спрошенное имя, которого в складе нет, — не молчание, а прямой ответ"
       (let ((s (текст (на-чём-стоит *склад* 'выдумка))))
         (and (search "НЕТ В СКЛАДЕ" s) (search "⌕ охват:" s))))
(check "…и про корень сказано, что корни в складе не лежат — вместо пустоты"
       (search "корни в складе не лежат"
               (текст (что-опирается-на *склад* 'TEN_ROCHE_TRIALS))))

(format t "~&── ОТВЕТ ЧЕЛОВЕКУ, А НЕ МАШИНЕ ──~%")

(check "в ответах нет ни фигурных скобок, ни двоеточий-ключей JSON"
       (let ((s (текст (на-чём-стоит *склад* 'PURCHASE_BASIS))))
         (and (not (find #\{ s)) (not (search "\":" s)))))
(check "единый вход печатает и возвращает структуру"
       (let ((a (with-output-to-string (*standard-output*)
                  (ask-store *склад* *журнал* :корни))))
         (search "? какие корни повторяются" a)))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
