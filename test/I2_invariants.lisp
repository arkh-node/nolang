;;;; test/I2_invariants.lisp — ВТОРАЯ ОПОРА для мест, которые держались на одной проверке.
;;;;
;;;; 🔴 ПОВОД. Мутационный стенд (`test/mutants.sh`, 06.08.2026) показал: девять порч несущих
;;;; мест ловятся все, дыр нет — но ТРИ из них ловит РОВНО ОДНА проверка:
;;;;   · потолок источника        → только `B1_source_ceiling.sh`
;;;;   · схлопнутый интервал      → только `C1_credal.sh`
;;;;   · завышенная сила якоря    → только `D6_anchor.sh`
;;;; Это не дыра, а ОДИНОЧНАЯ ОПОРА. Сломайся та батарея — или окажись зелёной по неверной
;;;; причине (за одни сутки такое случилось дважды) — и порча пройдёт молча.
;;;;
;;;; 🔴 ПОЧЕМУ ВТОРАЯ ПРОВЕРКА СДЕЛАНА ИНАЧЕ, А НЕ СКОПИРОВАНА.
;;;; Копия ловит ровно то же и падает от того же — две одинаковые опоры не прочнее одной.
;;;; Это тот же закон, по которому дифф-тест не сверяют с самим собой (свод контура, 8.20).
;;;; Существующие батареи проверяют КОНКРЕТНЫЕ СЛУЧАИ, разобранные руками. Здесь проверяются
;;;; ИНВАРИАНТЫ — на массе входов, включая перебор всей области там, где она конечна.
;;;; Способ другой, значит и слепые пятна другие.
;;;;
;;;; ⚠️ Чего эти проверки НЕ дают: они не доказывают инварианты, а испытывают их на выборке.
;;;; Доказаны они в Agda (`SourceCeiling`, `CredalBound`) — здесь проверяется, что ЛИСП ведёт
;;;; себя так же, а это, как всегда, ограничено числом испытаний.

(load (merge-pathnames "../src/nolang.lisp" *load-pathname*))
(load (merge-pathnames "../src/anchor.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form)
  `(progn (assert ,form () "FAIL: ~a" ,label) (incf *n*) (format t "  ✓ ~a~%" ,label)))

(defun rnd (n) (random n))

;;; ── 1. ПОТОЛОК ИСТОЧНИКА: степень свидетеля НИКОГДА не выше класса источника ──────────
;;; Вторая опора к `B1_source_ceiling.sh`. Там — разобранные случаи; здесь — масса программ,
;;; собранных случайно, и утверждение проверяется на КАЖДОЙ.
(format t "~&── 1. ПОТОЛОК ПРОИСХОЖДЕНИЯ (вторая опора) ──~%")

;;; ⚠️ ПЕРВАЯ РЕДАКЦИЯ ЭТОЙ ПРОВЕРКИ БЫЛА ПУСТОЙ, и поймал её контроль, стоящий ниже.
;;; Я смотрел на СТЕПЕНЬ ВЫВОДА и требовал, чтобы она не превышала класс источника. Но потолок
;;; в nolang срабатывает НЕ ТАК: программа с завышенным свидетелем просто НЕ ТИПИЗИРУЕТСЯ,
;;; `grade-of` возвращает NIL, а потолок проявляется диагностикой `:grade`. Проверка «ноль
;;; нарушений» была зелёной на 300 программах, ни одну из них не проверив.
;;; Правильный инвариант — двусторонний: завышение ОБЯЗАНО дать ошибку, а честное объявление
;;; обязано пройти. Односторонняя проверка («нет нарушений») зелена и у языка, который
;;; отвергает всё подряд.
(let ((всего 0) (пропущено-завышение 0) (зря-отвергнуто 0) (завышений 0) (честных 0))
  (dotimes (i 300)
    (let* ((классы '("unavailable" "abstract" "published" "full_report"))
           (i-ист (rnd 4)) (i-свид (rnd 4))
           (кл-ист (nth i-ист классы)) (кл-свид (nth i-свид классы))
           (текст (format nil "lattice transmission = unavailable < abstract < published < full_report
source S : ~a
witness W : ~a
  says \"…\"
  source S
  evidence 5 for 0 against
claim c from W" кл-ист кл-свид)))
      (with-prelude
        (multiple-value-bind (env errs) (check-program (parse текст))
          (declare (ignore env))
          (incf всего)
          (let ((есть-grade (find :grade errs :key #'terr-code)))
            (cond
              ((> i-свид i-ист)                     ; свидетель объявлен ВЫШЕ источника
               (incf завышений)
               (unless есть-grade (incf пропущено-завышение)))
              (t                                    ; честное объявление
               (incf честных)
               (when есть-grade (incf зря-отвергнуто)))))))))
  (check "завышение степени над классом источника ловится ВСЕГДА (300 программ)"
         (= 0 пропущено-завышение))
  (check "…и честное объявление НИКОГДА не отвергается (потолок не затыкает правду)"
         (= 0 зря-отвергнуто))
  (format t "      [программ: ~a · с завышением: ~a · честных: ~a]~%" всего завышений честных)
  ;; 🔴 КОНТРОЛЬ ПРОТИВ ЛОЖНОГО СТОРОЖА (свод, 8.18): обе стороны обязаны встретиться в
  ;; выборке, иначе одна из проверок зелена от того, что ей нечего было проверять.
  (check "…и в выборке были ОБЕ стороны (иначе одна из проверок пуста)"
         (and (> завышений 20) (> честных 20))))

;;; ── 2. КРЕДАЛЬНАЯ ГРАНИЦА: отрезок никогда не схлопывается ────────────────────────────
;;; Вторая опора к `C1_credal.sh`. Проверяются СВОЙСТВА на массе весов, а не разобранные числа.
(format t "~&── 2. КРЕДАЛЬНАЯ ГРАНИЦА (вторая опора) ──~%")

(let ((всего 0) (плохих 0) (шире 0))
  (dotimes (i 500)
    (let* ((w+ (rnd 200)) (w- (rnd 200)) (k (1+ (rnd 8))))
      (multiple-value-bind (lo hi width) (belief-interval w+ w- k)
        (incf всего)
        ;; низ ≤ верх · ширина строго положительна · ширина = k/(w+k) · низ = belief
        (unless (and (<= lo hi)
                     (> width 0)
                     (= width (/ k (+ w+ w- k)))
                     (= lo (/ w+ (+ w+ w- k))))
          (incf плохих))
        (when (> width 1/100) (incf шире)))))
  (check "на 500 наборах весов: низ ≤ верх, ширина > 0, ширина = k/(w+k), низ = belief"
         (= 0 плохих))
  (format t "      [наборов: ~a · с заметной шириной: ~a]~%" всего шире)
  (check "…и отрезок бывал ЗАМЕТНО широким (иначе схлопнутая граница прошла бы)"
         (> шире 100)))

;; Монотонность: свидетельство «за» не может опустить нижнюю границу.
(let ((плохих 0))
  (dotimes (i 200)
    (let* ((w+ (rnd 100)) (w- (rnd 100)) (k (1+ (rnd 5))))
      (multiple-value-bind (lo0) (belief-interval w+ w- k)
        (multiple-value-bind (lo1) (belief-interval (1+ w+) w- k)
          (when (< lo1 lo0) (incf плохих))))))
  (check "свидетельство «за» никогда не опускает нижнюю границу (200 наборов)" (= 0 плохих)))

;;; ── 3. СИЛА ЯКОРЯ: не выше того, что даёт канал ───────────────────────────────────────
;;; Вторая опора к `D6_anchor.sh`. Там — разобранные случаи; здесь ПОЛНЫЙ ПЕРЕБОР области:
;;; все каналы × все объявления. Область конечна, значит проверка исчерпывающа, а не выборочна.
(format t "~&── 3. СИЛА ЯКОРЯ (вторая опора, полный перебор) ──~%")

(let ((каналы (mapcar #'car *channel-classes*))
      (нарушений 0) (пар 0) (понижений 0))
  (dolist (ch каналы)
    (let ((предел (cdr (assoc ch *channel-classes*))))
      (dolist (объявлено (cons nil *anchor-classes*))
        (incf пар)
        (multiple-value-bind (факт понижен) (anchor-class ch объявлено)
          ;; действительная сила НИКОГДА не выше предела канала
          (unless (anchor-class<= факт предел) (incf нарушений))
          ;; объявление выше предела обязано быть понижено И помечено
          (when (and объявлено (not (anchor-class<= объявлено предел)))
            (if (and (eq факт предел) понижен)
                (incf понижений)
                (incf нарушений)))))))
  (check "полный перебор каналов × объявлений: сила НИКОГДА не выше предела канала"
         (= 0 нарушений))
  (format t "      [пар канал×объявление: ~a · понижений: ~a]~%" пар понижений)
  (check "…и понижения ДЕЙСТВИТЕЛЬНО случались (иначе перебор ничего не проверил)"
         (> понижений 0)))


;;; ── 4. КАЛИБРОВКА ЗНАЕТ, ЧЕГО ОНА СТОИТ (клетка C1) ──────────────────────────
;;; 🔴 Проверяется не «умеет ли тревожить», а РАЗЛИЧАЕТ ли. Сторож, кричащий всегда,
;;; бесполезен ровно так же, как молчащий всегда: ни тот ни другой не несёт сведений.
(load (merge-pathnames "../src/theta.lisp" *load-pathname*))
(format t "~&── 4. ДОВЕРИЕ К КАЛИБРОВКЕ (клетка C1) ──~%")

(defun флаги (своих чужих)
  (append (make-list своих :initial-element t) (make-list чужих :initial-element nil)))

;; Тот самый состав, на котором замер 06.08 дал утечку 99.5%: своих 20 из 200.
(check "состав 20/200 (утечка была 99.5%) — калибровке НЕ доверять"
       (eq :не-доверять (calibration-trust (флаги 20 180))))

;; И обратное: здоровый состав обязан пройти, иначе признак кричит всегда.
(check "…а состав 180/200 — доверять (иначе сторож кричит всегда)"
       (eq :доверять (calibration-trust (флаги 180 20))))

(check "промежуточный 60/200 — под сомнением, а не крайность"
       (eq :под-сомнением (calibration-trust (флаги 60 140))))

(check "пустая калибровка названа пустой, а не молчаливо доверенной"
       (eq :пусто (calibration-trust '())))

;; 🔴 Порог и приговор больше НЕЛЬЗЯ получить порознь.
(multiple-value-bind (θ доверие причина) (theta-guarded '(0.3 0.5 0.7) (флаги 20 180) 0.1)
  (check "theta-guarded отдаёт порог И приговор о нём одним вызовом"
         (and (numberp θ) (eq доверие :не-доверять) (stringp причина))))

;; Контроль против ложного сторожа: на здоровой калибровке тот же вызов молчит о беде.
(multiple-value-bind (θ доверие) (theta-guarded '(0.3 0.5 0.7) (флаги 180 20) 0.1)
  (check "…и на здоровой калибровке тот же вызов даёт :доверять"
         (and (numberp θ) (eq доверие :доверять))))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
