;;;; test/95_roots.lisp — ЗАВИСИМЫЕ СВИДЕТЕЛИ: сумма по КОРНЯМ, а не по документам.
;;;; Run: sbcl --script test/95_roots.lisp
;;;;
;;;; ПОВОД (Невис, §6 записки 28.07): `⊕` складывает как независимые. Два документа, восходящих
;;;; к одному источнику, дают ложное усиление — то же отмывание, только через родословную.
;;;; Дисциплина тождества ловит буквальный повтор, но НЕ общего предка.
;;;;
;;;; 🔴 ЕЁ СОВЕТ: менять НОСИТЕЛЬ, а не операцию. Не «умножить на поправку», а считать по
;;;; корням: публикация и препринт об ОДНОМ испытании складываются один раз ПО ПОСТРОЕНИЮ,
;;;; а не по бдительности автора. Группа сворачивается в представителя с наибольшим весом —
;;;; лучше сохранившийся документ и есть твой лучший доступ к первоисточнику.
;;;;
;;;; Данные здесь нарочно нейтральные (испытания и отчёты о них): тот же случай, что в
;;;; `examples/pharmacology.nol`, где два канала одного корня — публикация и тезисы.
(load (merge-pathnames "../src/reduce.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))
(defun ~= (a b &optional (eps 1e-4)) (< (abs (- a b)) eps))
(defun out-of (forms)
  (multiple-value-bind (st lg) (run-nolang forms)
    (with-output-to-string (*standard-output*) (show-run st lg))))

(format t "~&── ЛОЖНОЕ УСИЛЕНИЕ УБРАНО ──~%")

(defparameter *одна*
  '((witness публикация "…" :grade строго :f 0.9 :c 0.6 :source (испытание-а))
    (claim польза (from публикация))))
(defparameter *две-копии*
  '((witness публикация "…" :grade строго :f 0.9 :c 0.6 :source (испытание-а))
    (witness препринт   "…" :grade строго :f 0.9 :c 0.6 :source (испытание-а))
    (claim польза (from публикация препринт))))
(defparameter *два-корня*
  '((witness публикация "…" :grade строго :f 0.9 :c 0.6 :source (испытание-а))
    (witness отчёт-б    "…" :grade строго :f 0.9 :c 0.6 :source (испытание-б))
    (claim польза (from публикация отчёт-б))))

(check "два документа ОДНОГО корня дают ровно то же, что один"
       (~= (belief-at-runtime *две-копии* 'польза) (belief-at-runtime *одна* 'польза)))
(check "🔴 а два РАЗНЫХ корня усиливают, как и должно"
       (> (belief-at-runtime *два-корня* 'польза) (belief-at-runtime *одна* 'польза)))
(check "тест не пустой: разница между случаями существенна"
       (> (- (belief-at-runtime *два-корня* 'польза) (belief-at-runtime *две-копии* 'польза))
          0.1))

(format t "~&── ГРУППА СВОРАЧИВАЕТСЯ В ЛУЧШЕГО ПО ВЕСУ ──~%")

(check "из двух документов учтён тот, у кого больше веса"
       (let ((слабее-первая
              '((witness слабый  "…" :grade строго :f 0.9 :c 0.3 :source (испытание-а))
                (witness сильный "…" :grade строго :f 0.9 :c 0.7 :source (испытание-а))
                (claim c (from слабый сильный))))
             (только-сильная
              '((witness сильный "…" :grade строго :f 0.9 :c 0.7 :source (испытание-а))
                (claim c (from сильный)))))
         (~= (belief-at-runtime слабее-первая 'c)
             (belief-at-runtime только-сильная 'c))))

(check "порядок в списке посылок не меняет, кого выбрали"
       (let ((прямо '((witness a "…" :grade строго :f 0.9 :c 0.3 :source (r))
                      (witness b "…" :grade строго :f 0.9 :c 0.7 :source (r))
                      (claim c (from a b))))
             (наоборот '((witness a "…" :grade строго :f 0.9 :c 0.3 :source (r))
                         (witness b "…" :grade строго :f 0.9 :c 0.7 :source (r))
                         (claim c (from b a)))))
         (~= (belief-at-runtime прямо 'c) (belief-at-runtime наоборот 'c))))

(format t "~&── ПОГЛОЩЕНИЕ ВИДНО (поглощено ≠ показано) ──~%")

(let ((o (out-of *две-копии*)))
  (check "сказано, что документ ПОГЛОЩЁН, и назван корень"
         (and (search "поглощён как копия корня" o) (search "ИСПЫТАНИЕ-А" o)))
  (check "назван тот, кого учли вместо него" (search "учтён ПУБЛИКАЦИЯ" o)))

(let ((o (out-of *два-корня*)))
  (check "при разных корнях сказано, что вес считан по корням"
         (search "вес считан по корням" o))
  (check "…и корней названо два" (search "корней: 2" o)))

(format t "~&── 🔴 РАСХОЖДЕНИЕ В КОРНЕ НЕ ПРЯЧЕТСЯ ──~%")

;;; Если «копии» говорят разное — это не копии одного свидетельства, а спорная передача.
;;; Свернуть их молча значило бы скрыть спор.
(let ((o (out-of '((witness а "…" :grade строго :f 0.95 :c 0.6 :source (спорный))
                   (witness б "…" :grade строго :f 0.20 :c 0.6 :source (спорный))
                   (claim в (from а б))))))
  (check "расхождение внутри корня объявлено" (search "РАСХОЖДЕНИЕ в корне" o))
  (check "названы обе разошедшиеся копии" (and (search "А, Б" o) (search "СПОРНЫЙ" o)))
  (check "сказано, что это спорная передача, а не копии" (search "спорная передача" o)))

(let ((o (out-of *две-копии*)))
  (check "согласные копии расхождением НЕ помечаются (тест умеет падать)"
         (not (search "РАСХОЖДЕНИЕ" o))))

(format t "~&── ОТЗЫВ КОРНЯ СНИМАЕТ ПОТОМКОВ САМ ──~%")

;;; Побочная выгода носителя, названная Невис: отдельного правила не нужно.
(check "отзыв источника обнуляет основание всех его свидетелей"
       (eq :silence (grade-at-runtime
                     (append *две-копии*
                             '((retract испытание-а :reason "данные испытания отозваны")))
                     'польза)))
(check "…и вера падает в ноль, потому что база опустела"
       (~= 0.0 (belief-at-runtime
                (append *две-копии* '((retract испытание-а :reason "отозвано"))) 'польза)))
(check "отзыв корня НЕ трогает свидетелей другого корня"
       (let ((p (append *два-корня* '((retract испытание-а :reason "отозвано")))))
         (and (eq :strogo (grade-at-runtime p 'польза))
              (~= (belief-at-runtime p 'польза)
                  (belief-at-runtime '((witness отчёт-б "…" :grade строго :f 0.9 :c 0.6
                                        :source (испытание-б))
                                       (claim польза (from отчёт-б))) 'польза)))))
(check "отзыв корня проходит проверку типов (корень — законная цель отзыва)"
       (null (remove :runtime
                     (errors-of (append *две-копии*
                                        '((retract испытание-а :reason "отозвано")))))))
(check "отзыв вовсе неизвестного имени по-прежнему ошибка"
       (member :unknown (errors-of (append *две-копии*
                                           '((retract никогда-не-было :reason "…"))))))

(format t "~&── БЕЗ ИСТОЧНИКА СВИДЕТЕЛЬ САМ СЕБЕ КОРЕНЬ ──~%")

(check "два свидетеля без источников усиливают друг друга, как раньше"
       (let ((два '((witness a "…" :grade строго :f 0.9 :c 0.6)
                    (witness b "…" :grade строго :f 0.9 :c 0.6)
                    (claim c (from a b))))
             (один '((witness a "…" :grade строго :f 0.9 :c 0.6)
                     (claim c (from a)))))
         (> (belief-at-runtime два 'c) (belief-at-runtime один 'c))))

(format t "~&── ЗДРАВОСТЬ ДЕРЖИТСЯ: статика = прогон и на корнях ──~%")

;;; Проверяющий и машина считают корни РАЗНЫМИ путями (см. шапку common.lisp).
;;; Здесь они обязаны сойтись — иначе дифференциальность поймала бы расхождение.
(let ((ok t) (общих 0) (разных 0))
  (dotimes (i 200)
    (let* ((k (+ 2 (random 3)))
           (ws (loop for j from 1 to k collect (intern (format nil "W~a-~a" i j))))
           ;; 1/3 на общий корень: при 1/2 ветвь «все корни разные» вырождалась.
           ;; 🔴 Прикидка вероятности вне теста НЕ годится: random в SBCL детерминирован,
           ;; а между жеребьёвками корней потребляются числа на f/c — последовательность
           ;; сдвигается. Мерить надо в том же контексте, где утверждаешь.
           (корни (loop repeat k collect (if (zerop (random 3)) 'общий
                                             (intern (format nil "R~a-~a" i (random 3))))))
           (forms (loop for w in ws for r in корни
                        collect `(witness ,w "…" :grade строго
                                  :f ,(+ 0.55 (random 0.4)) :c ,(+ 0.1 (random 0.8))
                                  :source (,r))))
           (cid (intern (format nil "C~a" i)))
           (prog* (append forms `((claim ,cid (from ,@ws))))))
      (if (member 'общий корни) (incf общих) (incf разных))
      (unless (eq (grade-of prog* cid) (grade-at-runtime prog* cid)) (setf ok nil))))
  (check "200 случайных программ с общими корнями: статика = прогон" ok)
  (check "…и обе ветви встретились (счётом в этом же прогоне)"
         (progn (format t "      [общих корней: ~a · все разные: ~a]~%" общих разных)
                (and (> общих 20) (> разных 20)))))

(format t "~&~%── как это выглядит ──~%~a" (out-of *два-корня*))

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
