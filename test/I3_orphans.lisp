;;;; test/I3_orphans.lisp — ТРИ СЦЕНАРИЯ ОСИРОТЕНИЯ, различимые СЛОВАМИ.
;;;; Run: sbcl --script test/I3_orphans.lisp
;;;;
;;;; ПОВОД (наказ Невис, I3): отзыв корня под необратимым действием, под обратимым и под
;;;; ещё НЕ совершённым. «Готово, когда три журнала напечатаны и различаются СЛОВАМИ,
;;;; а не только числами.»
;;;;
;;;; 🔴 ПОЧЕМУ ИМЕННО СЛОВАМИ. Числа у всех трёх случаев похожи: вера упала ниже порога.
;;;; Если журнал различает их только числом, читателю придётся ДОГАДЫВАТЬСЯ, что произошло, —
;;;; а язык, чей тезис «нечестность невыразима», не должен рассчитывать на догадливого
;;;; читателя. Три разных события обязаны читаться как три разных события.
;;;;
;;;; Формальная опора — `formal/Act.agda` (Невис, 29.07): `live≢orphaned`,
;;;; `orphaned≢irreparable`, `live≢irreparable` — три статуса РАЗЛИЧНЫ В ТИПЕ. Здесь
;;;; проверяется, что различие дошло до печати, а не осталось в доказательстве.
(load (merge-pathnames "../src/nolang.lisp" *load-pathname*))

(defvar *n* 0)
(defmacro check (label form) `(progn (assert ,form () "FAIL: ~a" ,label)
                                     (incf *n*) (format t "  ✓ ~a~%" ,label)))

(defun журнал (forms)
  (with-output-to-string (*standard-output*) (show-ledger (nth-value 1 (run-nolang forms)))))

;;; общее основание у всех трёх: два корня, один из них отзывается
(defparameter *основа*
  '((witness первый "…" :grade строго :f 0.9 :c 0.6 :source (r1))
    (witness второй "…" :grade строго :f 0.9 :c 0.6 :source (r2))
    (claim осн :grade строго (from первый второй))))

;;; 1. отзыв под НЕОБРАТИМЫМ, уже совершённым
(defparameter *под-необратимым*
  (append *основа*
          '((action шаг :reversibility irreversible :needs-grade строго
                    :requires (>= belief 0.6) :else fold)
            (do шаг осн)
            (retract r1 :reason "источник отозван"))))

;;; 2. отзыв под ВОЗМЕСТИМЫМ, уже совершённым
(defparameter *под-возместимым*
  (append *основа*
          '((action отмена :reversibility reversible :requires (>= belief 0.1) :else fold)
            (action шаг :reversibility compensable :requires (>= belief 0.6)
                    :else fold :compensated-by отмена)
            (do шаг осн)
            (retract r1 :reason "источник отозван"))))

;;; 3. отзыв под ЕЩЁ НЕ СОВЕРШЁННЫМ — действие объявлено, но `do` идёт ПОСЛЕ отзыва
(defparameter *под-несовершённым*
  (append *основа*
          '((action шаг :reversibility irreversible :needs-grade строго
                    :requires (>= belief 0.6) :else fold)
            (retract r1 :reason "источник отозван")
            (do шаг осн))))

(defparameter *ж1* (журнал *под-необратимым*))
(defparameter *ж2* (журнал *под-возместимым*))
(defparameter *ж3* (журнал *под-несовершённым*))

(format t "~&── ТРИ ЖУРНАЛА РАЗЛИЧАЮТСЯ СЛОВАМИ ──~%")

(check "1/3 под НЕОБРАТИМЫМ: сказано «осиротело» И «непоправимо»"
       (and (search "ОСИРОТЕЛО" *ж1*) (search "НЕПОПРАВИМО" *ж1*)))
(check "…и названа причина, по которой возмещения не будет"
       (search "Возместить нечем" *ж1*))
(check "2/3 под ВОЗМЕСТИМЫМ: сказано «осиротело» и «возмещение», но НЕ «непоправимо»"
       (and (search "ОСИРОТЕЛО" *ж2*) (search "ВОЗМЕЩЕНИЕ" *ж2*)
            (not (search "НЕПОПРАВИМО" *ж2*))))
(check "…и возмещение прошло СВОЙ порог, а не порог упавшего действия"
       (search "его порог 0.100" *ж2*))
(check "🔴 3/3 под ЕЩЁ НЕ СОВЕРШЁННЫМ: не «осиротело», а СВЁРНУТО — сирота не родился"
       (and (search "свёрнуто" *ж3*)
            (not (search "ОСИРОТЕЛО" *ж3*))
            (not (search "НЕПОПРАВИМО" *ж3*))))
(check "…и у свёртка названа НЕДОСТАЧА — заказ на работу, а не приговор"
       (search "не хватило" *ж3*))

(format t "~&── РАЗЛИЧИЕ НЕ СВОДИТСЯ К ЧИСЛАМ ──~%")
;;; 🔴 Главная проверка файла: у всех трёх вера падает ОДИНАКОВО. Если бы журнал различал
;;; их числом, три события были бы неразличимы. Значит различие обязано жить в словах.
(check "🔴 у всех трёх вера после отзыва ОДНА И ТА ЖЕ — числом их не различить"
       (let ((b (mapcar (lambda (p) (belief-at-runtime p 'осн))
                        (list *под-необратимым* *под-возместимым* *под-несовершённым*))))
         (and (< (abs (- (first b) (second b))) 1e-9)
              (< (abs (- (second b) (third b))) 1e-9))))
(check "…и порог у всех трёх тоже один"
       (every (lambda (ж) (search "0.600" ж)) (list *ж1* *ж2* *ж3*)))
(check "🔴 но тексты журналов ПОПАРНО различны"
       (and (string/= *ж1* *ж2*) (string/= *ж2* *ж3*) (string/= *ж1* *ж3*)))
(check "…и различны именно словами события, а не порядком строк"
       (let ((слова (lambda (ж) (sort (remove-if-not
                                       (lambda (w) (find w '("ОСИРОТЕЛО" "НЕПОПРАВИМО"
                                                             "ВОЗМЕЩЕНИЕ" "свёрнуто" "совершено")
                                                         :test #'string=))
                                       (list "ОСИРОТЕЛО" "НЕПОПРАВИМО" "ВОЗМЕЩЕНИЕ"
                                             "свёрнуто" "совершено")
                                       :key (lambda (w) (if (search w ж) w "")))
                                      #'string<))))
         (and (not (equal (funcall слова *ж1*) (funcall слова *ж2*)))
              (not (equal (funcall слова *ж2*) (funcall слова *ж3*))))))

(format t "~&── ОТЗЫВ МОНОТОНЕН: осиротевшее не воскресает ──~%")
;;; `no-resurrection` / `orphan-stays` из `formal/Act.agda`: сколько свидетельств ни принеси
;;; ПОСЛЕ отзыва, осиротевшее действие остаётся осиротевшим. Здесь это предъявлено прогоном.
(defparameter *с-подкреплением-после*
  (append *под-необратимым*
          '((witness поздний "…" :grade строго :f 0.99 :c 0.99 :source (r3))
            (claim осн2 :grade строго (from поздний)))))

(check "🔴 свидетельство, принесённое ПОСЛЕ отзыва, не воскрешает сироту"
       (let ((ж (журнал *с-подкреплением-после*)))
         (and (search "ОСИРОТЕЛО" ж) (search "НЕПОПРАВИМО" ж))))
(check "…хотя вера нового утверждения заведомо выше порога"
       (> (belief-at-runtime *с-подкреплением-после* 'осн2) 0.6))
(check "журнал ДОПИСЫВАЕТСЯ: запись о совершении не стёрта отзывом"
       (search "совершено" *ж1*))

(format t "~&~%── 1. под НЕОБРАТИМЫМ ──~%~a" *ж1*)
(format t "~&── 2. под ВОЗМЕСТИМЫМ ──~%~a" *ж2*)
(format t "~&── 3. под ЕЩЁ НЕ СОВЕРШЁННЫМ ──~%~a" *ж3*)

(format t "~%── ALL GREEN · проверок: ~a ──~%" *n*)
