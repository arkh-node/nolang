-- ============================================================
--  nolang · ПРЕДСТАВИТЕЛЬ КОРНЯ: какой вес несёт группа копий
--
--  ЗАЧЕМ (Тарантога, 29.07.2026, «чего мне не хватает», пункт 1).
--   Он поймал место, которое я честно назвала параметром — и была права о МОДЕЛИ,
--   но в реализации выбор сделан и он не произволен:
--       «корень несёт вес ТЯЖЕЛЕЙШЕГО своего свидетеля»
--       (лучше сохранившаяся копия и есть твой лучший доступ к оригиналу).
--   Решение жило только в `red-claim`/`chk-claim` и в комментарии: не доказано,
--   не смоделировано, не проверено на монотонность. А оно решает, сколько веры
--   даёт группа копий, — то есть стоит ровно на пути у гейта.
--   Его вопрос был поставлен точно: «я хочу знать, что здесь земля, а что доски».
--
--  ОТВЕТ: это ЗЕМЛЯ, и вот её границы.
--   Представитель — не свободная константа: два требования, которые он обязан
--   выполнять, вместе отсекают и «сложить копии», и «взять слабейшую».
--   Но выбор ИМЕННО максимума — содержательное решение о мире (какая копия
--   ближе к оригиналу), и оно остаётся объявлением, а не теоремой. Доказано то,
--   что максимум этим требованиям удовлетворяет, а сумма и минимум — нет.
--
--  ЧТО ДОКАЗАНО:
--   1. rep-single  : группа из одной копии = сама копия
--   2. 🔴 rep-mono   : ещё одна копия того же корня НЕ ПОНИЖАЕТ вес группы
--   3. 🔴 rep-bounded: вес группы НЕ БОЛЬШЕ, чем если бы копии были независимы
--   4. 🔴 rep-idem   : две одинаковые копии дают ровно одну — повтор не есть
--      подтверждение. Это то самое место, где `rep` расходится с `⊕`.
--   5. sum-not-rep : СУММА нарушает (4) — доказано контрпримером, не сказано словом
--   6. min-not-mono: МИНИМУМ нарушает (2) — тоже контрпримером
--
--  ЧЕГО ЗДЕСЬ НЕТ:
--   • ничего о том, КАКАЯ копия тяжелее в реальном корпусе — это данные, не модель;
--   • ничего о `k` (горизонт) — он живёт в `BeliefMass`, и он отдельный долг;
--   • ничего о степени и решётке — это `Preservation`.
--
--  Самодостаточен: без stdlib. Проверяется под --safe.
--  — Невис, 29.07.2026
-- ============================================================

module Representative where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc; _+_)
open import Agda.Builtin.List using (List; []; _∷_)

-- ------------------------------------------------------------
-- 0. Вспомогательное
-- ------------------------------------------------------------

data Empty : Set where

¬_ : Set → Set
¬ A = A → Empty

cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

data _≤_ : Nat → Nat → Set where
  z≤n : ∀ {n}           → zero  ≤ n
  s≤s : ∀ {m n} → m ≤ n → suc m ≤ suc n

≤-refl : ∀ n → n ≤ n
≤-refl zero    = z≤n
≤-refl (suc n) = s≤s (≤-refl n)

≤-step : ∀ {m n} → m ≤ n → m ≤ suc n
≤-step z≤n     = z≤n
≤-step (s≤s p) = s≤s (≤-step p)

≤-trans : ∀ {a b c} → a ≤ b → b ≤ c → a ≤ c
≤-trans z≤n     _       = z≤n
≤-trans (s≤s p) (s≤s q) = s≤s (≤-trans p q)

-- сложение не уменьшает: a ≤ a + b
≤-plusʳ : ∀ a b → a ≤ (a + b)
≤-plusʳ zero    b = z≤n
≤-plusʳ (suc a) b = s≤s (≤-plusʳ a b)

≤-plusˡ : ∀ a b → a ≤ (b + a)
≤-plusˡ a zero    = ≤-refl a
≤-plusˡ a (suc b) = ≤-step (≤-plusˡ a b)

max : Nat → Nat → Nat
max zero    n       = n
max (suc m) zero    = suc m
max (suc m) (suc n) = suc (max m n)

max-idem : ∀ n → max n n ≡ n
max-idem zero    = refl
max-idem (suc n) = cong suc (max-idem n)

max-≤ʳ : ∀ m n → n ≤ max m n
max-≤ʳ zero    n       = ≤-refl n
max-≤ʳ (suc m) zero    = z≤n
max-≤ʳ (suc m) (suc n) = s≤s (max-≤ʳ m n)

max-≤ˡ : ∀ m n → m ≤ max m n
max-≤ˡ zero    n       = z≤n
max-≤ˡ (suc m) zero    = ≤-refl (suc m)
max-≤ˡ (suc m) (suc n) = s≤s (max-≤ˡ m n)

max-lub : ∀ {m n b} → m ≤ b → n ≤ b → max m n ≤ b
max-lub {zero}  {n}     p q = q
max-lub {suc m} {zero}  p q = p
max-lub {suc m} {suc n} (s≤s p) (s≤s q) = s≤s (max-lub p q)

-- ------------------------------------------------------------
-- 1. Свидетель и группа копий одного корня
-- ------------------------------------------------------------

-- Носитель тот же, что в BeliefMass: пара весов «за / против».
record E : Set where
  constructor ev
  field
    w⁺ : Nat
    w⁻ : Nat

open E

-- Группа копий ОДНОГО корня. Не путать с независимыми свидетелями:
-- у них разные корни, и они складываются через ⊕ (BeliefMass).
Copies : Set
Copies = List E

-- ------------------------------------------------------------
-- 2. Три кандидата в представители
-- ------------------------------------------------------------

-- (а) ТЯЖЕЛЕЙШАЯ копия — выбор реализации Тарантоги
rep : Copies → Nat
rep []       = 0
rep (x ∷ xs) = max (w⁺ x) (rep xs)

-- (б) СУММА — «копии складываются», то есть повтор считается подтверждением
sum⁺ : Copies → Nat
sum⁺ []       = 0
sum⁺ (x ∷ xs) = w⁺ x + sum⁺ xs

-- (в) СЛАБЕЙШАЯ копия (для полноты разбора)
minrep : Copies → Nat
minrep []           = 0
minrep (x ∷ [])     = w⁺ x
minrep (x ∷ y ∷ xs) = mn (w⁺ x) (minrep (y ∷ xs))
  where
    mn : Nat → Nat → Nat
    mn zero    _       = zero
    mn (suc a) zero    = zero
    mn (suc a) (suc b) = suc (mn a b)

-- ------------------------------------------------------------
-- 3. ТРЕБОВАНИЯ К ПРЕДСТАВИТЕЛЮ (то, чего просил Тарантога)
-- ------------------------------------------------------------

-- ТЕОРЕМА 1. Группа из одной копии есть сама копия.
rep-single : ∀ (x : E) → rep (x ∷ []) ≡ w⁺ x
rep-single x = help (w⁺ x)
  where
    help : ∀ n → max n 0 ≡ n
    help zero    = refl
    help (suc n) = refl

-- 🔴 ТЕОРЕМА 2 (rep-mono). Ещё одна копия того же корня НЕ ПОНИЖАЕТ вес группы.
--    Это его первое требование, дословно.
rep-mono : ∀ (x : E) (xs : Copies) → rep xs ≤ rep (x ∷ xs)
rep-mono x xs = max-≤ʳ (w⁺ x) (rep xs)

-- 🔴 ТЕОРЕМА 3 (rep-bounded). Вес группы НЕ БОЛЬШЕ, чем если бы копии были
--    независимы. Второе его требование: группа копий не может дать больше веры,
--    чем столько же независимых свидетельств.
rep-bounded : ∀ (xs : Copies) → rep xs ≤ sum⁺ xs
rep-bounded []       = z≤n
rep-bounded (x ∷ xs) =
  max-lub (≤-plusʳ (w⁺ x) (sum⁺ xs))
          (≤-trans (rep-bounded xs) (≤-plusˡ (sum⁺ xs) (w⁺ x)))

-- 🔴 ТЕОРЕМА 4 (rep-idem). Две ОДИНАКОВЫЕ копии дают ровно одну.
--    Повтор не есть подтверждение — то самое место, где представитель обязан
--    расходиться с ⊕ из BeliefMass (там вера накапливается, и это верно для
--    НЕЗАВИСИМЫХ свидетельств; здесь копии одного корня, и накопление было бы
--    отмыванием через размножение).
rep-idem : ∀ (x : E) → rep (x ∷ x ∷ []) ≡ rep (x ∷ [])
rep-idem x = help (w⁺ x)
  where
    help : ∀ n → max n (max n 0) ≡ max n 0
    help zero    = refl
    help (suc n) = cong suc (max-idem n)

-- ------------------------------------------------------------
-- 4. ПОЧЕМУ НЕ ДРУГИЕ — контрпримерами, а не словами
-- ------------------------------------------------------------

private
  one : E
  one = ev 1 0

-- 🔴 СУММА нарушает идемпотентность: две копии одного свидетеля дали бы вдвое
--    больше веры. Это и есть «повтор как подтверждение» — ровно то, против чего
--    заведён язык.
sum-not-idem : ¬ (sum⁺ (one ∷ one ∷ []) ≡ sum⁺ (one ∷ []))
sum-not-idem ()

-- 🔴 МИНИМУМ нарушает монотонность: добавление ХУДШЕЙ копии понизило бы вес
--    группы, то есть найти ещё один плохой список значило бы ослабить основание.
min-not-mono : ¬ (minrep (one ∷ []) ≤ minrep (ev 0 0 ∷ one ∷ []))
min-not-mono ()

-- ------------------------------------------------------------
-- 5. ГРАНИЦА ЧЕСТНОСТИ (то, что остаётся объявлением, а не теоремой)
-- ------------------------------------------------------------
--
--  Доказано: максимум удовлетворяет всем четырём требованиям, сумма и минимум —
--  нет. Значит выбор «тяжелейшая копия» НЕ произволен: он вынужден требованиями.
--
--  НЕ доказано и доказано быть не может: что «тяжелее» означает «ближе к
--  оригиналу». Это утверждение о МИРЕ (о том, как сохраняются копии), а не о
--  модели. Оно остаётся объявлением языка и должно быть названо в `ТИПЫ` именно
--  так — свободным допущением с именем, а не молчаливой очевидностью.
--
--  Разница между землёй и досками здесь проходит ровно тут:
--    земля  — «представитель обязан быть монотонным, ограниченным и идемпотентным»;
--    доски  — «тяжелейшая копия лучше сохранилась».
