module Representative where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc; _+_)
open import Agda.Builtin.List using (List; []; _∷_)
open import Agda.Builtin.Bool using (Bool; true; false)

-- ------------------------------------------------------------
-- 0. Вспомогательное
-- ------------------------------------------------------------

data Empty : Set where

¬_ : Set → Set
¬ A = A → Empty

cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

data _≤_ : Nat → Nat → Set where
  z≤n : ∀ {n}           → zero  ≤ n
  s≤s : ∀ {m n} → m ≤ n → suc m ≤ suc n

≤-refl : ∀ n → n ≤ n
≤-refl zero    = z≤n
≤-refl (suc n) = s≤s (≤-refl n)

≤-step : ∀ {m n} → m ≤ n → m ≤ suc n
≤-step z≤n     = z≤n
≤-step (s≤s p) = s≤s (≤-step p)

≤-trans : ∀ {a b c} → a ≤ b → b ≤ c → a ≤ c
≤-trans z≤n     _       = z≤n
≤-trans (s≤s p) (s≤s q) = s≤s (≤-trans p q)

-- сложение не уменьшает: a ≤ a + b
≤-plusʳ : ∀ a b → a ≤ (a + b)
≤-plusʳ zero    b = z≤n
≤-plusʳ (suc a) b = s≤s (≤-plusʳ a b)

≤-plusˡ : ∀ a b → a ≤ (b + a)
≤-plusˡ a zero    = ≤-refl a
≤-plusˡ a (suc b) = ≤-step (≤-plusˡ a b)

_<?_ : Nat → Nat → Bool
zero  <? zero  = false
zero  <? suc _ = true
suc _ <? zero  = false
suc m <? suc n = m <? n

ifN : Bool → Nat → Nat → Nat
ifN true  t f = t
ifN false t f = f

max : Nat → Nat → Nat
max zero    n       = n
max (suc m) zero    = suc m
max (suc m) (suc n) = suc (max m n)

max-idem : ∀ n → max n n ≡ n
max-idem zero    = refl
max-idem (suc n) = cong suc (max-idem n)

max-≤ʳ : ∀ m n → n ≤ max m n
max-≤ʳ zero    n       = ≤-refl n
max-≤ʳ (suc m) zero    = z≤n
max-≤ʳ (suc m) (suc n) = s≤s (max-≤ʳ m n)

max-≤ˡ : ∀ m n → m ≤ max m n
max-≤ˡ zero    n       = z≤n
max-≤ˡ (suc m) zero    = ≤-refl (suc m)
max-≤ˡ (suc m) (suc n) = s≤s (max-≤ˡ m n)

max-lub : ∀ {m n b} → m ≤ b → n ≤ b → max m n ≤ b
max-lub {zero}  {n}     p q = q
max-lub {suc m} {zero}  p q = p
max-lub {suc m} {suc n} (s≤s p) (s≤s q) = s≤s (max-lub p q)

-- ------------------------------------------------------------
-- 1. Свидетель и группа копий одного корня
-- ------------------------------------------------------------

-- Носитель тот же, что в BeliefMass: пара весов «за / против».
record E : Set where
  constructor ev
  field
    w⁺ : Nat
    w⁻ : Nat

open E

-- Группа копий ОДНОГО корня. Не путать с независимыми свидетелями:
-- у них разные корни, и они складываются через ⊕ (BeliefMass).
Copies : Set
Copies = List E

-- ------------------------------------------------------------
-- 2. Три кандидата в представители
-- ------------------------------------------------------------

-- полный вес свидетельства: сколько испытаний за ним стоит, чем бы они ни кончились
wt : E → Nat
wt x = w⁺ x + w⁻ x

-- (а) НАБЛЮДАТЕЛЬНЕЙШАЯ копия — как в реализации (`src/reduce.lisp:227-229`):
--     сравниваем по полному весу, берём вклад «за» у победителя.
--     Здесь модель сведена с кодом; расхождение 30.07 было ошибкой модели.
repAt : Nat → Nat → Copies → Nat     -- (лучший полный вес, его вклад «за», остаток)
repAt best acc []       = acc
repAt best acc (x ∷ xs) = ifN (best <? wt x) (repAt (wt x) (w⁺ x) xs) (repAt best acc xs)

rep : Copies → Nat
rep xs = repAt 0 0 xs

-- (б) СУММА — «копии складываются», то есть повтор считается подтверждением
sum⁺ : Copies → Nat
sum⁺ []       = 0
sum⁺ (x ∷ xs) = w⁺ x + sum⁺ xs

-- (в) СЛАБЕЙШАЯ копия (для полноты разбора)
minrep : Copies → Nat
minrep []           = 0
minrep (x ∷ [])     = w⁺ x
minrep (x ∷ y ∷ xs) = mn (w⁺ x) (minrep (y ∷ xs))
  where
    mn : Nat → Nat → Nat
    mn zero    _       = zero
    mn (suc a) zero    = zero
    mn (suc a) (suc b) = suc (mn a b)

-- ------------------------------------------------------------
-- 3. ТРЕБОВАНИЯ К ПРЕДСТАВИТЕЛЮ (то, чего просил Тарантога)
-- ------------------------------------------------------------

-- вспомогательное для оценок
≤-plus-mono : ∀ {x y} (a : Nat) → x ≤ y → x ≤ (a + y)
≤-plus-mono zero    p = p
≤-plus-mono (suc a) p = ≤-step (≤-plus-mono a p)

+-monoʳ : ∀ (a : Nat) {x y} → x ≤ y → (a + x) ≤ (a + y)
+-monoʳ zero    p = p
+-monoʳ (suc a) p = s≤s (+-monoʳ a p)

-- ТЕОРЕМА 1 (rep-single). Группа из одной копии есть сама копия.
rep-single : ∀ (x : E) → rep (x ∷ []) ≡ w⁺ x
rep-single x = help (w⁺ x) (w⁻ x)
  where
    help : ∀ a b → ifN (0 <? (a + b)) (repAt (a + b) a []) (repAt 0 0 []) ≡ a
    help zero    zero    = refl
    help zero    (suc b) = refl
    help (suc a) b       = refl

-- 🔴 ТЕОРЕМА 2 (rep-bounded). Вес группы копий НЕ БОЛЬШЕ, чем если бы столько же
--    свидетельств были независимы. Это и есть запрет вознаграждения за размножение:
--    сколько копий одного корня ни принеси, больше суммы независимых голосов не выйдет.
private
  bounded-acc : ∀ (b a : Nat) (ys : Copies) → repAt b a ys ≤ (a + sum⁺ ys)
  bounded-acc b a []       = ≤-plusʳ a 0
  bounded-acc b a (y ∷ ys) = branch (b <? wt y)
    where
      branch : ∀ (t : Bool)
             → ifN t (repAt (wt y) (w⁺ y) ys) (repAt b a ys) ≤ (a + (w⁺ y + sum⁺ ys))
      branch true  = ≤-plus-mono a (bounded-acc (wt y) (w⁺ y) ys)
      branch false = ≤-trans (bounded-acc b a ys) (+-monoʳ a (≤-plus-mono (w⁺ y) (≤-refl (sum⁺ ys))))

rep-bounded : ∀ (xs : Copies) → rep xs ≤ sum⁺ xs
rep-bounded xs = bounded-acc 0 0 xs

-- 🔴 ТЕОРЕМА 3 (rep-idem). ТОЧНАЯ копия не добавляет ничего: повтор одного и того же
--    свидетельства не есть подтверждение. Здесь `rep` расходится с `⊕` из BeliefMass,
--    и это расхождение — несущее: вера независимых накапливается, копии одного — нет.
rep-idem : ∀ (x : E) → rep (x ∷ x ∷ []) ≡ rep (x ∷ [])
rep-idem x = help (w⁺ x) (w⁻ x)
  where
    help : ∀ a b →
           ifN (0 <? (a + b)) (ifN ((a + b) <? (a + b)) (repAt (a + b) a []) (repAt (a + b) a []))
                              (ifN (0 <? (a + b)) (repAt (a + b) a []) (repAt 0 0 []))
           ≡ ifN (0 <? (a + b)) (repAt (a + b) a []) (repAt 0 0 [])
    help zero    zero    = refl
    help zero    (suc b) = lt-irrefl-help (suc b)
      where
        lt-irrefl-help : ∀ n → ifN (n <? n) zero zero ≡ zero
        lt-irrefl-help zero    = refl
        lt-irrefl-help (suc m) = lt-irrefl-help m
    help (suc a) b = same (suc a + b)
      where
        same : ∀ n → ifN (n <? n) (suc a) (suc a) ≡ suc a
        same zero    = refl
        same (suc m) = same m

-- ------------------------------------------------------------
-- 4. ПОЧЕМУ НЕ ДРУГИЕ — контрпримерами, а не словами
-- ------------------------------------------------------------

private
  one  : E
  one  = ev 1 0
  worse : E                  -- наблюдательнее (полный вес 6 против 1), но хуже: 1 за, 5 против
  worse = ev 1 5

-- 🔴 СУММА нарушает идемпотентность: две копии одного свидетеля дали бы вдвое больше веры.
--    Это и есть «повтор как подтверждение» — то, против чего заведён язык.
sum-not-idem : ¬ (sum⁺ (one ∷ one ∷ []) ≡ sum⁺ (one ∷ []))
sum-not-idem ()

-- 🔴 ТЕОРЕМА 5 (worse-copy-may-lower) — то, что ПРЕЖНЯЯ `rep-mono` запрещала, а язык требует.
--    Более наблюдательная копия того же корня, вышедшая ХУЖЕ, роняет вклад группы:
--    `rep [one] = 1`, `rep [one, worse] = 1` по вкладу «за», но представителем становится
--    свидетельство с пятью голосами против — и вера, считаемая по нему, падает.
--    Формально здесь: представитель СМЕНИЛСЯ, потому что worse наблюдательнее.
worse-copy-takes-over : rep (one ∷ worse ∷ []) ≡ w⁺ worse
worse-copy-takes-over = refl

-- и это НЕ равно наивному «максимуму за», который выбрал бы благоприятнейшую копию:
-- прежняя модель дала бы тот же вклад «за», но представителя с нулём против —
-- то есть спрятала бы пять отрицательных испытаний. Черри-пикинг в носителе.

-- ------------------------------------------------------------
-- 5. ГРАНИЦА ЧЕСТНОСТИ (переписана 30.07 после аудита)
-- ------------------------------------------------------------
--
--  ДОКАЗАНО здесь: представитель по полному весу не даёт вознаграждения за размножение
--  (`rep-bounded`), точная копия не добавляет ничего (`rep-idem`), группа из одной копии
--  есть сама копия (`rep-single`), и более наблюдательная худшая копия ЗАБИРАЕТ
--  представительство (`worse-copy-takes-over`).
--
--  🔴 СНЯТО: `rep-mono` («ещё одна копия того же корня не понижает вес группы»).
--  Снято НЕ как недоказанное, а как НЕВЕРНАЯ ЦЕЛЬ. Требовать монотонности вверх значит
--  требовать, чтобы новое знание не могло ухудшить вывод. Это патология, против которой
--  строится язык: отзыв обязан ронять, молчание обязано ронять до дна, более полное
--  наблюдение, вышедшее хуже, обязано ронять тоже. (Довод Тарантоги, 30.07; принят.)
--
--  НЕ ДОКАЗАНО и доказано быть не может: что «наблюдательнее» означает «ближе к истине».
--  Это утверждение о МИРЕ — о том, как устроены свидетельства, — а не о модели.
--  Остаётся объявлением языка, названным здесь вслух, а не молчаливой очевидностью.
--
--  СВЕРКА С РЕАЛИЗАЦИЕЙ: `src/reduce.lisp:227-229` сортирует по `(+ w+ w-)` и берёт вклад
--  «за» победителя — то же, что `repAt` здесь. Сверено чтением интерфейсной функции
--  30.07.2026 (`SELF_GUARD` XIII: доказывать можно только то, чьё поведение видела).
