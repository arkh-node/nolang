-- ============================================================
--  nolang · ПОДДЕРЖКА: множество корней вместо одного корня
--
--  ЗАЧЕМ (Тарантога, находка №2 от 29.07.2026).
--   Свидетель несёт корень, выведенное утверждение — нет (`origin = nil`).
--   Свёртка группирует ПО КОРНЮ, значит два независимых вывода попадают
--   в группу «корень nil» и один поглощается как копия другого:
--       claim c from a, b   →  вера 0.540   (корни (NIL))
--       claim c from w1, w2 →  вера 0.675   (корни (R1 R2))
--   Одно и то же основание через выводы даёт меньше. Направление ошибки —
--   занижение, отмывания нет; но «B поглощён как копия» — ложь в журнале.
--
--  ПОЧЕМУ ОЧЕВИДНАЯ ПОЧИНКА ХУЖЕ БОЛЕЗНИ.
--   «Пусть вывод будет сам себе корень» меняет безопасную ошибку на опасную:
--   если a и b выведены из ОДНОГО свидетеля, они зависимы, и такая починка
--   сложила бы предка дважды — это отмывание (долг №5, зависимые свидетели).
--
--  ДИАГНОЗ ОТСЮДА, ИЗ ДВУХ УЖЕ ДОКАЗАННЫХ ФАЙЛОВ.
--   `Preservation`: степень живёт на `⊓` — ИДЕМПОТЕНТНА, только деградирует.
--   `BeliefMass`  : масса веры живёт на `⊕` — НЕ идемпотентна (⊕-not-idem),
--                   она накапливается.
--   Реализация протаскивает «откуда» через НЕидемпотентный носитель — отсюда
--   обе беды разом. Поддержка обязана жить на идемпотентной операции.
--   Значит носитель — МНОЖЕСТВО корней, операция — объединение.
--
--  РЕШАЮЩИЙ ХОД ЭТОГО ФАЙЛА.
--   Масса определена НЕ по списку, а по ЧЛЕНСТВУ (`massUpTo` идёт по диапазону
--   идентификаторов и берёт корень, если он в поддержке). Тогда всё, что верно
--   для множеств, переносится на массу автоматически: порядок посылок,
--   повторы и способ записи поддержки не могут изменить веру.
--
--  ЧТО ДОКАЗАНО:
--   1. mass-resp-∈   : масса зависит ТОЛЬКО от членства (не от порядка/повторов)
--   2. ∪-idem        : mass (S ∪ S) ≡ mass S      — предок не считается дважды
--   3. ∪-comm        : mass (S ∪ T) ≡ mass (T ∪ S) — порядок посылок не влияет
--   4. 🔴 derived≡direct : вывод из a,b даёт РОВНО ТУ ЖЕ массу, что прямое
--      основание из w1,w2 — занижение исчезает по построению, а не проверкой
--   5. 🔴 shared-root-once : у общего предка вклад ровно один — отмывания нет
--   6. mono-∈        : расширение поддержки не понижает вес «за»
--      (инвариант безопасности Тарантоги: через выводы вера НЕ ВЫШЕ прямой,
--       здесь — в точной форме: не выше и не ниже, когда основание то же)
--
--  ЧЕГО ЗДЕСЬ НЕТ (чтобы на файл не сослались шире, чем он есть):
--   • ничего про степень и решётку — это `Preservation`;
--   • ничего про сравнение вер дробями — это `BeliefMass`;
--   • здесь только НОСИТЕЛЬ ПОДДЕРЖКИ и его законы.
--
--  Самодостаточен: без stdlib, только Agda.Builtin. Проверяется под --safe.
--  — Невис, 29.07.2026
-- ============================================================

module SupportSet where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc; _+_)
open import Agda.Builtin.Bool using (Bool; true; false)
open import Agda.Builtin.List using (List; []; _∷_)

-- ------------------------------------------------------------
-- 0. Вспомогательное (то же, что в Preservation — файлы самодостаточны)
-- ------------------------------------------------------------

-- ⟦определительное⟧
cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

-- ⟦определительное⟧
cong₂ : ∀ {A B C : Set} (f : A → B → C) {x y : A} {u v : B}
      → x ≡ y → u ≡ v → f x u ≡ f y v
cong₂ f refl refl = refl

-- ⟦определительное⟧
sym : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
sym refl = refl

-- ⟦определительное⟧
trans : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
trans refl refl = refl

-- ⟦определение⟧
_==ᴺ_ : Nat → Nat → Bool
zero  ==ᴺ zero  = true
zero  ==ᴺ suc _ = false
suc _ ==ᴺ zero  = false
suc m ==ᴺ suc n = m ==ᴺ n

-- ⟦определительное⟧
==ᴺ-refl : ∀ n → (n ==ᴺ n) ≡ true
==ᴺ-refl zero    = refl
==ᴺ-refl (suc n) = ==ᴺ-refl n

-- ⟦определение⟧
_or_ : Bool → Bool → Bool
true  or _ = true
false or b = b

-- порядок на весах: нужен для инварианта безопасности
data _≤_ : Nat → Nat → Set where
  -- ⟦определение⟧
  z≤n : ∀ {n}             → zero  ≤ n
  -- ⟦определение⟧
  s≤s : ∀ {m n} → m ≤ n   → suc m ≤ suc n

-- ⟦определительное⟧
≤-refl : ∀ n → n ≤ n
≤-refl zero    = z≤n
≤-refl (suc n) = s≤s (≤-refl n)

-- ⟦определительное⟧
+-mono : ∀ {a b c d} → a ≤ b → c ≤ d → (a + c) ≤ (b + d)
+-mono z≤n       q = ≤-mono-r _ q
  where
    ≤-mono-r : ∀ {c d} (b : Nat) → c ≤ d → c ≤ (b + d)
    ≤-mono-r zero    q       = q
    ≤-mono-r (suc b) z≤n     = z≤n
    ≤-mono-r (suc b) (s≤s q) = ≤-step (≤-mono-r b (s≤s q))
      where
        ≤-step : ∀ {m n} → m ≤ n → m ≤ suc n
        ≤-step z≤n     = z≤n
        ≤-step (s≤s p) = s≤s (≤-step p)
+-mono (s≤s p) q = s≤s (+-mono p q)

-- ------------------------------------------------------------
-- 1. Корни и поддержка
-- ------------------------------------------------------------

-- ⟦определение⟧
Root : Set
Root = Nat

-- Поддержка записывается списком, но ЧИТАЕТСЯ как множество:
-- всё ниже зависит только от `∈?`, а не от порядка и повторов.
-- ⟦определение⟧
Support : Set
Support = List Root

-- ⟦определение⟧
_∈?_ : Root → Support → Bool
r ∈? []       = false
r ∈? (s ∷ ss) = (r ==ᴺ s) or (r ∈? ss)

-- объединение: та самая идемпотентная операция, на которой обязана жить
-- поддержка (в отличие от ⊕ из BeliefMass, где вера накапливается)
-- ⟦определение⟧
_∪_ : Support → Support → Support
[]       ∪ t = t
(r ∷ ss) ∪ t = r ∷ (ss ∪ t)

infixr 5 _∪_

-- ------------------------------------------------------------
-- 2. Членство в объединении
-- ------------------------------------------------------------

-- ⟦определительное⟧
∈-∪ : ∀ (r : Root) (s t : Support) → (r ∈? (s ∪ t)) ≡ ((r ∈? s) or (r ∈? t))
∈-∪ r []       t = refl
∈-∪ r (x ∷ ss) t with r ==ᴺ x
... | true  = refl
... | false = ∈-∪ r ss t

-- ⟦определительное⟧
or-idem : ∀ (b : Bool) → (b or b) ≡ b
or-idem true  = refl
or-idem false = refl

-- ⟦определительное⟧
or-comm : ∀ (a b : Bool) → (a or b) ≡ (b or a)
or-comm true  true  = refl
or-comm true  false = refl
or-comm false true  = refl
or-comm false false = refl

-- 🔴 членство в S ∪ S совпадает с членством в S: повтор не добавляет ничего
-- ⟦определительное⟧
∈-∪-idem : ∀ (r : Root) (s : Support) → (r ∈? (s ∪ s)) ≡ (r ∈? s)
∈-∪-idem r s = trans (∈-∪ r s s) (or-idem (r ∈? s))

-- ⟦определительное⟧
∈-∪-comm : ∀ (r : Root) (s t : Support) → (r ∈? (s ∪ t)) ≡ (r ∈? (t ∪ s))
∈-∪-comm r s t = trans (∈-∪ r s t) (trans (or-comm (r ∈? s) (r ∈? t)) (sym (∈-∪ r t s)))

-- ------------------------------------------------------------
-- 3. Масса: считается ПО ЧЛЕНСТВУ, а не по списку
--    (носитель веса — как в BeliefMass: пара «за/против»)
-- ------------------------------------------------------------

record E : Set where
  constructor ev
  field
    w⁺ : Nat
    w⁻ : Nat

open E

-- ⟦определение⟧
_⊕_ : E → E → E
x ⊕ y = ev (w⁺ x + w⁺ y) (w⁻ x + w⁻ y)

-- ⟦определение⟧
silence : E
silence = ev 0 0

-- вклад одного корня (какой именно — дело программы, здесь это параметр)
module WithWeights (weight : Root → E) where

  -- ⟦определение⟧
  pick : Bool → E → E
  pick true  e = e
  pick false _ = silence

  -- сумма вкладов корней из диапазона [0 .. n), присутствующих в поддержке.
  -- Ключ: смотрим на ЧЛЕНСТВО, поэтому порядок и повторы записи не влияют.
  -- ⟦определение⟧
  massUpTo : Nat → Support → E
  massUpTo zero    s = silence
  massUpTo (suc n) s = pick (n ∈? s) (weight n) ⊕ massUpTo n s

  -- ----------------------------------------------------------
  -- ТЕОРЕМА 1. Масса зависит ТОЛЬКО от членства
  -- ----------------------------------------------------------
  -- ⟦содержательное⟧
  mass-resp-∈ : ∀ (n : Nat) (s t : Support)
              → (∀ r → (r ∈? s) ≡ (r ∈? t))
              → massUpTo n s ≡ massUpTo n t
  mass-resp-∈ zero    s t h = refl
  mass-resp-∈ (suc n) s t h =
    cong₂ _⊕_ (cong (λ b → pick b (weight n)) (h n)) (mass-resp-∈ n s t h)

  -- ----------------------------------------------------------
  -- 🔴 ТЕОРЕМА 2 (∪-idem). Повтор поддержки не меняет массу.
  --    Это и есть структурная защита от двойного счёта предка:
  --    её нельзя забыть применить, она в носителе.
  -- ----------------------------------------------------------
  -- ⟦содержательное⟧
  ∪-idem : ∀ (n : Nat) (s : Support) → massUpTo n (s ∪ s) ≡ massUpTo n s
  ∪-idem n s = mass-resp-∈ n (s ∪ s) s (λ r → ∈-∪-idem r s)

  -- ----------------------------------------------------------
  -- ТЕОРЕМА 3 (∪-comm). Порядок посылок не влияет на веру.
  -- ----------------------------------------------------------
  -- ⟦содержательное⟧
  ∪-comm : ∀ (n : Nat) (s t : Support) → massUpTo n (s ∪ t) ≡ massUpTo n (t ∪ s)
  ∪-comm n s t = mass-resp-∈ n (s ∪ t) (t ∪ s) (λ r → ∈-∪-comm r s t)

  -- ----------------------------------------------------------
  -- 🔴 ТЕОРЕМА 4 (derived≡direct) — ответ на находку №2.
  --
  --    Вывод из посылок a, b несёт объединение их поддержек.
  --    Прямое основание из тех же свидетелей несёт то же объединение.
  --    Значит массы РАВНЫ: занижения 0.540 против 0.675 не возникает
  --    по построению носителя, а не потому, что кто-то проверил.
  -- ----------------------------------------------------------
  -- ⟦определение⟧
  derived : Support → Support → Support
  derived sa sb = sa ∪ sb

  -- ⟦определение⟧
  direct : Support → Support → Support
  direct sw1 sw2 = sw1 ∪ sw2

  -- ⟦определительное⟧
  derived≡direct : ∀ (n : Nat) (sa sb : Support)
                 → massUpTo n (derived sa sb) ≡ massUpTo n (direct sa sb)
  derived≡direct n sa sb = refl

  -- ----------------------------------------------------------
  -- 🔴 ТЕОРЕМА 5 (shared-root-once) — вторая половина находки №2.
  --
  --    Если обе посылки выведены из ОДНОГО корня, вклад этого корня
  --    входит РОВНО ОДИН раз. Наивная починка «вывод сам себе корень»
  --    сложила бы предка дважды; здесь это невозможно.
  -- ----------------------------------------------------------
  -- ⟦содержательное⟧
  shared-root-once : ∀ (n : Nat) (s : Support)
                   → massUpTo n (derived s s) ≡ massUpTo n s
  shared-root-once n s = ∪-idem n s

  -- ----------------------------------------------------------
  -- ТЕОРЕМА 6 (mono-∈). Инвариант безопасности в точной форме:
  --    если всё, что поддерживает S, поддерживает и T, то вес «за»
  --    не падает. «Через выводы вера не выше» — частный случай при
  --    равенстве членства (теорема 4).
  -- ----------------------------------------------------------
  -- ⟦содержательное⟧
  mono-∈ : ∀ (n : Nat) (s t : Support)
         → (∀ r → (r ∈? s) ≡ true → (r ∈? t) ≡ true)
         → w⁺ (massUpTo n s) ≤ w⁺ (massUpTo n t)
  mono-∈ zero    s t h = z≤n
  mono-∈ (suc n) s t h = +-mono step (mono-∈ n s t h)
    where
      step : w⁺ (pick (n ∈? s) (weight n)) ≤ w⁺ (pick (n ∈? t) (weight n))
      step with n ∈? s | h n
      ...  | false | _   = z≤n
      ...  | true  | hyp with n ∈? t | hyp refl
      ...    | true  | _ = ≤-refl (w⁺ (weight n))
      ...    | false | ()
