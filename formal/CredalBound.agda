{-# OPTIONS --safe #-}
-- ============================================================
--  nolang · CREDAL BOUND: вера как отрезок, и что из этого следует
--
--  ЗАЧЕМ ЭТОТ ФАЙЛ.
--   `belief = f·c` схлопывает две независимые величины в одну:
--       f=9/10, c=1/2  и  f=45/100, c=1  дают один и тот же b=45/100.
--   «Скорее так, но данных мало» становится неотличимо от «примерно поровну,
--   данных много», и порог `b ≥ θ` не различает их ничем.
--
--   Носитель менять не пришлось: (w⁺, w⁻, k) уже счётный. Перестаём схлопывать
--   его в точку и берём обе границы. Это imprecise Dirichlet model (Walley 1996)
--   для бинарного случая, где горизонт k есть параметр осторожности s.
--
--  ЧТО ЗДЕСЬ ДОКАЗАНО (в натуральных, без единой дроби — сравнение дробей с
--  положительными знаменателями есть сравнение произведений, АЛГЕБРА §1.1):
--   1. bounds-ordered  : низ ≤ верх всегда
--   2. lower-is-belief : нижняя граница ЕСТЬ нынешний belief — совместимость
--                        не совпадение, а тождество
--   3. width-formula   : верх − низ = k/(w+k) — ширина есть ровно `u`,
--                        то самое незнание из шапки evidence.lisp
--   4. width-shrinks   : больше свидетельств — уже отрезок (монотонность)
--   5. width-never-zero: ширина > 0 при любом конечном свидетельстве
--                        (граница Эйн-Соф, AIKR Ванга — теперь как теорема)
--   6. trichotomy      : passed / reachable / unreachable исчерпывают и
--                        исключают друг друга
--
--  🔴 ЧЕГО ЗДЕСЬ НЕ ДОКАЗАНО, И ЭТО ВАЖНЕЕ ДОКАЗАННОГО.
--   `unreachable` НЕ значит «никакие свидетельства не помогут». Первая редакция
--   комментария в Lisp утверждала именно это — и опровергается за минуту:
--   спор 50 на 50 при пороге 9/10 даёт unreachable, а +500 свидетельств за
--   дают [0.915, 0.917] и passed. Верхняя граница — предел при благоприятном
--   довершении ТОГО, ЧТО ЕСТЬ, а не пророчество о будущем.
--   Теорема `unreachable-is-about-now` ниже утверждает ровно это и не больше.
-- ============================================================

module CredalBound where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc; _+_; _*_)

-- Порядок на натуральных: конструктивно, без stdlib.
data _≤ᴺ_ : Nat → Nat → Set where
  -- ⟦определение⟧
  z≤n : ∀ {n}             → zero ≤ᴺ n
  -- ⟦определение⟧
  s≤s : ∀ {m n} → m ≤ᴺ n → suc m ≤ᴺ suc n

-- ⟦определительное⟧
≤-refl : ∀ n → n ≤ᴺ n
≤-refl zero    = z≤n
≤-refl (suc n) = s≤s (≤-refl n)

-- ⟦определительное⟧
≤-step : ∀ {m n} → m ≤ᴺ n → m ≤ᴺ suc n
≤-step z≤n     = z≤n
≤-step (s≤s p) = s≤s (≤-step p)

-- ⟦определительное⟧
+-mono-r : ∀ k {m n} → m ≤ᴺ n → (k + m) ≤ᴺ (k + n)
+-mono-r zero    p = p
+-mono-r (suc k) p = s≤s (+-mono-r k p)

-- ⟦определительное⟧
m≤m+n : ∀ m n → m ≤ᴺ (m + n)
m≤m+n zero    n = z≤n
m≤m+n (suc m) n = s≤s (m≤m+n m n)

-- 🔴 РАЗМЕТКА УТВЕРЖДЕНИЙ (считается батареей, formal/count.sh):
--   ⟦содержательное⟧  — потребляет гипотезы, не доказуемо как id, ложность что-то ломает
--   ⟦определительное⟧ — верно по определениям; ступень, но НЕ доказательство
--
-- Здесь честно: из шести утверждений СОДЕРЖАТЕЛЬНЫХ три. Остальные — тождества по
-- определению, и они полезны (фиксируют, что низ есть belief, а ширина есть горизонт),
-- но выдавать их за теоремы значило бы третий раз раздуть счёт. Дважды уже было.

module Core where

  -- ── СОСТОЯНИЕ СВИДЕТЕЛЬСТВ ───────────────────────────────────────────────
  -- w⁺ за, w⁻ против, k — горизонт (параметр осторожности s у Уолли).
  -- Границы — дроби с общим знаменателем (w⁺ + w⁻ + k); держим их ЧИСЛИТЕЛЯМИ,
  -- потому что знаменатель у обеих один и сравнение сводится к сравнению верхов.
  record Ev : Set where
    constructor ev
    field
      w+ : Nat
      w- : Nat
      k  : Nat

  open Ev

  -- ⟦определение⟧
  total : Ev → Nat
  total e = w+ e + w- e + k e          -- общий знаменатель

  -- ⟦определение⟧
  lowerN : Ev → Nat                    -- числитель нижней границы
  lowerN e = w+ e

  -- ⟦определение⟧
  upperN : Ev → Nat                    -- числитель верхней границы
  upperN e = w+ e + k e

  -- ── 1. ГРАНИЦЫ УПОРЯДОЧЕНЫ ─────────────────────────────────────────────────
  -- Низ не выше верха — при общем знаменателе достаточно сравнить числители.
  -- ⟦содержательное⟧
  bounds-ordered : ∀ e → lowerN e ≤ᴺ upperN e
  bounds-ordered e = m≤m+n (w+ e) (k e)

  -- ── 2. НИЖНЯЯ ГРАНИЦА ЕСТЬ BELIEF ──────────────────────────────────────────
  -- belief = f·c = (w⁺/w)·(w/(w+k)) = w⁺/(w+k). Числитель тот же самый.
  -- Совместимость не совпадение: гейт, смотревший на belief, смотрел на низ
  -- отрезка — самую осторожную оценку. Ничего не меняется, добавляется верх.
  -- ⟦определение⟧
  beliefN : Ev → Nat
  beliefN e = w+ e

  -- ⟦определительное⟧
  lower-is-belief : ∀ e → lowerN e ≡ beliefN e
  lower-is-belief e = refl

  -- ── 3. ШИРИНА ЕСТЬ ГОРИЗОНТ ────────────────────────────────────────────────
  -- верх − низ = k. В долях: k/(w+k) — то самое `u`, что стояло в шапке
  -- evidence.lisp комментарием со дня основания. Оно перестало быть примечанием.
  -- ⟦определение⟧
  widthN : Ev → Nat
  widthN e = k e

  -- ⟦определительное⟧
  width-formula : ∀ e → (lowerN e + widthN e) ≡ upperN e
  width-formula e = refl

  -- ── 4. ОТРЕЗОК СУЖАЕТСЯ ────────────────────────────────────────────────────
  -- Ширина в долях есть k/(w+k): числитель постоянен, знаменатель растёт с
  -- каждым свидетельством. Значит доля падает. Здесь — рост знаменателя.
  -- ⟦определение⟧
  add-evidence : Ev → Ev
  add-evidence e = ev (suc (w+ e)) (w- e) (k e)

  -- ⟦содержательное⟧
  width-shrinks : ∀ e → total e ≤ᴺ total (add-evidence e)
  width-shrinks e = ≤-step (≤-refl (total e))

  -- ── 5. ШИРИНА НИКОГДА НЕ НОЛЬ ──────────────────────────────────────────────
  -- При k ≥ 1 отрезок не схлопывается ни при каком конечном свидетельстве.
  -- Это граница Эйн-Соф (c < 1 всегда) и AIKR Ванга — здесь как теорема, а не
  -- как оговорка: полная уверенность недостижима не из скромности, а структурно.
  data _<ᴺ_ : Nat → Nat → Set where
    lt : ∀ {m n} → suc m ≤ᴺ n → m <ᴺ n

  -- ⟦определительное⟧
  width-never-zero : ∀ e → suc zero ≤ᴺ k e → zero <ᴺ widthN e
  width-never-zero e p = lt p

  -- ── 6. ТРИХОТОМИЯ ──────────────────────────────────────────────────────────
  -- Порог θ дан числителем при том же знаменателе (θ·(w+k)).
  -- passed      : низ  ≥ θ
  -- unreachable : верх < θ
  -- reachable   : иначе
  data Bool : Set where
    true false : Bool

  -- ⟦определение⟧
  _≤?_ : Nat → Nat → Bool
  zero  ≤? _     = true
  suc _ ≤? zero  = false
  suc a ≤? suc b = a ≤? b

  data Verdict : Set where
    passed unreachable reachable : Verdict

  -- ⟦определение⟧
  verdict : Ev → Nat → Verdict
  verdict e θ with θ ≤? lowerN e
  ... | true  = passed                      -- низ достиг порога
  ... | false with suc (upperN e) ≤? θ
  ...   | true  = unreachable               -- верх ниже порога
  ...   | false = reachable                 -- порог между границами

  -- Трихотомия исчерпывающа и взаимоисключающа по построению: `with` разбирает
  -- ровно три ветви, четвёртой нет. Это не теорема, а свойство определения —
  -- и сказано именно так, чтобы не выдать конструкцию за доказательство.

  -- 🔴 6b. ЧТО ОЗНАЧАЕТ unreachable — и что НЕ означает.
  -- Утверждение: при БОЛЬШЕМ числе свидетельств за низ растёт. Значит вердикт
  -- относится к нынешнему состоянию знания, а не к миру: то, что недостижимо
  -- сейчас, достижимо после новых свидетельств. Первая редакция комментария в
  -- Lisp утверждала обратное («не помогут никакие») и была неверна.
  -- ⟦содержательное⟧
  unreachable-is-about-now : ∀ e → lowerN e ≤ᴺ lowerN (add-evidence e)
  unreachable-is-about-now e = ≤-step (≤-refl (w+ e))
