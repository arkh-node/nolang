{-# OPTIONS --safe #-}
-- ============================================================
--  nolang · RE-ENTRY: возврат в себя, и что при нём НЕЛЬЗЯ приобрести
--
--  ЗАЧЕМ ЭТОТ ФАЙЛ.
--   `Obj0 math = projection + invariant + re-entry`. Первые два примитива были и
--   доказаны; третий появился 05.08.2026 (`src/subject.lisp`) и держался на батарее.
--   Здесь у него появляется доказательство.
--
--   Главное решение реализации: ВОССТАНОВЛЕНИЕ ЕСТЬ ВОСПРОИЗВЕДЕНИЕ, а не загрузка.
--   Сохранённому итогу не верят — его пересчитывают из тех же посылок. Значит
--   доказывать надо не «состояние поднялось верно», а более сильное: при возврате
--   НЕЛЬЗЯ приобрести знание, которого не было.
--
--  🔴 ПОПРАВКА, СДЕЛАННАЯ ПРИ ПЕРВОЙ ЖЕ СБОРКЕ (записано, чтобы не повторить).
--   Сперва я взялся доказывать `run (ps ++ qs) ≡ run ps ⊓ run qs` — «вывод целого
--   есть встреча выводов частей». Формула ЛОЖНА, и ложна по хорошей причине:
--   `run [] = ⊥` (пустая база даёт дно — это `empty-base` из Preservation, защита от
--   отмывания из ничего). Будь у свёртки нейтраль ⊤, пустая программа выдавала бы
--   верх решётки — тот самый баг. Моноидальности здесь нет НАМЕРЕННО, и теорему надо
--   формулировать иначе.
--
--  ЧТО ДОКАЗАНО НИЖЕ:
--   ⟦содержательное⟧  run-below-member : вывод не выше ЛЮБОЙ входящей посылки
--   ⟦содержательное⟧  no-gain-on-return: каждая ПРЕЖНЯЯ посылка продолжает ограничивать
--                     вывод — сколько бы нового ни пришло (первая формулировка была ложной,
--                     см. поправку у самой теоремы)
--   ⟦определительное⟧ replay-deterministic : те же посылки — тот же вывод
--
--  🔴 ЧЕГО ЗДЕСЬ НЕТ И БЫТЬ НЕ МОЖЕТ.
--   Что записанные посылки СООТВЕТСТВУЮТ прошлому — недоказуемо изнутри: это
--   утверждение о мире, а не о вычислении. Цепь отпечатков (D5) делает подделку
--   не-точечной и не спасает последнее звено. Здесь доказано ровно вычислимое.
-- ============================================================

module ReEntry where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Nat using (Nat; zero; suc)
open import Agda.Builtin.List using (List; []; _∷_)

sym : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
sym refl = refl

trans : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
trans refl q = q

cong : ∀ {A B : Set} {x y : A} (f : A → B) → x ≡ y → f x ≡ f y
cong f refl = refl

record MeetSemilattice : Set₁ where
  field
    G     : Set
    ⊥ᴳ    : G
    _⊓_   : G → G → G
    ⊓-comm  : ∀ a b   → (a ⊓ b) ≡ (b ⊓ a)
    ⊓-assoc : ∀ a b c → ((a ⊓ b) ⊓ c) ≡ (a ⊓ (b ⊓ c))
    ⊓-idem  : ∀ a     → (a ⊓ a) ≡ a
    ⊥-absorb : ∀ a    → (⊥ᴳ ⊓ a) ≡ ⊥ᴳ

module Core (L : MeetSemilattice) where
  open MeetSemilattice L

  _≤ᴳ_ : G → G → Set
  a ≤ᴳ b = (a ⊓ b) ≡ a

  ≤-refl : ∀ a → a ≤ᴳ a
  ≤-refl a = ⊓-idem a

  -- Посылка: свидетель со степенью либо потреблённое молчание (степень ⊥).
  -- Непотреблённое молчание сюда не доходит: программа с висящим долгом не собирается.
  data Premise : Set where
    wit  : Nat → G → Premise
    used : Nat → Premise

  grade-of : Premise → G
  grade-of (wit _ g) = g
  grade-of (used _)  = ⊥ᴳ

  -- Прогон: свёртка встречей. Пустое даёт ⊥ — см. поправку в шапке.
  run : List Premise → G
  run []       = ⊥ᴳ
  run (p ∷ ps) = grade-of p ⊓ run ps

  -- ── 1. ВЫВОД НЕ ВЫШЕ ЛЮБОЙ ПОСЫЛКИ ────────────────────────────────────
  -- ⟦содержательное⟧
  -- Принадлежность — конструктивно, чтобы «любой» было проверяемым, а не словом.
  data _∈_ : Premise → List Premise → Set where
    here  : ∀ {p ps}   → p ∈ (p ∷ ps)
    there : ∀ {p q ps} → p ∈ ps → p ∈ (q ∷ ps)

  ⊓-lower-l : ∀ a b → (a ⊓ b) ≤ᴳ a
  ⊓-lower-l a b =
    trans (⊓-assoc a b a)
      (trans (cong (λ z → a ⊓ z) (⊓-comm b a))
        (trans (sym (⊓-assoc a a b))
               (cong (λ z → z ⊓ b) (⊓-idem a))))

  ⊓-lower-r : ∀ a b → (a ⊓ b) ≤ᴳ b
  ⊓-lower-r a b =
    trans (⊓-assoc a b b) (cong (λ z → a ⊓ z) (⊓-idem b))

  ≤-trans : ∀ a b c → a ≤ᴳ b → b ≤ᴳ c → a ≤ᴳ c
  ≤-trans a b c ab bc =
    trans (cong (λ z → z ⊓ c) (sym ab))
      (trans (⊓-assoc a b c)
        (trans (cong (λ z → a ⊓ z) bc) ab))

  run-below-member : ∀ {p ps} → p ∈ ps → run ps ≤ᴳ grade-of p
  run-below-member {p} {p ∷ ps} here = ⊓-lower-l (grade-of p) (run ps)
  run-below-member {p} {q ∷ ps} (there mem) =
    ≤-trans (run (q ∷ ps)) (run ps) (grade-of p)
            (⊓-lower-r (grade-of q) (run ps))
            (run-below-member mem)

  -- ── 2. ВОЗВРАТ НЕ ПОДНИМАЕТ ВЫВОД ─────────────────────────────────────
  -- ⟦содержательное⟧
  _++_ : List Premise → List Premise → List Premise
  []       ++ ys = ys
  (x ∷ xs) ++ ys = x ∷ (xs ++ ys)

  -- 🔴 ВТОРАЯ ЛОЖНАЯ ФОРМУЛИРОВКА, ПОЙМАННАЯ КОМПИЛЯТОРОМ (и записанная здесь).
  -- Сперва стояло: `run (ps ++ qs) ≤ run ps` — «продолжение не поднимает вывод».
  -- Ложно, и ложно в одном месте: при пустой прежней части `run [] = ⊥`, а продолжение
  -- даёт что-то выше дна. Это законный рост: из ничего пришли посылки. Agda отказалась.
  --
  -- Верная формулировка сильнее и точнее: КАЖДАЯ ПРЕЖНЯЯ ПОСЫЛКА ПРОДОЛЖАЕТ ОГРАНИЧИВАТЬ.
  -- Сколько бы нового ни пришло, вывод продолжения не выше того, что дала любая посылка
  -- из прежней части. Именно это демонстрация показывает делом: прежний fold
  -- воспроизводится, а не растворяется в новых свидетельствах.
  ∈-++ : ∀ {p} ps qs → p ∈ ps → p ∈ (ps ++ qs)
  ∈-++ (x ∷ ps) qs here        = here
  ∈-++ (x ∷ ps) qs (there mem) = there (∈-++ ps qs mem)

  no-gain-on-return : ∀ {p} ps qs → p ∈ ps → run (ps ++ qs) ≤ᴳ grade-of p
  no-gain-on-return ps qs mem = run-below-member (∈-++ ps qs mem)

  -- ── 3. ВОСПРОИЗВОДИМОСТЬ ──────────────────────────────────────────────
  -- ⟦определительное⟧
  -- Тривиально как утверждение о функции — и нетривиально как РЕШЕНИЕ: именно
  -- поэтому субъект хранит посылки, а не итог. Хранили бы итог — сверять было бы
  -- не с чем, пришлось бы верить записи на слово.
  replay-deterministic : ∀ ps → run ps ≡ run ps
  replay-deterministic ps = refl
