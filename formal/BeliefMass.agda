{-# OPTIONS --safe #-}
-- ============================================================
--  nolang · МАССА ВЕРЫ: b = f·c, ревизия ⊕ и точный критерий падения
--
--  ЗАЧЕМ.
--   `Preservation.agda` доказывает всё про СТЕПЕНЬ (честность, решётка ⊓).
--   Здесь второй носитель — УВЕРЕННОСТЬ и вера, где живёт гейт. Тарантога
--   (АЛГЕБРА_v0 §2.4) вывел критерий выкладкой и проверил на 200 случайных;
--   здесь он доказан.
--
--  ПОЧЕМУ БЕЗ ДРОБЕЙ.
--   `b = f·c = w⁺/(w+k)` — дробь, но всякое сравнение дробей с положительными
--   знаменателями есть сравнение произведений. Поэтому носитель — пара весов
--   `(w⁺, w⁻)` в ℕ, а «b₁ < b₂» разворачивается в перекрёстное умножение.
--   Ни одного вещественного числа, ни одной аксиомы.
--
--  ЧТО ДОКАЗАНО:
--   1. ⊕ — коммутативный моноид с нейтралью (0,0) = МОЛЧАНИЕ
--   2. ⊕ НЕ идемпотентна: вера накапливается (в паре с ⊓, которая деградирует)
--   3. b(x) = w⁺/(w+k) — тождество, а не удобное произведение f·c
--   4. 🔴 ТЕОРЕМА 5: b(x ⊕ e) < b(x)  ⟺  f(e) < b(x)
--      Свидетель роняет веру не тем, что «против», а тем, что его частота
--      ниже уже накопленной массы веры. Гейт самоцентрируется.
--   5. Зеркало для отзыва: отозвать свидетеля с частотой ВЫШЕ веры — уронить
--      её; значит отозвать оппонента = укрепить веру. Не парадокс, а учёт.
--   6. Свидетельство «за» никогда не понижает веру (монотонность по w⁺).
--
--  ГРАНИЦА ЭЙН-СОФ. `c = w/(w+k)` при `k > 0` строго меньше единицы всегда;
--  здесь это видно тем, что знаменатель `w + k` строго больше числителя `w⁺`
--  при любом конечном свидетельстве. Полная уверенность недостижима не по
--  скромности, а по построению носителя.
-- ============================================================

module BeliefMass where

open import Data.Nat
open import Data.Nat.Properties
open import Data.Product using (_×_; _,_; proj₁; proj₂)
open import Relation.Binary.PropositionalEquality
  using (_≡_; refl; sym; trans; cong; cong₂; subst₂; module ≡-Reasoning)
open import Relation.Nullary using (¬_)

-- ------------------------------------------------------------
-- 1. Носитель свидетельства
-- ------------------------------------------------------------

record E : Set where
  constructor ev
  field
    w⁺ : ℕ        -- вес «за»
    w⁻ : ℕ        -- вес «против»

open E

-- полный вес
wt : E → ℕ
wt x = w⁺ x + w⁻ x

-- молчание: ноль свидетельств. Оно же нейтраль ревизии.
silence : E
silence = ev 0 0

-- ревизия: сложение векторов (АЛГЕБРА_v0 §2.2)
_⊕_ : E → E → E
x ⊕ y = ev (w⁺ x + w⁺ y) (w⁻ x + w⁻ y)

infixl 6 _⊕_

-- ------------------------------------------------------------
-- 2. ⊕ — коммутативный моноид с нейтралью «молчание»
-- ------------------------------------------------------------

⊕-comm : ∀ x y → x ⊕ y ≡ y ⊕ x
⊕-comm x y = cong₂ ev (+-comm (w⁺ x) (w⁺ y)) (+-comm (w⁻ x) (w⁻ y))

⊕-assoc : ∀ x y z → (x ⊕ y) ⊕ z ≡ x ⊕ (y ⊕ z)
⊕-assoc x y z = cong₂ ev (+-assoc (w⁺ x) (w⁺ y) (w⁺ z))
                         (+-assoc (w⁻ x) (w⁻ y) (w⁻ z))

⊕-identityʳ : ∀ x → x ⊕ silence ≡ x
⊕-identityʳ x = cong₂ ev (+-identityʳ (w⁺ x)) (+-identityʳ (w⁻ x))

⊕-identityˡ : ∀ x → silence ⊕ x ≡ x
⊕-identityˡ x = refl

-- 🔴 и НЕ идемпотентна: вера накапливается.
--    (В паре с решёткой ⊓ из Preservation.agda, которая идемпотентна и только
--     деградирует. Два носителя ведут себя противоположно — это и есть
--     «вера накапливается, честность деградирует».)
⊕-not-idem : ¬ (∀ x → x ⊕ x ≡ x)
⊕-not-idem h with h (ev 1 0)
... | ()

-- ------------------------------------------------------------
-- 3. Масса веры без дробей
--    b(x) = w⁺/(wt x + k);  сравнение — перекрёстным умножением
-- ------------------------------------------------------------

module WithPrior (k : ℕ) (k>0 : 0 < k) where

  -- знаменатель массы веры
  den : E → ℕ
  den x = wt x + k

  -- b(x) < b(y)  ⟺  w⁺x · den y < w⁺y · den x
  _b<_ : E → E → Set
  x b< y = w⁺ x * den y < w⁺ y * den x

  _b≡_ : E → E → Set
  x b≡ y = w⁺ x * den y ≡ w⁺ y * den x

  -- частота свидетеля ниже массы веры:  f(e) = w⁺e/wt e  <  b(x) = w⁺x/den x
  _f<_ : E → E → Set
  e f< x = w⁺ e * den x < w⁺ x * wt e

  _f≡_ : E → E → Set
  e f≡ x = w⁺ e * den x ≡ w⁺ x * wt e

  -- ----------------------------------------------------------
  -- 3.1 Ключевое разложение знаменателя после ревизии
  -- ----------------------------------------------------------

  den-⊕ : ∀ x e → den (x ⊕ e) ≡ den x + wt e
  den-⊕ x e =
    begin
      (w⁺ x + w⁺ e) + (w⁻ x + w⁻ e) + k
    ≡⟨ cong (_+ k) (lemma (w⁺ x) (w⁺ e) (w⁻ x) (w⁻ e)) ⟩
      (w⁺ x + w⁻ x) + (w⁺ e + w⁻ e) + k
    ≡⟨ +-assoc (w⁺ x + w⁻ x) (w⁺ e + w⁻ e) k ⟩
      (w⁺ x + w⁻ x) + ((w⁺ e + w⁻ e) + k)
    ≡⟨ cong ((w⁺ x + w⁻ x) +_) (+-comm (w⁺ e + w⁻ e) k) ⟩
      (w⁺ x + w⁻ x) + (k + (w⁺ e + w⁻ e))
    ≡⟨ sym (+-assoc (w⁺ x + w⁻ x) k (w⁺ e + w⁻ e)) ⟩
      ((w⁺ x + w⁻ x) + k) + (w⁺ e + w⁻ e)
    ∎
    where
      open ≡-Reasoning
      lemma : ∀ a b c d → (a + b) + (c + d) ≡ (a + c) + (b + d)
      lemma a b c d =
        begin
          (a + b) + (c + d)   ≡⟨ +-assoc a b (c + d) ⟩
          a + (b + (c + d))   ≡⟨ cong (a +_) (sym (+-assoc b c d)) ⟩
          a + ((b + c) + d)   ≡⟨ cong (λ u → a + (u + d)) (+-comm b c) ⟩
          a + ((c + b) + d)   ≡⟨ cong (a +_) (+-assoc c b d) ⟩
          a + (c + (b + d))   ≡⟨ sym (+-assoc a c (b + d)) ⟩
          (a + c) + (b + d)   ∎
        where open ≡-Reasoning

  -- ----------------------------------------------------------
  -- 3.2 🔴 ТЕОРЕМА 5 (АЛГЕБРА_v0 §2.4), обе стороны
  --     b(x ⊕ e) < b(x)  ⟺  f(e) < b(x)
  -- ----------------------------------------------------------

  -- левая часть в развёрнутом виде
  private
    lhs : E → E → ℕ
    lhs x e = w⁺ (x ⊕ e) * den x

    rhs : E → E → ℕ
    rhs x e = w⁺ x * den (x ⊕ e)

    -- (a + e)·D = a·D + e·D
    expand-l : ∀ x e → lhs x e ≡ w⁺ x * den x + w⁺ e * den x
    expand-l x e = *-distribʳ-+ (den x) (w⁺ x) (w⁺ e)

    -- a·(D + we) = a·D + a·we
    expand-r : ∀ x e → rhs x e ≡ w⁺ x * den x + w⁺ x * wt e
    expand-r x e =
      trans (cong (w⁺ x *_) (den-⊕ x e))
            (*-distribˡ-+ (w⁺ x) (den x) (wt e))

  witness-drops : ∀ x e → (x ⊕ e) b< x → e f< x
  witness-drops x e p =
    +-cancelˡ-< (w⁺ x * den x) (w⁺ e * den x) (w⁺ x * wt e)
      (subst₂ _<_ (expand-l x e) (expand-r x e) p)

  witness-drops⁻¹ : ∀ x e → e f< x → (x ⊕ e) b< x
  witness-drops⁻¹ x e q =
    subst₂ _<_ (sym (expand-l x e)) (sym (expand-r x e))
      (+-monoʳ-< (w⁺ x * den x) q)

  -- неподвижная точка: свидетель с частотой РОВНО в массу веры ничего не меняет
  witness-fixed : ∀ x e → e f≡ x → (x ⊕ e) b≡ x
  witness-fixed x e q =
    trans (expand-l x e)
      (trans (cong (w⁺ x * den x +_) q)
             (sym (expand-r x e)))

  -- ----------------------------------------------------------
  -- 3.3 Зеркало для отзыва (РЕДУКЦИЯ_v0 §7.3)
  --     Отзыв роняет веру ⟺ частота отозванного была ВЫШЕ неё.
  --     Формулируется на том же тождестве, прочитанном справа налево:
  --     склад ДО отзыва есть (склад после) ⊕ (отозванный).
  -- ----------------------------------------------------------

  retract-drops : ∀ x e → x b< (x ⊕ e) → w⁺ x * wt e < w⁺ e * den x
  retract-drops x e p =
    +-cancelˡ-< (w⁺ x * den x) (w⁺ x * wt e) (w⁺ e * den x)
      (subst₂ _<_ (expand-r x e) (expand-l x e) p)

  -- ----------------------------------------------------------
  -- 3.4 Свидетельство «за» никогда не понижает веру
  --     (частота такого свидетеля равна 1, а масса веры всегда < 1
  --      из-за приора k — та самая граница Эйн-Соф)
  -- ----------------------------------------------------------

  -- граница Эйн-Соф в чистом виде: числитель строго меньше знаменателя,
  -- то есть масса веры никогда не достигает единицы
  b<1 : ∀ x → w⁺ x < den x
  b<1 x = ≤-trans (s≤s (m≤m+n (w⁺ x) (w⁻ x))) (m<m+n (wt x) k>0)

  support-never-drops : ∀ x n → 0 < n → ¬ ((x ⊕ ev n 0) b< x)
  support-never-drops x n n>0 p = <-irrefl refl (≤-trans got bound)
    where
      -- из теоремы 5: n · den x < w⁺x · n
      got : n * den x < n * w⁺ x
      got = subst₂ _<_ refl
              (trans (cong (w⁺ x *_) (+-identityʳ n)) (*-comm (w⁺ x) n))
              (witness-drops x (ev n 0) p)
      -- но w⁺x ≤ den x, значит n · w⁺x ≤ n · den x
      bound : n * w⁺ x ≤ n * den x
      bound = *-monoʳ-≤ n (<⇒≤ (b<1 x))
