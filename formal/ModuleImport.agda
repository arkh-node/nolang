{-# OPTIONS --safe #-}
-- ============================================================
--  nolang · ИМПОРТ МЕЖДУ МОДУЛЯМИ: условие корректности отображения решёток
--
--  ЗАЧЕМ.
--   Когда корпус становится импортируемой библиотекой, встаёт вопрос: чья решётка
--   главная? Ответ (записка Невис, §3): степень назначает ИСТОЧНИК, импортёр
--   объявляет отображение `φ` и может только понижать. Здесь доказано, ЧТО именно
--   обязано выполняться для `φ`, чтобы импорт не сломал уже доказанное.
--
--  ЧТО ДОКАЗАНО:
--   1. sound     : сохранение грани + сохранение дна ⇒ «отобразить, потом свернуть»
--                  равно «свернуть, потом отобразить» для ЛЮБОГО списка посылок.
--   2. necessary : обратное. Если равенство держится на всех списках, то `φ`
--                  сохраняет грань. То есть условие не достаточное, а РАВНОСИЛЬНОЕ:
--                  ослабить его нельзя, оно и есть предмет.
--   3. bottom-needed : дно тоже обязано сохраняться — иначе пустая посылочная база
--                  после импорта перестаёт быть ⊥, и возвращается «отмывание из ничего».
--   4. mono      : монотонность `φ` — СЛЕДСТВИЕ, а не отдельное требование.
--                  Требовать её в объявлении импорта не нужно.
--
--  ПОЧЕМУ ЭТО НЕ ПУСТОЕ ТРЕБОВАНИЕ.
--   Пока решётка линейна, грань есть минимум, и всякое монотонное отображение её
--   сохраняет — условие выполняется даром. Как только решётки становятся
--   ПРОИЗВЕДЕНИЯМИ (род источника × надёжность передачи), появляются несравнимые
--   элементы, и условие начинает резать: монотонности уже недостаточно.
--   То есть цена этой теоремы ровно та, что Тарантога заплатил, взяв произведение.
--
--  Самодостаточен: без stdlib, только Agda.Builtin. Проверяется под --safe.
-- ============================================================

module ModuleImport where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List using (List; []; _∷_)

sym : ∀ {A : Set} {x y : A} → x ≡ y → y ≡ x
sym refl = refl

trans : ∀ {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
trans refl refl = refl

cong : ∀ {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

cong₂ : ∀ {A B C : Set} (f : A → B → C) {x y : A} {u v : B}
      → x ≡ y → u ≡ v → f x u ≡ f y v
cong₂ f refl refl = refl

-- ------------------------------------------------------------
-- Решётка степеней (та же запись, что в Preservation.agda)
-- ------------------------------------------------------------

record MeetSemilattice : Set₁ where
  field
    G        : Set
    ⊥ᴳ       : G
    _⊓_      : G → G → G
    ⊓-comm   : ∀ a b   → (a ⊓ b) ≡ (b ⊓ a)
    ⊓-assoc  : ∀ a b c → ((a ⊓ b) ⊓ c) ≡ (a ⊓ (b ⊓ c))
    ⊓-idem   : ∀ a     → (a ⊓ a) ≡ a
    ⊥-absorb : ∀ a     → (⊥ᴳ ⊓ a) ≡ ⊥ᴳ

-- свёртка посылок: та же, что у проверяющего (n = 0 даёт ⊥, а не верх решётки)
module Fold (L : MeetSemilattice) where
  open MeetSemilattice L public

  meet : List G → G
  meet []          = ⊥ᴳ
  meet (x ∷ [])    = x
  meet (x ∷ y ∷ r) = x ⊓ meet (y ∷ r)

-- ------------------------------------------------------------
-- Импорт: отображение решётки источника в решётку импортёра
-- ------------------------------------------------------------

module Import (Src Dst : MeetSemilattice) (φ : MeetSemilattice.G Src → MeetSemilattice.G Dst) where

  private
    module S = Fold Src
    module D = Fold Dst

  map : List S.G → List D.G
  map []       = []
  map (x ∷ xs) = φ x ∷ map xs

  -- два условия, которые объявление импорта обязано предъявить
  Preserves-⊓ : Set
  Preserves-⊓ = ∀ a b → φ (a S.⊓ b) ≡ (φ a D.⊓ φ b)

  Preserves-⊥ : Set
  Preserves-⊥ = φ S.⊥ᴳ ≡ D.⊥ᴳ

  -- ----------------------------------------------------------
  -- 1. ДОСТАТОЧНОСТЬ
  -- ----------------------------------------------------------

  sound : Preserves-⊓ → Preserves-⊥
        → ∀ (ps : List S.G) → φ (S.meet ps) ≡ D.meet (map ps)
  sound p⊓ p⊥ []           = p⊥
  sound p⊓ p⊥ (x ∷ [])     = refl
  sound p⊓ p⊥ (x ∷ y ∷ r)  =
    trans (p⊓ x (S.meet (y ∷ r)))
          (cong (λ u → φ x D.⊓ u) (sound p⊓ p⊥ (y ∷ r)))

  -- ----------------------------------------------------------
  -- 2. НЕОБХОДИМОСТЬ — условие равносильно, а не просто достаточно
  -- ----------------------------------------------------------

  necessary : (∀ (ps : List S.G) → φ (S.meet ps) ≡ D.meet (map ps)) → Preserves-⊓
  necessary h a b = h (a ∷ b ∷ [])

  -- 3. и дно обязано сохраняться — иначе пустая база после импорта перестаёт быть ⊥
  bottom-needed : (∀ (ps : List S.G) → φ (S.meet ps) ≡ D.meet (map ps)) → Preserves-⊥
  bottom-needed h = h []

  -- ----------------------------------------------------------
  -- 4. МОНОТОННОСТЬ — следствие, а не отдельное требование
  --    (порядок задан гранью: a ⊑ b означает a ⊓ b ≡ a)
  -- ----------------------------------------------------------

  _⊑ˢ_ : S.G → S.G → Set
  a ⊑ˢ b = (a S.⊓ b) ≡ a

  _⊑ᵈ_ : D.G → D.G → Set
  a ⊑ᵈ b = (a D.⊓ b) ≡ a

  mono : Preserves-⊓ → ∀ {a b} → a ⊑ˢ b → φ a ⊑ᵈ φ b
  mono p⊓ {a} {b} le = trans (sym (p⊓ a b)) (cong φ le)

-- ------------------------------------------------------------
-- 5. Композиция импортов: два корректных импорта дают корректный
--    (нужно, когда корпус тянет корпус, который тянет корпус)
-- ------------------------------------------------------------

module Compose (A B C : MeetSemilattice)
               (φ : MeetSemilattice.G A → MeetSemilattice.G B)
               (ψ : MeetSemilattice.G B → MeetSemilattice.G C) where

  private
    module AB = Import A B φ
    module BC = Import B C ψ
    module AC = Import A C (λ x → ψ (φ x))
    module MA = MeetSemilattice A
    module MC = MeetSemilattice C

  compose-⊓ : AB.Preserves-⊓ → BC.Preserves-⊓ → AC.Preserves-⊓
  compose-⊓ f g a b = trans (cong ψ (f a b)) (g (φ a) (φ b))

  compose-⊥ : AB.Preserves-⊥ → BC.Preserves-⊥ → AC.Preserves-⊥
  compose-⊥ f g = trans (cong ψ f) g
