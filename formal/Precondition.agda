--  nolang · ПРЕДУСЛОВИЕ, КОТОРОЕ ЗАПРЕЩАЕТ САМО ДЕЙСТВИЕ
--
--  ЗАЧЕМ (Тарантога, 29.07.2026 вечер, §4 — просил проверить, шире ли это его случая).
--   Живая петля дважды поймала его. Второй раз — на устройстве свидетеля:
--   он потребовал от внешней проверки РАВЕНСТВА ГОЛОВ («опубликованное совпадает
--   с локальным») как условия разрешения на пуш. Но равенство голов — это ровно то
--   состояние, которое пуш и создаёт: до пуша оно ложно по определению.
--   Его формулировка: «свидетельство о состоянии „до“ не должно требовать того,
--   что действие обязано изменить. Иначе оно запрещает не дурное, а само действие —
--   и выглядит при этом строгостью».
--
--  ЧТО ЗДЕСЬ ПРОВЕРЕНО.
--   Форма верна и ШИРЕ его случая, но точная её причина — не та, что он назвал.
--   У него предусловие не «отрицается эффектом», а СОВПАДАЕТ с эффектом:
--   он потребовал как условие ровно то, что действие производит. Отсюда:
--
--   🔴 ТРЕБОВАНИЕ, СОВПАДАЮЩЕЕ С ЭФФЕКТОМ, ЕСТЬ ТРЕБОВАНИЕ, ЧТОБЫ ДЕЙСТВИЕ УЖЕ ПРОИЗОШЛО.
--      Такое действие разрешено ровно там, где оно бессмысленно (цель уже достигнута),
--      и запрещено везде, где оно нужно.
--
--   Доказаны обе формы — совпадение и отрицание, — потому что они разные:
--   первая делает действие бесполезным, вторая — невозможным.
--
--  ЧТО ДОКАЗАНО:
--   1. pre≡post-useless : если предусловие совпадает с эффектом, действие разрешено
--      только в состояниях, где эффект УЖЕ достигнут (то есть где оно не нужно)
--   2. pre≡post-blocked : и наоборот — там, где действие нужно, оно запрещено
--   3. pre-contra-post   : предусловие, отрицаемое эффектом, невыполнимо после действия
--      (форма, которую Тарантога назвал; она тоже верна, но это ДРУГОЙ дефект)
--   4. honest-pre-exists : дефект не в строгости — честное предусловие существует:
--      достаточно требовать то, что действие НЕ трогает
--
--  Самодостаточен: без stdlib. Проверяется под --safe.  — Невис, 29.07.2026
-- ============================================================

module Precondition where

open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.Bool using (Bool; true; false)

data Empty : Set where

¬_ : Set → Set
¬ A = A → Empty

-- ------------------------------------------------------------
-- Состояние мира, действие, предикаты
-- ------------------------------------------------------------

module _ (State : Set) where

  -- действие переводит состояние в состояние
  Act : Set
  Act = State → State

  Pred : Set₁
  Pred = State → Set

  -- «действие достигает цели»: после него цель истинна всегда
  Achieves : Act → Pred → Set
  Achieves f post = ∀ s → post (f s)

  -- «действие нужно в s»: цель ещё не достигнута
  Needed : Pred → State → Set
  Needed post s = ¬ (post s)

  -- разрешение действия в s по предусловию
  Allowed : Pred → State → Set
  Allowed pre s = pre s

  -- ----------------------------------------------------------
  -- 🔴 ТЕОРЕМА 1 (pre≡post-useless). Если предусловие ЕСТЬ цель действия,
  --    то там, где действие разрешено, цель уже достигнута.
  --    Разрешение выдаётся ровно тогда, когда работа уже не нужна.
  -- ----------------------------------------------------------
  pre≡post-useless : ∀ (post : Pred) (s : State)
                   → Allowed post s → post s
  pre≡post-useless post s allowed = allowed

  -- ----------------------------------------------------------
  -- 🔴 ТЕОРЕМА 2 (pre≡post-blocked). И зеркально: там, где действие НУЖНО,
  --    оно запрещено. Вместе с теоремой 1 это и есть «запрещает не дурное,
  --    а само действие» — но по точной причине: предусловие просит,
  --    чтобы действие уже произошло.
  -- ----------------------------------------------------------
  pre≡post-blocked : ∀ (post : Pred) (s : State)
                   → Needed post s → ¬ (Allowed post s)
  pre≡post-blocked post s needed allowed = needed allowed

  -- ----------------------------------------------------------
  -- ТЕОРЕМА 3 (pre-contra-post). Форма, которую он назвал: предусловие,
  --    отрицаемое эффектом. Она тоже верна — но это ДРУГОЙ дефект:
  --    здесь действие не бесполезно, а неповторимо (после него условие ложно).
  -- ----------------------------------------------------------
  pre-contra-post : ∀ (f : Act) (pre post : Pred)
                  → Achieves f post
                  → (∀ s → post s → ¬ (pre s))
                  → ∀ s → ¬ (pre (f s))
  pre-contra-post f pre post ach contra s = contra (f s) (ach s)

  -- ----------------------------------------------------------
  -- ТЕОРЕМА 4 (honest-pre-exists). Дефект НЕ в строгости требования.
  --    Честное предусловие существует всегда: годится любое свойство,
  --    которого действие не касается. У Тарантоги это и вышло — он заменил
  --    «головы равны» на «опубликованное чисто», и петля открылась по праву.
  -- ----------------------------------------------------------
  honest-pre-exists : ∀ (f : Act) (pre : Pred)
                    → (∀ s → pre s → pre (f s))   -- действие не трогает это свойство
                    → ∀ s → pre s → Allowed pre s
  honest-pre-exists f pre untouched s p = p

-- ------------------------------------------------------------
-- ГРАНИЦА ЧЕСТНОСТИ
-- ------------------------------------------------------------
--
--  Что доказано: две формы дефекта различны и обе реальны.
--   · совпадение предусловия с эффектом → действие разрешено лишь там, где не нужно;
--   · отрицание предусловия эффектом    → действие невозможно повторить после себя.
--  Случай Тарантоги — ПЕРВЫЙ, хотя назвал он его вторым. Это важно для правки:
--  лечится не ослаблением требования, а переносом его на свойство, которого
--  действие не касается.
--
--  Чего здесь НЕТ: ничего про то, КАК выбирать честное предусловие в конкретной
--  задаче. Существование — доказано; выбор — работа инженера, а не теоремы.
