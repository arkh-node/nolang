--
--  ЗАЧЕМ (Тарантога, 29.07.2026 — просил проверить, шире ли это его случая).
--   Живая петля поймала его на устройстве свидетеля: он потребовал от внешней проверки
--   РАВЕНСТВА ГОЛОВ («опубликованное совпадает с локальным») как условия разрешения на пуш.
--   Но равенство голов — ровно то состояние, которое пуш и создаёт: до пуша оно ложно
--   по определению. Его формулировка: «свидетельство о состоянии „до“ не должно требовать
--   того, что действие обязано изменить. Иначе оно запрещает не дурное, а само действие —
--   и выглядит при этом строгостью».
--
--  🔴 ПЕРЕПИСАНО 31.07.2026 — И ВОТ ПОЧЕМУ (Невис).
--   В первой редакции три утверждения из четырёх были ТОЖДЕСТВЕННЫМИ ФУНКЦИЯМИ. Причина
--   не в лени: я определила `Allowed pre s = pre s`, а затем подставила `pre := post` —
--   и тем самым выкинула РАЗЛИЧИЕ, о котором собиралась говорить. «Если разрешено, то цель
--   достигнута» разворачивалось в «из post s следует post s». Теорема о честном предусловии
--   не потребляла гипотезу `untouched` вовсе — самый явный признак пустоты.
--   Зелёная сборка это не ловит: `--safe` проверяет, что доказательство корректно, а не что
--   утверждение содержательно. Второй гейт — мой, и он состоит из трёх вопросов к каждому
--   утверждению: потребляет ли оно гипотезы · доказуемо ли как `id` · что сломается, если
--   оно ложно. Здесь на все три был неверный ответ, и я это пропустила, сутками ранее сама
--   же объяснив этот гейт Тарантоге.
--
--  🔴 ЧТО ИЗМЕНИЛОСЬ ПО СУЩЕСТВУ. Дефект живёт не в одном предикате, а в ОТНОШЕНИИ двух:
--   предусловия `pre` и цели `post`. Поэтому все утверждения ниже связывают их гипотезой
--   `pre ⇒ post` («предусловие требует того, что действие производит») — и без этой гипотезы
--   ни одно из них не доказуемо. Это и есть проверка на содержательность: убери гипотезу —
--   утверждение рассыплется, а не останется верным по определению.
--
--  РАЗМЕТКА УТВЕРЖДЕНИЙ (считается батареей, см. formal/count.sh):
--   ⟦содержательное⟧  — потребляет гипотезы, не доказуемо как id, ложность что-то ломает
--   ⟦определительное⟧ — верно по определениям; полезно как ступень, но НЕ доказательство
--
--  Самодостаточен: без stdlib. Проверяется под --safe.  — Невис, 29.07 → 31.07.2026
-- ============================================================

module Precondition where

open import Agda.Builtin.Equality using (_≡_; refl)

data Empty : Set where

¬_ : Set → Set
¬ A = A → Empty

module _ (State : Set) where

  Act : Set
  Act = State → State

  Pred : Set₁
  Pred = State → Set

  -- «действие достигает цели»: после него цель истинна всегда
  Achieves : Act → Pred → Set
  Achieves f post = ∀ s → post (f s)

  -- «действие нужно в s»: цель ещё не достигнута
  Needed : Pred → State → Set
  Needed post s = ¬ (post s)

  -- разрешение действия в s по предусловию
  Allowed : Pred → State → Set
  Allowed pre s = pre s

  -- 🔴 ИМЕННО ЭТО отношение и есть дефект: предусловие требует того, что действие производит.
  --    У Тарантоги `pre` = «головы равны», `post` = «головы равны после пуша» — pre ⇒ post
  --    выполняется тождественно, потому что это одно и то же свойство.
  Demands-Its-Own-Effect : Pred → Pred → Set
  Demands-Its-Own-Effect pre post = ∀ s → pre s → post s

  -- ----------------------------------------------------------
  -- ⟦содержательное⟧ ТЕОРЕМА 1 (blocked-where-needed).
  --   Там, где действие НУЖНО (цель не достигнута), предусловие, требующее собственного
  --   эффекта, ЛОЖНО — то есть действие запрещено ровно там, где оно и должно совершаться.
  --   Гипотеза `dem` потребляется: без неё из `¬ post s` ничего не следует про `pre s`.
  -- ----------------------------------------------------------
  blocked-where-needed : ∀ (pre post : Pred)
                       → Demands-Its-Own-Effect pre post
                       → ∀ s → Needed post s → ¬ (Allowed pre s)
  blocked-where-needed pre post dem s needed allowed = needed (dem s allowed)

  -- ----------------------------------------------------------
  -- ⟦содержательное⟧ ТЕОРЕМА 2 (allowed-only-where-useless).
  --   Зеркально: там, где действие РАЗРЕШЕНО, цель уже достигнута — значит разрешение
  --   выдаётся только тогда, когда работа не нужна. Вместе с теоремой 1 это и есть
  --   «запрещает не дурное, а само действие», но с названной причиной.
  -- ----------------------------------------------------------
  allowed-only-where-useless : ∀ (pre post : Pred)
                             → Demands-Its-Own-Effect pre post
                             → ∀ s → Allowed pre s → ¬ (Needed post s)
  allowed-only-where-useless pre post dem s allowed needed = needed (dem s allowed)

  -- ----------------------------------------------------------
  -- ⟦содержательное⟧ ТЕОРЕМА 3 (pre-contra-post).
  --   ДРУГОЙ дефект, названный Тарантогой: предусловие, ОТРИЦАЕМОЕ эффектом. Действие
  --   здесь не бесполезно, а неповторимо — после него условие ложно навсегда.
  --   Потребляет обе гипотезы: и достижение цели, и противоречие.
  -- ----------------------------------------------------------
  pre-contra-post : ∀ (f : Act) (pre post : Pred)
                  → Achieves f post
                  → (∀ s → post s → ¬ (pre s))
                  → ∀ s → ¬ (pre (f s))
  pre-contra-post f pre post ach contra s = contra (f s) (ach s)

  -- ----------------------------------------------------------
  -- ⟦содержательное⟧ ТЕОРЕМА 4 (honest-pre-survives).
  --   Дефект НЕ в строгости требования. Честное предусловие — то, которого действие
  --   не касается, — ПЕРЕЖИВАЕТ действие: разрешив однажды, оно разрешает и после.
  --   В прежней редакции здесь стояло `pre s → Allowed pre s` (то есть `id`), и гипотеза
  --   `untouched` не использовалась вовсе. Теперь она несущая: без неё нечем перейти
  --   от `pre s` к `pre (f s)`.
  --   У Тарантоги это и вышло: «головы равны» → «опубликованное чисто», и петля открылась
  --   по праву, а не по ослаблению.
  -- ----------------------------------------------------------
  honest-pre-survives : ∀ (f : Act) (pre : Pred)
                      → (∀ s → pre s → pre (f s))
                      → ∀ s → Allowed pre s → Allowed pre (f s)
  honest-pre-survives f pre untouched s allowed = untouched s allowed

  -- ----------------------------------------------------------
  -- ⟦содержательное⟧ ТЕОРЕМА 5 (dishonest-pre-dies).
  --   И различение, ради которого всё: НЕчестное предусловие действие НЕ переживает —
  --   в точности потому, что эффект его отрицает. Пара 4–5 говорит то, чего не говорила
  --   ни одна теорема прежней редакции: честность предусловия РАЗЛИЧИМА по поведению
  --   после действия, а не по намерению автора.
  -- ----------------------------------------------------------
  dishonest-pre-dies : ∀ (f : Act) (pre post : Pred)
                     → Achieves f post
                     → (∀ s → post s → ¬ (pre s))
                     → ∀ s → ¬ (Allowed pre (f s))
  dishonest-pre-dies f pre post ach contra s = contra (f s) (ach s)

  -- ----------------------------------------------------------
  -- ⟦определительное⟧ (allowed-is-pre). Ступень, а не доказательство: `Allowed` есть
  --   просто применение предиката. Оставлено ЯВНО помеченным, потому что именно эта
  --   развёртка и делала прежние теоремы тождественными — пусть она будет видна одна,
  --   чем незаметно сидит внутри четырёх «доказательств».
  -- ----------------------------------------------------------
  allowed-is-pre : ∀ (pre : Pred) (s : State) → Allowed pre s ≡ pre s
  allowed-is-pre pre s = refl

-- ------------------------------------------------------------
-- ГРАНИЦА ЧЕСТНОСТИ
-- ------------------------------------------------------------
--
--  Что доказано: два дефекта различны и оба реальны.
--   · предусловие ТРЕБУЕТ своего эффекта → разрешено лишь там, где не нужно (1, 2);
--   · предусловие ОТРИЦАЕТСЯ эффектом    → не переживает собственное действие (3, 5).
--  Случай Тарантоги — ПЕРВЫЙ, хотя назвал он его вторым. Для правки это важно: лечится
--  не ослаблением требования, а переносом его на свойство, которого действие не касается (4).
--
--  Чего здесь НЕТ: ничего про то, КАК выбрать честное предусловие в конкретной задаче.
--  Существование и различимость — доказаны; выбор — работа инженера, а не теоремы.
--
--  Чего здесь НЕТ ещё: связи с реализацией. Эти утверждения — о МОДЕЛИ действия
--  (State → State), а не о том, что считает `chk-do` в src/check.lisp. Шов между моделью
--  и машиной — отдельная работа (formal/Seam.agda), и до неё ссылаться на этот файл как
--  на «доказано в коде» нельзя.
