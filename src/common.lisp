;;;; nolang src — common. ОБЩИЙ СЛОЙ трёх модулей: решётка, разбор предложений, словарь форм.
;;;;
;;;; 🔴 О ЖАНРЕ (уточнено 28.07 словом Алексея). nolang — ПРОТОКОЛ: правила о том, когда агенту
;;;; позволено действовать и за что он обязан отчитаться. Язык — СРЕДСТВО, чтобы протокол
;;;; проверялся компилятором, а не соблюдался по доброй воле. Имя читается двояко, и оба чтения
;;;; верны: `NOL + lang` и `no lang` — программ в обычном смысле здесь не пишут: ни ветвления,
;;;; ни рекурсии, ни функций. Пишут ЗАПИСЬ. Дальше слово «язык» означает средство, а не жанр.
;;;;
;;;; 🔴 ЧТО СЮДА МОЖНО, А ЧТО НЕЛЬЗЯ — и это не вкус, а условие доказательства.
;;;; Невис в formal/Preservation.agda специально развела проверяющий и машину в ДВА РАЗНЫХ
;;;; алгоритма (свёртка по посылкам справа vs накопление склада слева) и вывела их равенство
;;;; из ассоциативности ⊓. В этом сила: дифференциальный тест ловит расхождение двух реализаций,
;;;; но НЕ ловит общую ошибку обеих — а доказательство ловит.
;;;;   МОЖНО в общий слой: то, что и в Agda общее — сама РЕШЁТКА, разбор синтаксиса, словарь.
;;;;   НЕЛЬЗЯ: логику свёртки. `chk-claim` и `red-claim` обязаны остаться РАЗНЫМИ.
;;;; Слить их — значит своими руками обнулить теорему.

(load (merge-pathnames "evidence.lisp" *load-pathname*))

;;; ── РЕШЁТКА СТЕПЕНЕЙ: объявляется программой; ЛИНЕЙНАЯ или ПРОИЗВЕДЕНИЕ ───────
;;; 🔴 Почему произведение нужно уже сейчас (совет Невис 28.07, §5): правила вывода зависят
;;; ТОЛЬКО от ⊓ — значит цена разрешить произведение сегодня равна нулю, а цена зашить цепочку
;;; и мигрировать потом — реальная. Пусть язык умеет больше, чем наш корпус.
;;; Живой случай, который в линейный порядок не лезет и это НОРМА источниковедения:
;;; `[строго] из спорной рукописи` против `[традиция] из надёжной`. И готовый образец из
;;; реальной практики — кодекс Адмиралтейства (система НАТО): надёжность источника A–F ×
;;; достоверность сведения 1–6, оценка вида «B2». Это ровно произведение решёток.
;;;
;;; 🔴 ПОРЯДОК СТАНОВИТСЯ ЧАСТИЧНЫМ. Прежняя `g-meet` была `(if (g<= a b) a b)` — это молча
;;; предполагает ЛИНЕЙНОСТЬ и на произведении даёт неверный ответ для несравнимых. Теперь
;;; нижняя грань берётся покомпонентно, а `g<=` может быть ложна в обе стороны.

;; Описатель решётки: (:linear порядок-снизу-вверх) | (:product часть₁ часть₂ …)
;; Степень: ключ (линейная) | список степеней (произведение).
(defparameter *prelude-lattice*
  '(:linear (:silence :obraz :tradition :strogo))
  "Прелюдия: лестница честности источника — от молчания до строгого свидетельства.")
(defparameter *prelude-alias*
  '(("молчание" . :silence)  ("silence" . :silence)   ("⊥" . :silence)
    ("образ" . :obraz)       ("image" . :obraz)
    ("традиция" . :tradition)("tradition" . :tradition)
    ("строго" . :strogo)     ("strict" . :strogo)))
(defparameter *prelude-print*
  '((:silence . "⊥ молчание") (:obraz . "образ")
    (:tradition . "традиция") (:strogo . "строго")))

(defvar *lattice* *prelude-lattice*)
(defvar *grade-alias* *prelude-alias*)
(defvar *grade-print* *prelude-print*)
(defvar *lattices* '() "Именованные решётки программы: имя → описатель.")

;;; ── ИСТОЧНИКИ: откуда знание, и какой степени оно МОЖЕТ БЫТЬ ────────────────
;;; 🔴 ЗАЧЕМ. До 05.08.2026 степень свидетеля заявлял автор программы, а `source` служил
;;; только ключом дедупликации корней. Свидетель был обязан назвать источник — но источник
;;; ничего не значил: `witness x : machine_verified source my_imagination` типизировалось.
;;; Подъём степени ВНУТРИ вывода был невыразим, а ложь НА ВХОДЕ выразима идеально.
;;; Пока `.nol` писал человек — условность. Когда декларации пишет сам агент — дыра.
;;;
;;; Решение — то же, что уже принято для модулей этажом выше (см. ниже, ModuleImport):
;;; **степень назначает источник, объявляющий может только понижать**. Источник живёт в
;;; ПРЕЛЮДИИ, потому что он мера, а не замер: режет не авторство, а момент.
(defvar *sources* '()
  "Объявленные источники: имя → (:grade степень :from предок :fingerprint строка :says строка).
   Степень NIL означает дно решётки — знание без объявленного происхождения ничего не весит.")

(defun lat-linear-p (l) (eq (first l) :linear))
(defun lat-order (l) (second l))
(defun lat-parts (l) (rest l))

(defun g-bot-of (l)
  (if (lat-linear-p l) (first (lat-order l)) (mapcar #'g-bot-of (lat-parts l))))
(defun g-top-of (l)
  (if (lat-linear-p l) (car (last (lat-order l))) (mapcar #'g-top-of (lat-parts l))))
(defun g-bot () (g-bot-of *lattice*))
(defun g-top () (g-top-of *lattice*))

(defun g-shape-ok-p (l g)
  "Совпадает ли ФОРМА степени с формой решётки: одиночная для линейной, кортеж для произведения."
  (if (lat-linear-p l)
      (and (not (consp g)) (position g (lat-order l)))
      (and (consp g) (= (length g) (length (lat-parts l)))
           (every #'g-shape-ok-p (lat-parts l) g))))

(defun g<=-in (l a b)
  "Частичный порядок. На произведении — покомпонентно, и может быть ложен в обе стороны.
   🔴 Несовпадение ФОРМЫ (одиночная степень против произведения) — не крах, а `nil`:
   сравнивать их бессмысленно, и слой обязан сказать это словами, а не упасть.
   Поймано живым примером 28.07: `grade >= традиция` на решётке из пар."
  (if (or (not (g-shape-ok-p l a)) (not (g-shape-ok-p l b)))
      nil
      (if (lat-linear-p l)
          (<= (position a (lat-order l)) (position b (lat-order l)))
          (every #'g<=-in (lat-parts l) a b))))
(defun g<= (a b) (g<=-in *lattice* a b))

(defun g-shape-error (g)
  "Внятное объяснение, когда форма степени не подошла к решётке."
  (format nil "степень ~a не той формы, что действующая решётка.~%  ~
               На решётке-произведении степень пишется кортежем — `(традиция, надёжная)`, ~
               а не одним именем: сравнивать пару с одиночкой нечем."
          (if (consp g) (format nil "(~{~a~^, ~})" g) g)))

(defun g-meet-in (l a b)
  "НИЖНЯЯ ГРАНЬ. На линейной — минимум; на произведении — покомпонентно.
   🔴 Нельзя писать (if (g<= a b) a b): для несравнимых это вернуло бы одну из них,
   то есть степень ВЫШЕ настоящей нижней грани — отмывание через дырявую решётку.

   🔴 ТОТАЛЬНА ПО ПОСТРОЕНИЮ (29.07, находка харнесса оракула). Если форма степени не
   совпала с формой решётки — это НЕ элемент решётки, и грани у него нет. Прежде здесь
   падал `position` с `nil`, то есть пользователь получал бэктрейс вместо диагностики.
   Отвечаем ДНОМ: единственное безопасное направление — заниженное, никогда не завышенное.
   Сама же диагностика даётся там, где степень прочитана (`chk-witness`), а не здесь:
   слой грани не знает, чья это степень и как её назвать в сообщении."
  (cond
    ((or (not (g-shape-ok-p l a)) (not (g-shape-ok-p l b))) (g-bot-of l))
    ((lat-linear-p l)
     (if (<= (position a (lat-order l)) (position b (lat-order l))) a b))
    (t (mapcar #'g-meet-in (lat-parts l) a b))))
(defun g-meet (a b) (g-meet-in *lattice* a b))

(defun g-comparable-p (a b) (or (g<= a b) (g<= b a)))

(defun lat-elements (l)
  "ВСЕ элементы решётки. На линейной — её порядок; на произведении — декартово произведение
   элементов частей. 🔴 Конечность решётки — не удобство, а условие: ровно на ней держится
   проверка φ ПЕРЕБОРОМ (см. chk-import). Бесконечную решётку пришлось бы проверять
   доказательством, а доказательство от автора модуля мы потребовать не можем."
  (if (lat-linear-p l)
      (copy-list (lat-order l))
      (labels ((cart (sets)
                 (if (null sets)
                     (list '())
                     (let ((tails (cart (rest sets))))
                       (loop for x in (first sets)
                             append (loop for tl in tails collect (cons x tl)))))))
        (cart (mapcar #'lat-elements (lat-parts l))))))

(defun g-ru (g)
  (if (consp g)
      (format nil "~{~a~^·~}" (mapcar #'g-ru g))
      (or (cdr (assoc g *grade-print*)) (string-downcase (string g)))))

(defun parse-grade (s)
  "Имя степени → степень действующей решётки. Список имён → степень произведения."
  (if (consp s)
      (let ((parts (mapcar #'parse-grade s)))
        (and (notany #'null parts) parts))
      (cdr (assoc (string-downcase (string s)) *grade-alias* :test #'string=))))

;;; 🔴 ГОРИЗОНТ `k` — СВОЙСТВО КОРПУСА, А НЕ КОНСТАНТА ЯЗЫКА (разбор Невис, 29.07).
;;; `c = w/(w+k)` читается как доля: СОБРАННОЕ ОТ СОБИРАЕМОГО. Значит `k` есть оценка того,
;;; сколько свидетельств ещё МОЖЕТ появиться: для замкнутого корпуса (двадцать испытаний, из
;;; них десять опубликованы) он мал и известен; для открытого («что вообще пишут о лекарстве»)
;;; велик. Это утверждение о мире — ровно как решётка, — и потому объявляется программой.
;;; 🔴 Родство с θ ЛОЖНОЕ и опасное: θ отвечает «стоит ли действовать» (о последствиях, отсюда
;;; вывод из Эрроу–Фишера), `k` — «много ли я вообще могу узнать» (о полноте сбора). Свести их
;;; значило бы сделать уверенность функцией от ставки: чем страшнее ошибка, тем менее уверен —
;;; а это не эпистемология, а трусость, записанная в носитель.
(defparameter *prelude-horizon* 1.0
  "Умолчание горизонта. Именно УМОЛЧАНИЕ, а не истина: программа объявляет свой `horizon`.")

(defmacro with-prelude (&body body)
  "Решётка и горизонт живут ровно одну программу — прелюдия не пачкается объявлениями."
  `(let ((*k* *prelude-horizon*)
         (*lattice* *prelude-lattice*)
         (*grade-alias* *prelude-alias*)
         (*grade-print* *prelude-print*)
         (*lattices* '())
         (*sources* '())
         (*imports* '()))
     ,@body))

;;; ── МОДУЛИ: чужой корпус со СВОЕЙ шкалой ────────────────────────────────────
;;; 🔴 ЧТО РЕШЕНО ЗДЕСЬ И ПОЧЕМУ ИМЕННО ТАК (записка Невис 29.07 + теорема ModuleImport.agda).
;;;
;;; 1. Степень назначает ИСТОЧНИК, импортёр объявляет отображение `φ` и может только понижать.
;;;    Обратное («импортёр переоценивает чужие свидетельства по-своему») и есть отмывание,
;;;    заходящее через границу модуля.
;;; 2. 🔴 `φ` ЗАДАЁТСЯ ТАБЛИЦЕЙ, А НЕ ВЫРАЖЕНИЕМ. Стоит пустить сюда выражение — автор
;;;    вернёт себе арифметику с той стороны, где её не ловят ни решётка, ни гейт
;;;    (та же граница языка и рантайма, что в ГРАММАТИКА §5-bis). Таблица конечна,
;;;    перебираема и читается глазами.
;;; 3. 🔴 ЧТО ИМЕННО ОБЯЗАНА СОХРАНЯТЬ `φ` — не наш вкус, а ДОКАЗАННОЕ:
;;;    `φ(a ⊓ b) = φ(a) ⊓ φ(b)` и `φ(⊥ˢ) = ⊥ᵈ`. Невис доказала (formal/ModuleImport.agda),
;;;    что первое условие не достаточное, а РАВНОСИЛЬНОЕ: если «отобразить, потом свернуть»
;;;    совпадает со «свернуть, потом отобразить» на всех списках посылок, то грань сохраняется.
;;;    Ослабить нельзя — оно и есть предмет. Дно обязано сохраняться отдельно, иначе пустая
;;;    посылочная база после импорта перестаёт быть ⊥ и возвращается отмывание из ничего.
;;;    Монотонность требовать НЕ надо: она следствие (`mono`).
;;; 4. 🔴 ЦЕНА, КОТОРУЮ НАДО НАЗВАТЬ ВСЛУХ (её же слова): пока решётка ЛИНЕЙНА, условие
;;;    выполняется даром — в линейном порядке грань есть минимум, и всякое монотонное
;;;    отображение её сохраняет. Условие начинает резать ровно тогда, когда решётки стали
;;;    ПРОИЗВЕДЕНИЯМИ. Это цена за произведение, а не подарок.
;;; 5. 🔴 КОРЕНЬ ГРАНИЦУ ПРОХОДИТ НЕИЗМЕННЫМ. `φ` трогает степень и только её. Иначе
;;;    один и тот же источник, пришедший двумя путями, перестал бы узнаваться, и свёртка
;;;    по корням (95_roots) сложила бы его как двух независимых — отмывание через родословную,
;;;    только теперь межмодульное.
(defvar *imports* '()
  "Имя модуля → (:lattice описатель-решётки-источника :phi таблица ключ→ключ).")

(defun module-of (name) (cdr (assoc name *imports*)))
(defun module-lattice (m) (getf m :lattice))
(defun module-phi (m) (getf m :phi))

(defun phi-apply (m g)
  "φ(g): степень в шкале источника → степень в шкале импортёра. nil — φ на ней не определена.
   :test #'equal, а не eql: степень произведения — СПИСОК ключей."
  (cdr (assoc g (module-phi m) :test #'equal)))

(defun grade-through-module (mod raw)
  "Степень свидетеля из модуля MOD, приведённая к решётке импортёра.
   → (values степень причина-отказа). Причина возвращается, а не печатается: проверяющий
   её напечатает, машина промолчит — диагностика живёт в одном слое, как и вся прочая."
  (let ((m (module-of mod)))
    (cond ((null m)  (values nil :unknown-module))
          ((null raw) (values nil :unknown-grade))
          ((not (g-shape-ok-p (module-lattice m) raw)) (values nil :foreign-grade))
          (t (let ((v (phi-apply m raw)))
               (if v (values v nil) (values nil :phi-undefined)))))))

;;; ── МАССА ВЕРЫ: одна формула на весь язык ───────────────────────────────────
;;; 🔴 Была в двух местах (аудит, находка 4). Это ЯДРО гейта: расхождение здесь означало бы,
;;; что проверяющий и машина по-разному решают, позволено ли необратимое.
(defun belief (f c) (and f c (* f c)))

;;; ── РАЗБОР ПРЕДЛОЖЕНИЙ ФОРМЫ ────────────────────────────────────────────────
(defun head-of (form) (string-downcase (string (first form))))

(defun clause (form head)
  "Достать предложение (head …) из хвоста формы. → список аргументов или :нет."
  ;; string-EQUAL, не string=: читатель Лиспа поднимает регистр, (from …) читается как FROM.
  (let ((cl (find-if (lambda (x) (and (consp x) (symbolp (car x))
                                      (string-equal (string (car x)) head)))
                     form)))
    (if cl (rest cl) :нет)))

(defun clause* (form head)
  "То же, но пустой список вместо :нет — так удобнее свёрткам."
  (let ((x (clause form head))) (if (eq x :нет) '() x)))

(defun kw (form key &optional default)
  (let ((p (member key form))) (if p (second p) default)))

;;; ── КВАНТИФИКАЦИЯ ПО КОРПУСУ ────────────────────────────────────────────────
;;; 🔴 Ступень, отделяющая протокол от языка: правило говорит не о поимённо названных
;;; свидетелях, а о ВСЕХ, удовлетворяющих условию. Урок Rego (производная Datalog): язык
;;; делает языком не управление потоком, а квантификация по данным.
;;;
;;; ТРИ РЕШЕНИЯ, ПРИНЯТЫЕ ДО КОДА:
;;; 1. Квантор бежит по ВСЕМУ корпусу программы, а не по объявленному выше. Иначе перестановка
;;;    объявлений меняла бы результат и рушилась КОНФЛЮЭНТНОСТЬ (доказанная `perm-inv`).
;;;    Цена — два прохода; она того стоит.
;;; 2. 🔴 ОТБОР ЕСТЬ ВЕКТОР ЧЕРРИ-ПИКИНГА: «посчитаю только строгих, несогласных не замечу».
;;;    Счётом: три свидетеля дают b=0.532, отбор двух согласных — b=0.713, разница 0.181.
;;;    Запретить нельзя — отбор бывает законным. Значит по нашему же закону: ОТСЕВ ОБЯЗАН БЫТЬ
;;;    ВИДЕН. Отсеянные записываются поимённо и печатаются; отсев НЕСОГЛАСНЫХ помечается особо.
;;; 3. Требование к МНОЖЕСТВУ (не менее N различных корней) не выполнено ⇒ дно, как пустая база.
;;;
;;; ⚠️ ПРЕДИКАТ ОТБОРА — ОБЩИЙ для проверяющего и машины, и это НАМЕРЕННО: если бы они отбирали
;;; по-разному, статическая степень разошлась бы с динамической. Общей делается только чистая
;;; функция одного свидетеля (её легко проверить перебором); ОБХОД и СВЁРТКА остаются раздельными.

(defun spec-get (spec key) (getf spec key))

(defun witness-matches-p (grade root spec)
  "Подходит ли свидетель со степенью GRADE и корнем ROOT под условие SPEC.
   SPEC — плист: :grade>= степень · :root имя · :not-root имя.
   Пустой SPEC подходит всем: `from all` без условий берёт корпус целиком."
  ;; Степень в условии приходит ИМЕНЕМ поверхностного синтаксиса (`строго`), а сравнивать надо
  ;; ключом действующей решётки. Нормализуем здесь — в одном месте, чтобы оба слоя не гадали.
  (let* ((graw (spec-get spec :grade>=))
         (g (and graw (if (keywordp graw) graw (parse-grade graw))))
         (r (spec-get spec :root))
         (nr (spec-get spec :not-root)))
    (and (or (null g) (g<= g grade))          ; степень не ниже заданной
         (or (null r) (eq root r))
         (or (null nr) (not (eq root nr))))))

;;; ── СЛОВАРЬ ФОРМ и ПОЛНОТА ДИСПЕТЧЕРОВ ──────────────────────────────────────
;;; 🔴 Диспетчеров по имени формы ЧЕТЫРЕ (аудит, находка 2): check-program, перепрогон в
;;; chk-retract, replay и step-cfg. Слить их нельзя — см. шапку. Но можно сделать ПРОПУСК
;;; ОБНАРУЖИМЫМ: словарь объявлен один раз, и каждый диспетчер обязан объявить, что он
;;; покрывает и что сознательно пропускает. Добавил форму, забыл диспетчер — падение при
;;; загрузке, а не тихая дыра в семантике.
(defparameter *form-vocabulary*
  '("lattice" "witness" "ask" "claim" "action" "do" "retract" "rule" "import" "revoke" "horizon"
    "permit")
  "Все формы языка. Расширяется ТОЛЬКО здесь; дальше компилятор потребует покрытия.")

;;; ── ЗАРЕЗЕРВИРОВАННЫЕ СЛОВА ────────────────────────────────────────────────
;;; 🔴 Ключевое слово в позиции имени — не безобидная вольность. `witness claim : …`
;;; разбирается, но читается человеком как объявление другого рода; `claim action …`
;;; заставляет читателя гадать, что здесь форма, а что имя. Язык, чья цель — сделать
;;; происхождение ВИДИМЫМ, не может позволять записи, которые видны неверно.
;;; 🔴 Список закрыт и лежит рядом со словарём форм: добавил ключевое слово в грамматику —
;;; впиши сюда, иначе оно останется законным именем, и кто-нибудь им назовётся.
(defparameter *reserved-words*
  '(;; формы
    "lattice" "horizon" "import" "witness" "ask" "claim" "action" "rule" "perform" "do"
    "permit" "revoke" "retract"
    ;; части объявлений
    "needs" "grade" "permission" "gated" "belief" "else" "to" "from" "at" "on" "by"
    "says" "source" "evidence" "for" "against" "in" "found" "nothing" "because"
    "searched" "requiring" "roots" "root" "all" "where" "not" "via" "of" "concludes"
    "compensated" "derived" "gain" "loss" "learn" "discount"
    ;; классы действий и направления
    "reversible" "irreversible" "compensable" "internal" "outward")
  "Слова, которыми нельзя НАЗВАТЬСЯ. Расширяется вместе с грамматикой.")

(defun reserved-word-p (name)
  (member (string-downcase (string name)) *reserved-words* :test #'string=))

(define-condition dispatcher-gap (error)
  ((who :initarg :who :reader gap-who) (missing :initarg :missing :reader gap-missing))
  (:report (lambda (c s)
             (format s "~&ДЫРА В ДИСПЕТЧЕРЕ «~a»: формы ~{~a~^, ~} не обработаны и не ~
                        объявлены пропущенными.~%  Словарь форм — *form-vocabulary* в ~
                        src/common.lisp. Либо обработайте, либо впишите в :skip с причиной."
                     (gap-who c) (gap-missing c)))))

(defun assert-covers (who handled &key skip)
  "Проверить при загрузке, что диспетчер WHO покрывает весь словарь форм."
  (let ((missing (set-difference *form-vocabulary* (append handled skip) :test #'string=)))
    (when missing (error 'dispatcher-gap :who who :missing missing))
    t))

;;; ── ЕДИНАЯ ДИАГНОСТИКА ──────────────────────────────────────────────────────
;;; 🔴 Раньше разбор и проверка ругались по-разному (аудит, находка 3 и 7). Один вид на оба
;;; слоя: род · код · где · суть · что сделать. Поле «где» больше не мёртвое — оно и несёт «где».
(defstruct (terr (:constructor terr (code where text))) code where text)

(defvar *errs* '())
(defun err! (code where fmt &rest args)
  (push (terr code where (apply #'format nil fmt args)) *errs*))

(defun say-error (kind code where text &optional (stream t))
  "Единственный печатающий диагностику: РОД [код] где: суть.
   WHERE приходит ГОТОВОЙ ФРАЗОЙ («строка 3», «у ЗАБЫТО») — склеивать предлог здесь нельзя,
   иначе получается «у строке 3»: слой не знает, чем является место, и не должен гадать."
  (format stream "~&~a [~a]~@[ ~a~]: ~a~%" kind (string-downcase (string code)) where text))
