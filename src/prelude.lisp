;;;; nolang src — prelude. ДВА МЕСТА: МЕРА И ЗАМЕР. Этап 2, п.1. Невис, 30.07.2026.
;;;;
;;;; 🔴 ГЛАВНЫЙ ВЫВОД АУДИТА, СТОЯЩИЙ НАД ВСЕМИ ЧАСТНЫМИ:
;;;;    МЕРА ФИКСИРУЕТСЯ ДО ТОГО, КАК СТАЛО ИЗВЕСТНО, ЧТО СУДЯТ.
;;;;
;;;; Тарантога сформулировал закон как «мера и подсудимый не должны иметь одного автора».
;;;; Закон верен, формулировка слабее находки — и ломается на решётке: её тоже пишет агент,
;;;; и запретить ему это значит запретить описывать домен, то есть убить язык. Проверка на
;;;; прочность, снявшая спор: агент объявляет `lattice основание = молва` — ОДИН уровень, —
;;;; и любое его свидетельство немедленно высшей степени, потому что других нет. Решётка тоже
;;;; мера суда, просто её рычаг не в величине, а в форме.
;;;;
;;;; Значит режет не АВТОРСТВО, а МОМЕНТ. Четыре из одиннадцати блокеров аудита — один и тот
;;;; же дефект: θ, `k`, метка направления и цитата пишутся в том же тексте, что и свидетельства,
;;;; то есть тогда, когда автор уже видит, чем кончилось. Он вытачивает линейку, посмотрев замер.
;;;; В науке против этого стоит предрегистрация, в криптографии — commit-then-reveal. Оба
;;;; существуют ровно потому, что человек не может не подстраивать критерий, видя данные,
;;;; даже честный.
;;;;
;;;; 🔴 ГРАНИЦА ПРОВЕДЕНА ПО МЕСТУ, А НЕ ПО СОДЕРЖАНИЮ:
;;;;
;;;;   ПРЕЛЮДИЯ (линейка)          | ПРОГРАММА (замер)
;;;;   lattice · horizon · import  | witness · ask · claim · rule · do · retract · revoke
;;;;   action (класс, требование,  |
;;;;           порог, направление) |
;;;;   пишется ЗАРАНЕЕ, отдельно   | пишется агентом свободно
;;;;
;;;; Почему `action` целиком в прелюдии, а не только его порог: действие объявляет СРАЗУ
;;;; три требования (степень, вера, направление), и любое из них — линейка. Оставь агенту
;;;; право объявить своё действие — он объявит `reversible action пуш gated by belief >= 0.001`
;;;; и пройдёт всё. Программа называет действие по имени; завести новое она не может.
;;;;
;;;; Почему `rule` остаётся программе: правилу ЗАПРЕЩЕНО объявлять степень (`p-rule`), оно
;;;; только выводит её через ⊓ посылок. Ослабить требование им нельзя, а рассуждение о домене —
;;;; это замер, а не линейка.
;;;;
;;;; 🔴 ЧЕГО ЭТО НЕ ДАЁТ. Разделение мест не мешает написать прелюдию под уже известный ответ:
;;;; оно делает это ВИДИМЫМ (две правки в двух файлах вместо одной) и позволяет положить
;;;; прелюдию туда, куда агент не пишет. Порядок во времени языком не проверяется — его
;;;; обеспечивает тот, кто хранит прелюдию. Язык здесь даёт форму, а не гарантию.

(load (merge-pathnames "nolang.lisp" *load-pathname*))

(defparameter *prelude-only*
  '("lattice" "horizon" "import" "action")
  "Формы ЛИНЕЙКИ: их место — прелюдия. Расширяется только вместе с *form-vocabulary*.")

(defparameter *program-only*
  '("witness" "ask" "claim" "rule" "do" "retract" "revoke" "permit")
  "Формы ЗАМЕРА: их место — программа.")

;; 🔴 Полнота разделения проверяется ПРИ ЗАГРУЗКЕ тем же способом, что полнота диспетчеров:
;; добавил форму в словарь языка, забыл приписать ей место — падение здесь, а не тихая дыра,
;; в которой новая форма молча оказывается разрешена и там, и там.
(let ((missing (set-difference *form-vocabulary* (append *prelude-only* *program-only*)
                               :test #'string=))
      (both (intersection *prelude-only* *program-only* :test #'string=)))
  (when missing
    (error "ФОРМА БЕЗ МЕСТА: ~{~a~^, ~} — не отнесена ни к прелюдии, ни к программе ~
            (src/prelude.lisp)" missing))
  (when both
    (error "ФОРМА В ДВУХ МЕСТАХ СРАЗУ: ~{~a~^, ~}" both)))

(defun misplaced (forms allowed code fmt)
  "Формы, оказавшиеся не в своём месте → список terr."
  (loop for f in forms
        for h = (head-of f)
        unless (member h allowed :test #'string=)
          collect (terr code (format nil "~a ~a" h (or (second f) ""))
                        (format nil fmt h))))

(defun check-places (prelude-forms program-forms)
  "→ список terr про нарушения мест. Пусто, если каждая форма там, где ей положено."
  (append
   (misplaced prelude-forms *prelude-only* :замер-в-прелюдии
              "«~a» — это ЗАМЕР, а не линейка: в прелюдии ему не место.~%  ~
               Прелюдия отвечает на вопрос «чем меряем», программа — «что намеряли».~%  ~
               Свидетельства, утверждения и действия пишет агент в программе.")
   (misplaced program-forms *program-only* :мера-в-программе
              "«~a» — это ЛИНЕЙКА, и объявлять её в программе нельзя.~%  ~
               Решётка, горизонт, отображение между решётками и класс действия (его~%  ~
               требование к степени, порог и направление) фиксируются ДО того, как стало~%  ~
               известно, что судят, — иначе подсудимый вытачивает линейку, увидев замер.~%  ~
               Перенесите объявление в файл прелюдии; программа ссылается на него ПО ИМЕНИ.")))

(defun compile-with-prelude (prelude-src program-src)
  "Прелюдия + программа → (values формы ошибки). Формы прелюдии идут ПЕРВЫМИ: порядок
   объявлений в языке несущий, и линейка обязана существовать раньше замера.
   Проверка мест идёт ДО проверяющего: сообщать «неизвестное действие ПУШ» тому, кто объявил
   действие не в том файле, значит указывать на следствие вместо причины."
  (let* ((pf (parse prelude-src))
         (gf (parse program-src))
         (place-errs (check-places pf gf)))
    (multiple-value-bind (env errs) (check-program (append pf gf))
      (declare (ignore env))
      (values (append pf gf) (append place-errs errs)))))
