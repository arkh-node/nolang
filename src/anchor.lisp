;;;; anchor.lisp — ВНЕШНИЙ ЯКОРЬ ЦЕПИ СУБЪЕКТОВ (06.08.2026)
;;;;
;;;; 🔴 ЗАДАЧА, КОТОРУЮ ЗАКРЫВАЕТ ЭТОТ ФАЙЛ — И ГРАНИЦА, КОТОРУЮ ОН НЕ ЗАКРОЕТ.
;;;;   Цепь субъектов (`chain-verify`) ловит подделку любого ЗВЕНА: изменённая запись меняет
;;;;   свой отпечаток, и следующая перестаёт сходиться. Значит подделка не бывает точечной —
;;;;   надо переписать всю историю до конца.
;;;;
;;;;   И ровно это «до конца» есть дыра: кто владеет цепью с самого начала, перепишет её
;;;;   целиком, и все отпечатки внутри сойдутся. Изнутри системы это неотличимо от честной
;;;;   истории — и никакой, сколь угодно стойкий хеш здесь не поможет. Дело не в хеше:
;;;;   утверждение «эта история не переписана» есть утверждение О МИРЕ, а не о вычислении,
;;;;   и доказать его изнутри вычисления нельзя в принципе (то же, что сказано в шапке
;;;;   `formal/ReEntry.agda` про соответствие посылок прошлому).
;;;;
;;;;   Лечится это не доказательством, а СВИДЕТЕЛЕМ: отпечаток выносится наружу, где его
;;;;   видит кто-то, кроме нас. Тогда переписать историю до этой точки — значит разойтись
;;;;   с чужой записью.
;;;;
;;;; 🔴 ГЛАВНОЕ, ЧТО ЯКОРЬ ДЕЛАЕТ С ЦЕПЬЮ: ОН ЕЁ РЕЖЕТ НА ДВА ОТРЕЗКА.
;;;;      [ начало ... последний якорь ]   — переписать нельзя, не разойдясь со свидетелем
;;;;      ( последний якорь ... конец  ]   — по-прежнему только «подделка не бывает точечной»
;;;;   Это НЕ «теперь подделка невозможна». Это «горизонт неподделываемости сдвинулся к
;;;;   последнему якорю». Разница существенна, и она в выводе `chain-anchored-prefix`
;;;;   печатается ЧИСЛОМ, а не прячется в оговорку: сколько звеньев защищено и сколько нет.
;;;;
;;;; 🔴 ПОЧЕМУ ЗДЕСЬ НЕТ НИ ОДНОГО КАНАЛА ПУБЛИКАЦИИ.
;;;;   Выбор канала — решение оператора, а не языка: он упирается в OPSEC, в то, кому вообще
;;;;   можно показывать отпечатки, и в то, чем контур готов пользоваться. Файл описывает
;;;;   ФОРМУ якоря и его ПРОВЕРКУ так, чтобы подстановка любого канала ничего здесь не меняла.
;;;;   Канал — это данные (`:channel`, `:ref`), а не код.
;;;;
;;;; 🔴 НАХОДКА, СЭКОНОМИВШАЯ МЕХАНИЗМ: СИЛА ЯКОРЯ — ЭТО СТЕПЕНЬ.
;;;;   Якоря не равны: запись в собственный файл и публикация, которую видела вторая сторона, —
;;;;   разные вещи. Сперва я собирался завести для этого отдельную шкалу и обнаружил, что она
;;;;   уже есть: это РЕШЁТКА, та же, на которой стоят классы источников, и работает она по
;;;;   тому же закону — **степень не поднимается объявлением**. Якорь, положенный в канал под
;;;;   нашим контролем, нельзя объявить засвидетельствованным: `anchor-class` считает силу по
;;;;   каналу, а не по тому, что написал автор записи (`SourceCeiling`, тот же потолок).

(in-package :cl-user)

;;; Якорь надстроен над субъектом и зависит от него (`subject-digest`), а не наоборот:
;;; субъект остаётся полным без якоря, якорь без субъекта бессмыслен.
(load (merge-pathnames "subject.lisp" *load-pathname*))

;;; ── РЕШЁТКА СИЛЫ ЯКОРЯ ──────────────────────────────────────────────────────
;;; Порядок: self < witnessed < notarised. Ровно три ступени, и каждая отвечает на
;;; один вопрос: КТО, кроме нас, может опровергнуть нашу версию истории.

(defparameter *anchor-classes* '(:self :witnessed :notarised)
  "Сила якоря по возрастанию. Смысл каждой ступени — в `anchor-class-meaning`.")

(defun anchor-class-meaning (class)
  (case class
    (:self      "канал под нашим контролем: опровергнуть нашу версию нечем — ЭТО НЕ ЯКОРЬ")
    (:witnessed "запись видела вторая сторона: чтобы переписать, надо согласие или обман её")
    (:notarised "независимое свидетельство ВРЕМЕНИ: переписать нельзя даже с согласия второй стороны")
    (t          "неизвестный класс канала")))

(defun anchor-class<= (a b)
  "Порядок на решётке силы."
  (let ((pa (position a *anchor-classes*))
        (pb (position b *anchor-classes*)))
    (and pa pb (<= pa pb))))

(defun anchor-class-meet (a b)
  "Встреча: сила пары якорей не выше слабейшего. Тот же `⊓`, что у степеней."
  (if (anchor-class<= a b) a b))

;;; 🔴 ПОТОЛОК КАНАЛА. Автор записи объявляет, КУДА положил отпечаток; силу считает язык.
;;; Объявить `:notarised` для канала, который под нашим контролем, нельзя — ровно как нельзя
;;; поднять степень свидетеля выше класса его источника.
(defparameter *channel-classes*
  '((:file        . :self)        ; файл на нашем диске
    (:own-repo    . :self)        ; наш репозиторий, который мы же можем переписать
    (:public-repo . :witnessed)   ; публичный репозиторий: копии у форков и в чужих кэшах
    (:sent-mail   . :witnessed)   ; письмо у получателя — вне нашей досягаемости
    (:second-party . :witnessed)  ; отпечаток отдан второй стороне
    (:timestamped . :notarised))  ; независимая метка времени
  "Канал → его СИЛА. Таблица намеренно бедна: добавлять сюда строку значит утверждать,
   что канал даёт названную силу, и это утверждение о мире, требующее проверки.")

(defun anchor-class (channel &optional declared)
  "Действительная сила якоря: не выше того, что даёт канал.
   Второе значение — понижен ли объявленный класс (то есть соврал ли автор записи)."
  (let* ((actual (or (cdr (assoc channel *channel-classes*)) :self))
         (final  (if declared (anchor-class-meet declared actual) actual)))
    (values final (and declared (not (eq final declared))))))

;;; ── ЗАПИСЬ ЯКОРЯ ────────────────────────────────────────────────────────────

(defparameter *anchor-version* 1)

(defun make-anchor (digest channel ref &key declared note)
  "Отпечаток + канал + ссылка в нём → запись якоря.

   `digest` — отпечаток субъекта (`subject-digest`), тот же, что несёт следующее звено.
   `ref`    — как ЭТУ запись найти снаружи: номер коммита, идентификатор письма, адрес.
              Якорь без проверяемой ссылки бесполезен: он утверждает, что где-то что-то
              лежит, и не даёт это проверить.
   ⚠️ ВРЕМЕНИ ЗДЕСЬ НЕТ НАМЕРЕННО. Время, записанное нами, ничего не свидетельствует —
   мы же его и пишем. Свидетельство времени живёт в канале (`:notarised`) или не живёт
   нигде; выдавать нашу метку за него значило бы подделывать именно то, ради чего якорь."
  (multiple-value-bind (class lowered) (anchor-class channel declared)
    (list :anchor *anchor-version*
          :digest digest
          :channel channel
          :ref ref
          :class class
          :lowered lowered          ; 🔴 понижение НЕ прячется: оно часть записи
          :note note)))

(defun anchor-digest (a)  (getf a :digest))
(defun anchor-channel (a) (getf a :channel))
(defun anchor-ref (a)     (getf a :ref))
(defun anchor-class-of (a) (getf a :class))
(defun anchor-lowered-p (a) (getf a :lowered))

;;; ── ПРОВЕРКА ────────────────────────────────────────────────────────────────

(defun anchor-verify (anchor subjects)
  "Сходится ли якорь с цепью: есть ли в ней звено с заякоренным отпечатком.

   Возвращает (values найден индекс причина). Причины отказа:
     :not-in-chain — отпечатка нет ни у одного звена. Значит либо цепь переписана,
                     либо якорь от ДРУГОЙ цепи. Различить эти два случая изнутри
                     нельзя, и функция не притворяется, что может.
     :no-strength  — канал класса `:self`. Формально сходится, но не свидетельствует
                     ничего: мы предъявляем самим себе. Возвращается как ОТКАЗ, а не
                     как успех с примечанием — примечания не читают.

   ⚠️ Проверяется СХОЖДЕНИЕ ОТПЕЧАТКА, а не наличие записи в канале. Что по ссылке
   `ref` действительно лежит этот отпечаток — утверждение о мире; его проверяет тот,
   кто откроет ссылку. Язык говорит ровно то, что вычислил."
  (if (eq (anchor-class-of anchor) :self)
      (values nil nil :no-strength)
      (let ((d (anchor-digest anchor)))
        (loop for s in subjects
              for i from 0
              when (string= d (subject-digest s))
                do (return (values t i nil))
              finally (return (values nil nil :not-in-chain))))))

(defun chain-anchored-prefix (subjects anchors)
  "Главная функция файла: ГДЕ проходит граница неподделываемости.

   Возвращает (values защищено всего сила), где:
     защищено — сколько звеньев с начала цепи закрыто якорями,
     всего    — длина цепи,
     сила     — класс САМОГО ДАЛЬНЕГО сошедшегося якоря.

   🔴 Число, а не оговорка. Прежняя формулировка звучала «подделка не бывает точечной»,
   и это верно, но неизмеримо. Здесь то же самое сказано счётом: столько-то звеньев
   защищены свидетелем, остальные — нет. Разница между 40 из 40 и 3 из 40 — это разница
   между защищённой историей и почти незащищённой, а прежняя фраза покрывала обе."
  (let ((best -1) (class nil))
    (dolist (a anchors)
      (multiple-value-bind (ok i) (anchor-verify a subjects)
        (when (and ok (> i best))
          (setf best i class (anchor-class-of a)))))
    (values (1+ best) (length subjects) class)))

(defun anchor-report (subjects anchors)
  "Человекочитаемый вывод состояния — с явно названной незащищённой частью.
   Сторож, показывающий только защищённое, продаёт лекарство."
  (multiple-value-bind (safe total class) (chain-anchored-prefix subjects anchors)
    (format nil "~@[якорь: ~a — ~a~%~]защищено свидетелем: ~a из ~a звеньев~
                 ~@[~%НЕ защищено: ~a (для них верно лишь «подделка не бывает точечной»)~]"
            class (and class (anchor-class-meaning class))
            safe total
            (when (< safe total) (- total safe)))))
