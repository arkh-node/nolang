;;;; nolang src — theta. ВЫВОД ПОРОГА, а не его назначение.
;;;;
;;;; 🔴 Разделение ролей (совет Невис, §4 её записки): три линии отвечают на РАЗНЫЕ вопросы.
;;;;   Arrow–Fisher (1974), quasi-option value — ЧТО ЗНАЧИТ порог: премия за необратимость,
;;;;     ценность сохранённой возможности подождать и узнать. Отсюда СМЫСЛ.
;;;;   Conformal risk control — КАК ЕГО ВЫСТАВИТЬ, не веря собственным числам. Отсюда ПРОЦЕДУРА.
;;;;   Chow (1970), reject option — предок вопроса, но требует КАЛИБРОВАННОЙ апостериорной
;;;;     вероятности. Наша `c` не калибрована и по построению не может быть (граница Эйн-Соф:
;;;;     `c < 1` структурно). В фундамент не берём; держим как историю вопроса.

(load (merge-pathnames "common.lisp" *load-pathname*))

;;; ── I. СМЫСЛ: θ из ценности сохранённой возможности ─────────────────────────
;;;
;;; Действие необратимо. Альтернатива — свернуться (fold) и узнать больше.
;;;   G  выигрыш, если утверждение истинно
;;;   L  потеря, если ложно (необратимая — откатить нельзя)
;;;   λ  вероятность узнать правду, если подождать (сколько несёт ожидание)
;;;   δ  во сколько ценится отложенный исход (0 — будущее ничего не стоит, 1 — как настоящее)
;;;
;;; Ценность действия сейчас:  V = b·G − (1−b)·L
;;; Ценность ожидания:         δ·[ λ·b·G + (1−λ)·V ]   (узнав — действуем только при истине)
;;; Действовать выгоднее ⟺  V ≥ δ[λbG + (1−λ)V]
;;;   V(1 − δ(1−λ)) ≥ δλbG                     ⇒  K := δλ / (1 − δ(1−λ))
;;;   bG − L + bL ≥ K·bG
;;;   b(G + L − KG) ≥ L
;;;
;;;        🔴  θ = L / ( G·(1−K) + L )
;;;
;;; K и есть квази-опционная надбавка Эрроу–Фишера, выраженная долей: сколько выигрыша
;;; съедает уничтоженная возможность подождать.
;;;
;;; ПРЕДЕЛЫ (проверены счётом, test/99_theta.lisp):
;;;   λ=0    ожидание не приносит сведений        → K=0,  θ = L/(G+L)  — классический порог
;;;   δ=0    будущее ничего не стоит              → K=0,  θ = L/(G+L)
;;;   λ=1,δ=1 даровое точное знание               → K=1,  θ = 1 — НИКОГДА не действовать
;;;   L→0    потеря ничтожна                      → θ → 0
;;;   L≫G    потеря велика                        → θ → 1
;;;
;;; 🔴 И связка с границей Эйн-Соф, которая здесь работает, а не украшает: `b = f·c < 1`
;;; структурно, значит θ=1 НЕДОСТИЖИМ. Политика «дождаться полной уверенности» не действует
;;; никогда. Порог обязан быть строго меньше единицы — не из смелости, а из конечности.

(defun quasi-option-k (learn discount)
  "K = δλ/(1−δ(1−λ)). Знаменатель ноль только при δ=1,λ=0 — тогда и числитель ноль,
   предел равен нулю: ожидание без сведений ничего не стоит."
  (let ((denom (- 1 (* discount (- 1 learn)))))
    (if (< (abs denom) 1e-9) 0.0 (/ (* discount learn) denom))))

(defun theta-derived (gain loss learn discount)
  "θ = L/(G(1−K)+L). Порог ВЫВЕДЕН из цены ошибки и ценности ожидания, а не назначен."
  (let* ((k (quasi-option-k learn discount))
         (denom (+ (* gain (- 1 k)) loss)))
    (if (<= denom 0) 1.0 (min 1.0 (max 0.0 (/ loss denom))))))

;;; ── II. ПРОЦЕДУРА: θ из журнала, без веры в собственные числа ───────────────
;;;
;;; 💎 ЖУРНАЛ И ЕСТЬ КАЛИБРОВОЧНАЯ ВЫБОРКА. Λ хранит массу веры каждого совершённого
;;; действия; когда исходы становятся известны, накапливается набор «вера при ложном
;;; утверждении». Conformal risk control не требует, чтобы наши `b` были калиброванными
;;; вероятностями — достаточно ОБМЕНИВАЕМОСТИ прошлых случаев с будущими.
;;;
;;; 🔴 И ЧТО БЫВАЕТ, КОГДА ОБМЕНИВАЕМОСТЬ НАРУШЕНА (замерено 06.08.2026, α=0.1, n=200).
;;; До сих пор здесь стояло только «достаточно обмениваемости» — как достоинство, и точка.
;;; Вторая половина правды:
;;;     тот же мир          утечка 13.5%   в пределах шума (гарантия МАРГИНАЛЬНАЯ)
;;;     лёгкий сдвиг        утечка 66.5%   гарантия не действует
;;;     сильный сдвиг       утечка  100%
;;;     состязательный      утечка  100%
;;; Она НЕ деградирует плавно — она РУШИТСЯ. И опасно не число, а то, что ГЕЙТ ОБ ЭТОМ НЕ
;;; ЗНАЕТ: ничто в механике не замечает, что мир сдвинулся, и порог отвечает с прежней
;;; уверенностью. Против этого у нас не починка, а СИГНАЛ: субъект записывает сцену
;;; (`src/subject.lisp`), и возврат отказывается продолжать в другой сцене. Смена сцены не
;;; доказывает нарушение обмениваемости, но обычно сопровождает его.
;;;
;;; Цель: доля ЛОЖНЫХ утверждений, прошедших гейт, не выше α.
;;; Берём (1−α)-квантиль вер у заведомо ложных прошлых случаев: порог выше него пропустит
;;; не больше α их доли. Поправка (n+1) — стандартная конечновыборочная.

(defun theta-conformal (false-beliefs alpha)
  "θ по conformal risk control. FALSE-BELIEFS — веры прошлых утверждений, оказавшихся ЛОЖНЫМИ.
   → порог, при котором доля ложных, прошедших гейт, ≤ ALPHA.
   🔴 Мало данных — возвращает 1.0: отказ действовать, а не догадка. Пустая выборка не даёт
   права на риск (та же дисциплина, что у пустой посылочной базы: ∅ ↦ ⊥, а не ⊤)."
  (let* ((sorted (sort (copy-list false-beliefs) #'<))
         (n (length sorted))
         (k (ceiling (* (- 1 alpha) (1+ n)))))
    (cond ((zerop n) 1.0)
          ((> k n) 1.0)
          (t (nth (1- k) sorted)))))

(defun theta-both (gain loss learn discount false-beliefs alpha)
  "Смысл и процедура вместе: берём БОЛЕЕ СТРОГИЙ из двух.
   Вывод говорит, каким порог должен быть по цене ошибки; калибровка — каким он обязан быть,
   чтобы прошлое не повторилось. Спорить им не о чем: побеждает осторожнейший."
  (max (theta-derived gain loss learn discount)
       (theta-conformal false-beliefs alpha)))
