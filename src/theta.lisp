;;;; nolang src — theta. ВЫВОД ПОРОГА, а не его назначение.
;;;;
;;;; 🔴 Разделение ролей (совет Невис, §4 её записки): три линии отвечают на РАЗНЫЕ вопросы.
;;;;   Arrow–Fisher (1974), quasi-option value — ЧТО ЗНАЧИТ порог: премия за необратимость,
;;;;     ценность сохранённой возможности подождать и узнать. Отсюда СМЫСЛ.
;;;;   Conformal risk control — КАК ЕГО ВЫСТАВИТЬ, не веря собственным числам. Отсюда ПРОЦЕДУРА.
;;;;   Chow (1970), reject option — предок вопроса, но требует КАЛИБРОВАННОЙ апостериорной
;;;;     вероятности. Наша `c` не калибрована и по построению не может быть (граница Эйн-Соф:
;;;;     `c < 1` структурно). В фундамент не берём; держим как историю вопроса.

(load (merge-pathnames "common.lisp" *load-pathname*))

;;; ── I. СМЫСЛ: θ из ценности сохранённой возможности ─────────────────────────
;;;
;;; Действие необратимо. Альтернатива — свернуться (fold) и узнать больше.
;;;   G  выигрыш, если утверждение истинно
;;;   L  потеря, если ложно (необратимая — откатить нельзя)
;;;   λ  вероятность узнать правду, если подождать (сколько несёт ожидание)
;;;   δ  во сколько ценится отложенный исход (0 — будущее ничего не стоит, 1 — как настоящее)
;;;
;;; Ценность действия сейчас:  V = b·G − (1−b)·L
;;; Ценность ожидания:         δ·[ λ·b·G + (1−λ)·V ]   (узнав — действуем только при истине)
;;; Действовать выгоднее ⟺  V ≥ δ[λbG + (1−λ)V]
;;;   V(1 − δ(1−λ)) ≥ δλbG                     ⇒  K := δλ / (1 − δ(1−λ))
;;;   bG − L + bL ≥ K·bG
;;;   b(G + L − KG) ≥ L
;;;
;;;        🔴  θ = L / ( G·(1−K) + L )
;;;
;;; K и есть квази-опционная надбавка Эрроу–Фишера, выраженная долей: сколько выигрыша
;;; съедает уничтоженная возможность подождать.
;;;
;;; ПРЕДЕЛЫ (проверены счётом, test/99_theta.lisp):
;;;   λ=0    ожидание не приносит сведений        → K=0,  θ = L/(G+L)  — классический порог
;;;   δ=0    будущее ничего не стоит              → K=0,  θ = L/(G+L)
;;;   λ=1,δ=1 даровое точное знание               → K=1,  θ = 1 — НИКОГДА не действовать
;;;   L→0    потеря ничтожна                      → θ → 0
;;;   L≫G    потеря велика                        → θ → 1
;;;
;;; 🔴 И связка с границей Эйн-Соф, которая здесь работает, а не украшает: `b = f·c < 1`
;;; структурно, значит θ=1 НЕДОСТИЖИМ. Политика «дождаться полной уверенности» не действует
;;; никогда. Порог обязан быть строго меньше единицы — не из смелости, а из конечности.

(defun quasi-option-k (learn discount)
  "K = δλ/(1−δ(1−λ)). Знаменатель ноль только при δ=1,λ=0 — тогда и числитель ноль,
   предел равен нулю: ожидание без сведений ничего не стоит."
  (let ((denom (- 1 (* discount (- 1 learn)))))
    (if (< (abs denom) 1e-9) 0.0 (/ (* discount learn) denom))))

(defun theta-derived (gain loss learn discount)
  "θ = L/(G(1−K)+L). Порог ВЫВЕДЕН из цены ошибки и ценности ожидания, а не назначен."
  (let* ((k (quasi-option-k learn discount))
         (denom (+ (* gain (- 1 k)) loss)))
    (if (<= denom 0) 1.0 (min 1.0 (max 0.0 (/ loss denom))))))

;;; ── II. ПРОЦЕДУРА: θ из журнала, без веры в собственные числа ───────────────
;;;
;;; 💎 ЖУРНАЛ И ЕСТЬ КАЛИБРОВОЧНАЯ ВЫБОРКА. Λ хранит массу веры каждого совершённого
;;; действия; когда исходы становятся известны, накапливается набор «вера при ложном
;;; утверждении». Conformal risk control не требует, чтобы наши `b` были калиброванными
;;; вероятностями — достаточно ОБМЕНИВАЕМОСТИ прошлых случаев с будущими.
;;;
;;; 🔴 И ЧТО БЫВАЕТ, КОГДА ОБМЕНИВАЕМОСТЬ НАРУШЕНА (замерено 06.08.2026, α=0.1, n=200).
;;; До сих пор здесь стояло только «достаточно обмениваемости» — как достоинство, и точка.
;;; Вторая половина правды:
;;;     тот же мир          утечка 13.5%   в пределах шума (гарантия МАРГИНАЛЬНАЯ)
;;;     лёгкий сдвиг        утечка 66.5%   гарантия не действует
;;;     сильный сдвиг       утечка  100%
;;;     состязательный      утечка  100%
;;; Она НЕ деградирует плавно — она РУШИТСЯ. И опасно не число, а то, что ГЕЙТ ОБ ЭТОМ НЕ
;;; ЗНАЕТ: ничто в механике не замечает, что мир сдвинулся, и порог отвечает с прежней
;;; уверенностью. Против этого у нас не починка, а СИГНАЛ: субъект записывает сцену
;;; (`src/subject.lisp`), и возврат отказывается продолжать в другой сцене. Смена сцены не
;;; доказывает нарушение обмениваемости, но обычно сопровождает его.
;;;
;;; Цель: доля ЛОЖНЫХ утверждений, прошедших гейт, не выше α.
;;; Берём (1−α)-квантиль вер у заведомо ложных прошлых случаев: порог выше него пропустит
;;; не больше α их доли. Поправка (n+1) — стандартная конечновыборочная.

(defun theta-conformal (false-beliefs alpha)
  "θ по conformal risk control. FALSE-BELIEFS — веры прошлых утверждений, оказавшихся ЛОЖНЫМИ.
   → порог, при котором доля ложных, прошедших гейт, ≤ ALPHA.
   🔴 Мало данных — возвращает 1.0: отказ действовать, а не догадка. Пустая выборка не даёт
   права на риск (та же дисциплина, что у пустой посылочной базы: ∅ ↦ ⊥, а не ⊤)."
  (let* ((sorted (sort (copy-list false-beliefs) #'<))
         (n (length sorted))
         (k (ceiling (* (- 1 alpha) (1+ n)))))
    (cond ((zerop n) 1.0)
          ((> k n) 1.0)
          (t (nth (1- k) sorted)))))

(defun weighted-quantile (values weights level)
  "(1−level)-квантиль по ВЗВЕШЕННОЙ выборке. Веса wᵢ ∈ [0,1], предзаданные.

   Берём наименьшее значение, у которого накопленный вес (с поправкой +1 на будущую точку)
   достигает требуемой доли. При всех wᵢ = 1 совпадает с обычным квантилем с поправкой (n+1)."
  (let* ((pairs (sort (mapcar #'cons values weights) #'< :key #'car))
         (total (+ 1 (reduce #'+ weights :initial-value 0)))
         (need  (* level total))
         (acc 0))
    (dolist (pr pairs 1.0)
      (incf acc (cdr pr))
      (when (>= acc need) (return (car pr))))))

(defun theta-nonexchangeable (false-beliefs weights alpha)
  "θ по conformal БЕЗ допущения обмениваемости (Barber, Candès, Ramdas, Tibshirani,
   `Conformal prediction beyond exchangeability`, Ann. Statist. 51(2), 2023).

   🔴 ЗАЧЕМ. `theta-conformal` даёт гарантию только при обмениваемости прошлых случаев с
   будущими. Замер 06.08 показал, чего она стоит при нарушении: утечка лжи 13.5% → 66.5% →
   100% при нарастающем сдвиге, причём **гейт об этом не знает**.
   Метод статьи: взвешенные квантили. Потеря покрытия ограничена
       gap ≤ Σ wᵢ·d_TV(Z, Zⁱ) / (1 + Σ wᵢ),
   то есть случаю, далёкому от нынешнего, можно заранее дать малый вес — и провал ограничен.

   🔴 ДВА СВОЙСТВА, РАДИ КОТОРЫХ ЭТО БЕРЁТСЯ ИМЕННО СЮДА:
   1. Веса обязаны быть **предзаданными и не зависящими от данных** («prespecified»,
      «non-data-dependent»). У нас для этого уже есть место — **прелюдия**: то, чем меряют,
      пишется до того, как известно, что судят. Тот же закон, которым закрыт произвол
      горизонта `k` (см. README, Lineage/Walley). Веса — второй параметр осторожности,
      и он подчиняется тому же правилу, а не заводит новой лазейки.
   2. При сохранённой обмениваемости gap = 0: **взвешивание не вредит, когда всё в порядке.**
      Значит его можно включать по умолчанию, а не «на случай подозрений».

   ⚠️ Гарантия остаётся МАРГИНАЛЬНОЙ и не становится безусловной: она лишь перестаёт быть
   бессмысленной при сдвиге. Обещать «работает при любом сдвиге» — то же завышение, за
   которое мы правим чужие оговорки.

   🔴 ЗАМЕРЕНО, ГДЕ ПОМОГАЕТ И ГДЕ ВРЕДИТ (06.08.2026, α=0.1, утечка лжи через гейт):

     калибровка                      обычный   ρ=1/4   ρ=1/16
     50/50, чужая сцена слабее        19.5%    15.5%   14.0%    умеренно помогает
     50/50, чужая сцена СИЛЬНЕЕ        0.0%     0.0%    9.5%    🔴 УХУДШИЛО
     20/180, чужих БОЛЬШИНСТВО        99.5%    22.5%   15.5%    спасает
     180/20, чужих мало               15.5%    14.0%   14.0%    почти без разницы

   Читать это надо так: взвешивание **защищает от загрязнения калибровки чужой сценой** и
   НЕ заменяет наличия своих случаев. А строка со «стало хуже» — не аномалия: там чужие
   случаи были консервативнее наших и задирали порог, то есть защищали СЛУЧАЙНО. Понизив им
   вес, мы отняли эту случайную защиту. Случайная защита не есть защита, но и терять её,
   не заметив, нельзя — поэтому строка стоит здесь, а не выпала из отчёта."
  (let ((sorted-w (or weights (make-list (length false-beliefs) :initial-element 1))))
    (cond ((null false-beliefs) 1.0)
          (t (weighted-quantile false-beliefs sorted-w (- 1 alpha))))))

(defun scene-weights (same-scene-flags &optional (rho 1/4))
  "Веса по СЦЕНЕ: случай из той же сцены — вес 1, из другой — ρ.

   🔴 ЧЕМ ЭТО ОТЛИЧАЕТСЯ ОТ ОБЫЧНОГО. В статье пример весов — по давности (`wᵢ = ρ^(n+1-i)`):
   чем старше случай, тем меньше доверия. Это разумно и слепо: время лишь КОРРЕЛИРУЕТ с тем,
   что мир изменился. У нас есть наблюдаемое событие вместо корреляции — **смена сцены**
   (горизонт, решётка, источники с отпечатками записаны в субъекте, `src/subject.lisp`).
   Случай, судившийся другой мерой, и правда далёк от нынешнего; случай той же меры близок,
   даже если он старый.
   ρ объявляется в прелюдии — как и всё, чем меряют."
  (mapcar (lambda (same) (if same 1 rho)) same-scene-flags))

(defun theta-both (gain loss learn discount false-beliefs alpha)
  "Смысл и процедура вместе: берём БОЛЕЕ СТРОГИЙ из двух.
   Вывод говорит, каким порог должен быть по цене ошибки; калибровка — каким он обязан быть,
   чтобы прошлое не повторилось. Спорить им не о чем: побеждает осторожнейший."
  (max (theta-derived gain loss learn discount)
       (theta-conformal false-beliefs alpha)))

;;; ── КАЛИБРОВКА ЗНАЕТ О СЕБЕ, ЧЕГО СТОИТ ─────────────────────────────────────
;;; 🔴 ПОВОД (06.08.2026, клетка C1 наказа о недоказанном). Замер показал: при сдвиге мира
;;; утечка лжи через гейт растёт 13.5% → 66.5% → 100%. И худшее в этом было не число, а
;;; приписка: **гейт об этом НЕ ЗНАЕТ**. Он отвечает с той же уверенностью, с какой отвечал
;;; в день калибровки. Сторож, молчащий от слепоты, неотличим от сторожа, молчащего от
;;; спокойствия, — и это ровно тот дефект, который в этом проекте ловился уже пятикратно.
;;;
;;; 🔴 ПОЧЕМУ ПРИЗНАК — ИМЕННО ДОЛЯ СВОИХ СЛУЧАЕВ, а не веса.
;;; Взвешивание по сцене (`scene-weights`) ограничивает провал, но **не заменяет наличия
;;; своих случаев**: в замере при 10% своих утечка была 99.5% без весов и всё ещё 22.5% с
;;; ними. Вес чинит ЗАГРЯЗНЕНИЕ калибровки чужим; он не чинит ОТСУТСТВИЕ своего. Поэтому
;;; тревога поднимается по составу выборки, а не по тому, применено ли взвешивание.
;;;
;;; ⚠️ И граница, названная сразу: это **не детектор сдвига мира**. Мир может измениться при
;;; неизменной сцене — тогда здесь будет тихо. Признак ловит лишь то, что НАБЛЮДАЕМО: чем
;;; судили прошлые случаи и чем судим теперь. «Тихо» тут значит «сцена та же», а не
;;; «калибровка верна», и функция обязана говорить именно это.

(defparameter *min-own-cases* 30
  "Меньше стольких СВОИХ случаев — калибровке верить нельзя независимо от доли.
   Число из замера: при 20 своих из 200 утечка доходила до 99.5%.")

(defparameter *min-own-share* 1/2
  "Доля своих случаев, ниже которой калибровка объявляется загрязнённой.")

(defun calibration-trust (same-scene-flags &key (min-own *min-own-cases*)
                                                (min-share *min-own-share*))
  "Чего стоит калибровка → (values доверие своих всего доля причина).

   :доверять       — своих достаточно и по числу, и по доле;
   :под-сомнением  — своих хватает по числу, но они в меньшинстве;
   :не-доверять    — своих слишком мало; порог держится на чужой сцене;
   :пусто          — калибровать не на чем.

   🔴 Возвращается ВСЕГДА, а не только при беде: вердикт «доверять» тоже должен быть
   произнесён. Признак, который слышен лишь в плохом случае, неотличим от сломанного."
  (let* ((всего (length same-scene-flags))
         (своих (count-if #'identity same-scene-flags))
         (доля  (if (plusp всего) (/ своих всего) 0)))
    (cond
      ((zerop всего)
       (values :пусто своих всего доля "калибровочных случаев нет вовсе"))
      ((< своих min-own)
       (values :не-доверять своих всего доля
               (format nil "своих случаев ~a при пороге ~a — порог держится на чужой сцене"
                       своих min-own)))
      ((< доля min-share)
       (values :под-сомнением своих всего доля
               (format nil "свои в меньшинстве: ~a из ~a" своих всего)))
      (t (values :доверять своих всего доля
                 (format nil "своих ~a из ~a" своих всего))))))

(defun theta-guarded (false-beliefs same-scene-flags alpha &key (rho 1/4))
  "Порог ВМЕСТЕ с оценкой того, чего он стоит → (values θ доверие причина).

   🔴 Смысл в том, что эти две величины больше НЕЛЬЗЯ получить порознь: кто зовёт порог,
   получает и приговор его надёжности. Раньше θ можно было взять и не спросить о сцене —
   и именно так гейт оказывался уверен в мире, которого больше нет."
  (multiple-value-bind (доверие своих всего доля причина)
      (calibration-trust same-scene-flags)
    (declare (ignore своих всего доля))
    (values (theta-nonexchangeable false-beliefs (scene-weights same-scene-flags rho) alpha)
            доверие
            причина)))
