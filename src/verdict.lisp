;;;; nolang src — verdict. ВЕРДИКТ КОДОМ ВОЗВРАТА, А НЕ ПРОЗОЙ.
;;;; Этап 1, пункты 1 и 4 (reports/ЧТО_ТАКОЕ_NOLANG_2026-07-30.md, §8). Невис, 30.07.2026.
;;;;
;;;; 🔴 ЗАЧЕМ. До сегодня прогон ВСЕГДА выходил с кодом 0, а вердикт жил в печати. Тот, кто
;;;; хотел узнать ответ языка, грепал вывод: `nolgate.sh:215` брал текст прогона и искал в
;;;; нём строку «✓ совершено ПУШ». Отсюда обход, работавший месяц: свидетель, в чьём
;;;; `says "…"` стоит эта строка, ПОДДЕЛЫВАЛ вердикт — язык говорил «нельзя», а грепающий
;;;; читал «можно». Проза адресована человеку; машине нужен ответ, который нельзя написать
;;;; внутри программы. Код возврата — ровно такой ответ: его производит процесс, а не текст.
;;;;
;;;; 🔴 РОДЫ НЕ СВОДИМЫ К «ДА/НЕТ» — и это то же различение, что несёт весь язык.
;;;; «Программы не должно быть» и «программа законна, но веры не хватило» одинаково значат
;;;; «не делай», и всё же это РАЗНЫЕ ответы: первое чинится переписыванием, второе — новым
;;;; свидетельством. Свести их в один код значило бы смешать роды ровно там, где язык заведён
;;;; их разделять. Поэтому кодов шесть, и каждый отвечает на свой вопрос.
;;;;
;;;; 0 допущено · 1 отклонено · 2 сбой сбора · 3 суда не было · 4 не допущено · 5 с пороком
;;;;
;;;; 🔴 ПРО 3 — «СУДА НЕ БЫЛО». Этот код здесь не выдаётся никогда: его выдаёт разоружённый
;;;; `nolgate.sh`, когда судить отказывается. Он занят СОЗНАТЕЛЬНО и держится пустым, потому
;;;; что отсутствие суда обязано быть отличимо и от «нельзя», и от поломки. Инструмент,
;;;; молчащий кодом «нельзя», выглядит работающим — и на него сошлются.
;;;;
;;;; 🔴 ПРО 2 — ПОЧЕМУ СБОЙ ОБЯЗАН БЫТЬ ЯВНЫМ. `sbcl --script`, упав, сам выходит с кодом 1,
;;;; и это ровно наш код «отклонено»: сломанный инструмент неотличим от строгого. Поэтому
;;;; здесь ловится ВСЁ, и наружу код ставится только явно. Плюс последней строкой печатается
;;;; маркер `⟦NOLANG-VERDICT code=N …⟧` — не для того, чтобы его грепали вместо кода, а чтобы
;;;; вызывающий мог проверить СОГЛАСИЕ кода и маркера: разошлись или маркера нет — значит
;;;; судья не высказался, и это сбой, а не вердикт.

(load (merge-pathnames "prelude.lisp" *load-pathname*))  ; → nolang.lisp: parse + reduce + check

;;; ── роды и коды ──────────────────────────────────────────────────────────────
(defparameter *verdict-kinds*
  '((:допущено     . 0)   ; программа собрана, требуемое действие совершено
    (:отклонено    . 1)   ; проверяющий или разборщик: программы не должно быть
    (:сбой         . 2)   ; инструмент не смог вынести суд (исключение, файл, окружение)
    (:суда-не-было . 3)   ; занят: выдаётся разоружённым гейтом, здесь не выдаётся никогда
    (:не-допущено  . 4)   ; программа законна, но действие не совершено (свёрток, пусто)
    (:с-пороком    . 5))  ; действие совершено, но осиротело / неправомерно / непоправимо
  "Род вердикта → код возврата. Расширяется ТОЛЬКО здесь.")

(defun verdict-code (kind)
  "Код возврата рода. Неизвестный род — сбой (2), а не «допущено»: молчание не есть разрешение."
  (or (cdr (assoc kind *verdict-kinds*)) 2))

(defun verdict-word (kind)
  (case kind
    (:допущено "ДОПУЩЕНО") (:отклонено "ОТКЛОНЕНО") (:сбой "СБОЙ")
    (:суда-не-было "СУДА-НЕ-БЫЛО") (:не-допущено "НЕ-ДОПУЩЕНО") (:с-пороком "С-ПОРОКОМ")
    (t "НЕИЗВЕСТНО")))

;;; ── что считается отклонением ────────────────────────────────────────────────
;;; 🔴 Правило жило в трёх местах списком-исключением (`decide.lisp:63`, `decide.lisp:145`,
;;; `run_example.sh`). Правило, записанное трижды, расходится — и разошлось бы молча, потому
;;; что все три места печатают, а не сравниваются. Здесь оно одно, и остальные зовут его.
(defun rejecting-errors (errs)
  "Ошибки, означающие «программы не должно быть».
   :runtime — честная граница статики (решится прогоном), :gate-fail — ИСХОД программы
   (свернётся, как написано). Ни то, ни другое не есть дефект текста."
  (remove-if (lambda (e) (member (terr-code e) '(:runtime :gate-fail))) errs))

;;; ── свёртка журнала в один род ───────────────────────────────────────────────
(defparameter *ledger-performed* '(:performed :compensating)
  "Записи журнала, означающие СОВЕРШЕНО.")
(defparameter *ledger-flaws* '(:orphaned :irreparable :unauthorized :compensation-folded)
  "Пороки: действие совершено, но основание рухнуло, право отозвано или возмещения не вышло.")
(defparameter *ledger-withheld* '(:folded)
  "Не допущено гейтом — законный исход, а не ошибка.")

(defun ledger-of (ledger kinds)
  (remove-if-not (lambda (e) (member (first e) kinds)) ledger))

(defun same-name-p (a b)
  "Имена действий приходят символами (читатель Лиспа поднимает регистр). Сравниваем текстом."
  (string-equal (string a) (string b)))

(defun program-verdict (errs ledger &key require)
  "→ (values род причина-словами). Единственное место, где исход прогона становится родом.
   REQUIRE — имя действия, которое ОБЯЗАНО быть совершено, чтобы вердикт был «допущено».

   🔴 ЗАЧЕМ REQUIRE. Без него программа, не делающая ничего, даёт «ничему не воспрепятствовало»
   — то есть ноль, то есть «можно». Это обход: пустой текст проходит любой гейт. Спрашивающий
   про необратимое действие обязан НАЗВАТЬ его, и тогда молчание программы становится отказом.

   Порядок родов не произволен: сначала «программы не было» (судить нечего), затем пороки
   (уже случилось плохое — старше недопуска, потому что требует возмещения, а не свидетельства)."
  (let ((rej (rejecting-errors errs)))
    (cond
      (rej
       (values :отклонено
               (format nil "проверяющий отверг программу: ~{~a~^, ~}"
                       (remove-duplicates (mapcar (lambda (e) (string-downcase (string (terr-code e)))) rej)
                                          :test #'string=))))
      (t
       (let ((пороки (ledger-of ledger *ledger-flaws*))
             (свёртки (ledger-of ledger *ledger-withheld*))
             (совершено (ledger-of ledger *ledger-performed*)))
         (cond
           (пороки
            (values :с-пороком
                    (format nil "совершено, но с пороком: ~{~a~^, ~}"
                            (mapcar (lambda (e) (format nil "~a ~a" (string-downcase (string (first e))) (second e)))
                                    пороки))))
           ;; названное действие судится отдельно: чужой свёрток не есть отказ нашему
           (require
            (if (find-if (lambda (e) (same-name-p (second e) require)) совершено)
                (values :допущено (format nil "~a совершено" require))
                (values :не-допущено
                        (format nil "~a НЕ совершено~@[ (~a)~]" require
                                (let ((f (find-if (lambda (e) (same-name-p (second e) require)) свёртки)))
                                  (and f "свёрнуто гейтом: веры не хватило до порога"))))))
           (свёртки
            (values :не-допущено
                    (format nil "свёрнуто гейтом: ~{~a~^, ~}" (mapcar #'second свёртки))))
           ((null совершено)
            (values :не-допущено
                    "ни одного решения: в программе нет ни совершённых действий, ни свёртков"))
           (t
            (values :допущено
                    (format nil "совершено: ~{~a~^, ~}" (mapcar #'second совершено))))))))))

;;; ── маркер согласия ──────────────────────────────────────────────────────────
(defun say-verdict-line (kind why &optional (s t))
  "Последняя строка вывода. НЕ судья — судья это код возврата. Служит для проверки, что
   судья вообще высказался: маркера нет → процесс умер до вердикта → вызывающий обязан
   считать это сбоем, а не ответом."
  (format s "~&⟦NOLANG-VERDICT code=~a kind=~a⟧ ~a~%"
          (verdict-code kind) (verdict-word kind) why))

;;; ── единая точка: файл → род ─────────────────────────────────────────────────
(defun slurp (path)
  (with-open-file (s path :external-format :utf-8)
    (let ((d (make-string (file-length s))))
      (subseq d 0 (read-sequence d s)))))

(defun judge-file (path &key require prelude (stream t) (show t))
  "Прогон файла целиком → (values род причина). НИЧЕГО не сигналит наружу: любое исключение
   становится родом :сбой. Это не проглатывание ошибки — сбой ПЕЧАТАЕТСЯ и несёт свой код;
   проглатывание было бы кодом 0.

   🔴 Синтаксическая ошибка — ОТКЛОНЕНИЕ, а не сбой. `serr` сигналит условие, и до сегодня
   оно улетало бэктрейсом на десятки кадров: запрет языка выглядел как поломка инструмента.
   Здесь оно ловится и печатается тем же `say-error`, что и ошибки проверяющего — один вид
   диагностики на оба слоя, как и было задумано в common.lisp."
  (handler-case
      (let ((src (slurp path)))
        (multiple-value-bind (forms errs)
            (if prelude
                (compile-with-prelude (slurp prelude) src)
                (compile-nolang src))
          (when show
            (if prelude
                (format stream "~&── ПРЕЛЮДИЯ: ~a ──~%" prelude)
                ;; 🔴 Отсутствие прелюдии НЕ ошибка, но и не молчание: программа, несущая
                ;; собственную меру, написана одной рукой и в один момент — то есть без
                ;; предрегистрации. Вердикт по ней законен, но слабее, и это обязано быть
                ;; сказано, а не подразумеваться.
                (format stream "~&⚠️  ПРЕЛЮДИИ НЕТ: мера и замер в одном файле — линейка~%~
                                 ~4Tмогла быть выточена после того, как стал виден результат.~%"))
            (format stream "── РАЗБОР: ~a объявлений ──~%" (length forms)))
          (let ((rej (rejecting-errors errs)))
            (when show
              (format stream "── ПРОВЕРКА: ~:[принято~;ОТКЛОНЕНО~] ──~%" rej)
              (when errs (diagnose forms)))
            (multiple-value-bind (store ledger) (run-nolang forms :carrier :морф)
              (when show (show-run store ledger :rejected (and rej t)))
              (program-verdict errs ledger :require require)))))
    (nol-syntax-error (e)
      ;; печатаем условным репортом — он уже идёт через say-error
      (format stream "~&── ПРОВЕРКА: ОТКЛОНЕНО (разбор) ──~%~a~%" e)
      (values :отклонено (format nil "синтаксис, строка ~a" (nol-line e))))
    (error (e)
      (format stream "~&── СБОЙ ИНСТРУМЕНТА ──~%~a~%~
                       Это НЕ вердикт языка: судить не удалось.~%" e)
      (values :сбой (format nil "~a" (type-of e))))))

(defun judge-and-exit (path &key require prelude)
  "Точка входа для скрипта: судит и ВЫХОДИТ кодом рода. Единственное место с sb-ext:exit —
   чтобы не было второго пути наружу, дающего 0 в обход вердикта."
  (multiple-value-bind (kind why) (judge-file path :require require :prelude prelude)
    (say-verdict-line kind why)
    (finish-output)
    (sb-ext:exit :code (verdict-code kind))))
