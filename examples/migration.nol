;; migration.nol — агент решает: применять ли миграцию базы данных?
;; Первая программа НА языке nolang. Читается и исполняется вычислителем.

;; что агент знает (суждение · частота · уверенность · источник)
(know (safe migration)   0.9 0.7 "ci:4412")
(know (tested migration) 0.8 0.6 "suite:green")

;; уверены, что безопасна → применить (необратимо); иначе — наблюдать (обратимо)
(if (check (safe migration)) apply observe)

;; допуск необратимого действия решает уверенность, не желание
(gate :irreversible (safe migration))

;; цепочка: безопасна И протестирована — но уверенность в цепи падает честно
(and (check (safe migration)) (check (tested migration)))
