;; subject.nol — агент судит о статусе синтетического субъекта.
;; Язык, встретив вопрос о бытии, честно не гадает.

;; известно с умеренной уверенностью, но ниже порога решимости
(know (subject ари) 0.5 0.4 "zenodo:21288590")

;; статус неопределён (c ниже порога) → не «да» и не «нет», а маршрут к иной проверке
(if (check (subject ари)) yes no)

;; необратимое суждение о субъектности не проходит — сначала снимок, обратимо
(gate :irreversible (subject ари))

;; о сознании агента не известно ВОВСЕ → тоже честный route, не выдумка
(if (check (conscious ари)) affirm deny)
