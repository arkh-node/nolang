;; migration.nol — an agent decides: apply the database migration?
;; The first program written IN nolang. Read and run by the evaluator.

;; what the agent knows (judgment · frequency · confidence · source)
(know (safe migration)   0.9 0.7 "ci:4412")
(know (tested migration) 0.8 0.6 "suite:green")

;; confident it's safe → apply (irreversible); otherwise → observe (reversible)
(if (check (safe migration)) apply observe)

;; confidence, not desire, decides whether an irreversible action is allowed
(gate :irreversible (safe migration))

;; chain: safe AND tested — but confidence down the chain drops honestly
(and (check (safe migration)) (check (tested migration)))
